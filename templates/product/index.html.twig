{% extends 'base.html.twig' %}

{% block title %}Kolleksiya — Pesca{% endblock %}

{% block body %}
<style>
.mobile-filter-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

.mobile-filter-scroll::-webkit-scrollbar {
    display: none;
}
</style>

<section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {# ─── Integrated Minimal Filter Bar ─── #}
        <div class="mb-8 rounded-2xl md:rounded-3xl border border-beige-200 bg-white/95 backdrop-blur-sm shadow-sm overflow-hidden">
            <div class="px-4 pt-4 pb-3 sm:px-5">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-xs uppercase tracking-[0.2em] text-brand-muted">Kolleksiya filtrlari</p>
                    <a href="{{ path('app_product_index') }}"
                       class="text-xs font-medium px-3 py-1.5 rounded-full border border-beige-300 text-brand-medium hover:bg-beige-100 transition-colors">
                        Hammasini ko'rish
                    </a>
                </div>

                <div class="grid grid-cols-2 gap-2 rounded-2xl bg-beige-100 p-1.5 border border-beige-200">
                    <a href="{{ path('app_product_index', currentCategory ? {gender: 'male', category: currentCategory.slug} : {gender: 'male'}) }}"
                       class="rounded-xl px-4 py-3 transition-all duration-200 border
                              {{ currentGender == 'male' ? 'bg-brand-dark border-brand-dark shadow-sm ring-2 ring-brand-dark/20' : 'bg-white/70 border-transparent hover:bg-white' }}">
                        <div class="text-base font-semibold flex items-center gap-1.5 {{ currentGender == 'male' ? 'text-white' : 'text-brand-dark' }}">Erkak <span>♂</span></div>
                        <div class="text-xs mt-0.5 {{ currentGender == 'male' ? 'text-white/80' : 'text-brand-medium' }}">Klassik va qat'iy siluetlar</div>
                    </a>

                    <a href="{{ path('app_product_index', currentCategory ? {gender: 'female', category: currentCategory.slug} : {gender: 'female'}) }}"
                       class="rounded-xl px-4 py-3 transition-all duration-200 border
                              {{ currentGender == 'female' ? 'bg-brand-dark border-brand-dark shadow-sm ring-2 ring-brand-dark/20' : 'bg-white/70 border-transparent hover:bg-white' }}">
                        <div class="text-base font-semibold flex items-center gap-1.5 {{ currentGender == 'female' ? 'text-white' : 'text-brand-dark' }}">Ayol <span>♀</span></div>
                        <div class="text-xs mt-0.5 {{ currentGender == 'female' ? 'text-white/80' : 'text-brand-medium' }}">Yumshoq va nafis chiziqlar</div>
                    </a>
                </div>
            </div>

            <div class="border-t border-beige-200 bg-beige-50 px-4 py-3 sm:px-5">
                <div class="flex items-center gap-2 overflow-x-auto mobile-filter-scroll whitespace-nowrap -mx-1 px-1 pb-0.5">
                    <span class="text-xs font-medium text-brand-muted mr-1 flex-none">Kategoriyalar:</span>
                    <a href="{{ path('app_product_index', currentGender ? {gender: currentGender} : {}) }}"
                       class="px-3.5 py-2 rounded-full text-xs font-medium transition-all duration-200 flex-none
                              {{ currentCategory is null ? 'bg-brand-dark text-white shadow-sm' : 'bg-white text-brand-medium border border-beige-300 hover:bg-beige-100' }}">
                        Barchasi
                    </a>
                    {% for cat in categories %}
                        <a href="{{ path('app_product_index', currentGender ? {category: cat.slug, gender: currentGender} : {category: cat.slug}) }}"
                           class="px-3.5 py-2 rounded-full text-xs font-medium transition-all duration-200 flex-none
                                  {{ currentCategory and currentCategory.id == cat.id ? 'bg-brand-dark text-white shadow-sm' : 'bg-white text-brand-medium border border-beige-300 hover:bg-beige-100' }}">
                            {% if cat.icon %}{{ cat.icon }} {% endif %}{{ cat.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# ─── Products Grid ─── #}
        {% if products|length > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% for product in products %}
            <a href="{{ path('app_product_show', {id: product.id}) }}"
               class="card group">
                <div class="aspect-[3/4] bg-beige-100 relative overflow-hidden">
                    {% if product.imageSrc %}
                        <img src="{{ product.imageSrc }}" alt="{{ product.name }}"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             loading="lazy">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-16 h-16 text-beige-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                <div class="p-5">
                    <h3 class="font-semibold text-brand-dark mb-1 group-hover:text-peach-600 transition-colors">{{ product.name }}</h3>
                    <p class="text-peach-600 font-display font-bold text-lg">{{ product.price|number_format(0, '.', ' ') }} so'm</p>
                    <p class="text-xs text-brand-muted mt-2 flex items-center gap-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Barcha o'lchamlarga mos
                    </p>
                </div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="text-center py-20">
            <svg class="w-16 h-16 mx-auto text-beige-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
            </svg>
            <h3 class="text-lg font-display font-semibold text-brand-dark mb-2">Mahsulotlar topilmadi</h3>
            <p class="text-brand-medium">Boshqa kategoriyani tanlang.</p>
        </div>
        {% endif %}
    </div>
</section>

{% endblock %}
