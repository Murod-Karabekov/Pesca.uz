{% extends 'base.html.twig' %}

{% block title %}Kolleksiya — Pesca{% endblock %}

{% block body %}
<section class="min-h-[70vh] bg-app-canvas border-b border-app-hairline pb-10 sm:pb-14">
    <div class="w-full max-w-6xl mx-auto px-4 sm:px-5 md:px-6 pt-4 sm:pt-6 min-w-0">

        {# Sarlavha #}
        <header class="mb-5 sm:mb-6">
            <h1 class="text-2xl sm:text-3xl font-display font-medium text-app-ink tracking-tight">Kolleksiya</h1>
            <p class="text-sm text-app-inkMuted mt-1">Jins va kategoriya bo‘yicha tanlang</p>
        </header>

        {# Jins — segment (mobil uchun katta zona) #}
        <div class="mb-5">
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-app-accent mb-2">Jins</p>
            <div class="grid grid-cols-2 gap-2 p-1 rounded-[16px] bg-white border border-app-hairline shadow-sm">
                <a href="{{ path('app_product_index', currentCategory ? {gender: 'male', category: currentCategory.slug} : {gender: 'male'}) }}"
                   class="relative flex flex-col items-center justify-center min-h-[52px] sm:min-h-[56px] rounded-[12px] text-sm font-semibold transition-all duration-200
                          {{ currentGender == 'male'
                             ? 'bg-app-ink text-app-canvas shadow-sm'
                             : 'text-app-inkMuted hover:text-app-ink hover:bg-app-canvas' }}">
                    <span class="flex items-center gap-1.5">
                        <span>Erkak</span><span class="text-base opacity-90" aria-hidden="true">♂</span>
                    </span>
                    <span class="text-[10px] font-normal mt-0.5 opacity-80 leading-tight text-center px-1 line-clamp-2 {{ currentGender == 'male' ? 'text-app-canvas/85' : 'text-app-inkMuted' }}">Klassik siluet</span>
                </a>
                <a href="{{ path('app_product_index', currentCategory ? {gender: 'female', category: currentCategory.slug} : {gender: 'female'}) }}"
                   class="relative flex flex-col items-center justify-center min-h-[52px] sm:min-h-[56px] rounded-[12px] text-sm font-semibold transition-all duration-200
                          {{ currentGender == 'female'
                             ? 'bg-app-ink text-app-canvas shadow-sm'
                             : 'text-app-inkMuted hover:text-app-ink hover:bg-app-canvas' }}">
                    <span class="flex items-center gap-1.5">
                        <span>Ayol</span><span class="text-base opacity-90" aria-hidden="true">♀</span>
                    </span>
                    <span class="text-[10px] font-normal mt-0.5 opacity-80 leading-tight text-center px-1 line-clamp-2 {{ currentGender == 'female' ? 'text-app-canvas/85' : 'text-app-inkMuted' }}">Nafis chiziqlar</span>
                </a>
            </div>
        </div>

        {# Kategoriyalar — gorizontal scroll + snap #}
        <div class="mb-6 sm:mb-8">
            <div class="flex items-center justify-between gap-2 mb-2">
                <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-app-accent shrink-0">Kategoriya</p>
                <a href="{{ path('app_product_index') }}"
                   class="text-xs font-semibold text-app-accent hover:text-app-ink transition-colors shrink-0 min-h-[40px] inline-flex items-center">
                    Tozalash
                </a>
            </div>
            <div class="collection-pills-scroll flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 snap-x snap-mandatory scroll-smooth touch-pan-x">
                    <a href="{{ path('app_product_index', currentGender ? {gender: currentGender} : {}) }}"
                       class="snap-start shrink-0 min-h-[44px] inline-flex items-center px-4 rounded-[14px] text-xs font-semibold border transition-colors
                              {{ currentCategory is null
                                 ? 'bg-app-ink text-app-canvas border-app-ink'
                                 : 'bg-white text-app-inkMuted border-app-hairline hover:border-app-ink/25' }}">
                        Barchasi
                    </a>
                    {% for cat in categories %}
                        <a href="{{ path('app_product_index', currentGender ? {category: cat.slug, gender: currentGender} : {category: cat.slug}) }}"
                           class="snap-start shrink-0 min-h-[44px] inline-flex items-center max-w-[85vw] sm:max-w-xs px-4 rounded-[14px] text-xs font-semibold border transition-colors
                                  {{ currentCategory and currentCategory.id == cat.id
                                     ? 'bg-app-ink text-app-canvas border-app-ink'
                                     : 'bg-white text-app-ink border-app-hairline hover:border-app-ink/25' }}">
                            <span class="truncate">{% if cat.icon %}<span class="mr-1">{{ cat.icon }}</span>{% endif %}{{ cat.name }}</span>
                        </a>
                    {% endfor %}
            </div>
        </div>

        {# Mahsulotlar — mobil 2 ustun, katta bosish zonasi #}
        {% if products|length > 0 %}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-5">
            {% for product in products %}
            <a href="{{ path('app_product_show', {id: product.id}) }}"
               class="group flex flex-col min-w-0 rounded-[18px] bg-white border border-app-hairline overflow-hidden shadow-sm active:scale-[0.98] transition-transform duration-150 hover:shadow-md hover:border-app-ink/15">
                <div class="aspect-[3/4] bg-app-canvas relative overflow-hidden">
                    {% if product.imageSrc %}
                        <img src="{{ product.imageSrc }}" alt="{{ product.name|e('html_attr') }}"
                             class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-out"
                             loading="lazy">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center text-app-hairline">
                            <svg class="w-12 h-12 sm:w-14 sm:h-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                <div class="p-3 sm:p-4 flex flex-col flex-1 min-h-[5.5rem] sm:min-h-[6rem]">
                    <h2 class="text-[13px] sm:text-sm font-semibold text-app-ink leading-snug line-clamp-2 break-words group-hover:text-app-accent transition-colors flex-1">
                        {{ product.name }}
                    </h2>
                    <p class="text-sm sm:text-base font-display font-semibold text-app-ink tabular-nums mt-2 pt-1 border-t border-app-hairline">
                        {{ product.price|number_format(0, '.', ' ') }} <span class="text-[11px] font-sans font-medium text-app-inkMuted">so'm</span>
                    </p>
                    {% if product.size|length > 0 %}
                        <p class="text-[10px] sm:text-[11px] text-app-inkMuted mt-1.5 line-clamp-1 break-all">{{ product.size|join(', ') }}</p>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="card p-10 sm:p-14 text-center max-w-md mx-auto">
            <div class="text-4xl mb-3" aria-hidden="true">🛍️</div>
            <h2 class="text-lg font-display font-semibold text-app-ink mb-2">Hech narsa topilmadi</h2>
            <p class="text-sm text-app-inkMuted mb-6">Boshqa kategoriya yoki filtrlarni sinab ko‘ring.</p>
            <a href="{{ path('app_product_index') }}" class="btn-primary inline-flex justify-center min-h-[48px] px-6 text-sm w-full sm:w-auto">
                Filtrlarni tozalash
            </a>
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}
