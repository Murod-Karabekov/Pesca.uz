{% extends 'base.html.twig' %}

{% block title %}Top-up tarixi — Moliya{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <a href="{{ path('app_finance_topup') }}" class="text-sm text-app-inkMuted hover:text-app-ink inline-flex items-center min-h-[44px]">← To'ldirish</a>
            <a href="{{ path('app_finance_index') }}" class="inline-flex items-center justify-center min-h-[44px] px-3 rounded-[12px] border border-app-hairline bg-white text-app-ink text-sm font-medium hover:bg-app-canvas transition-colors self-start sm:self-center">
                Moliya
            </a>
        </div>

        <h1 class="text-xl sm:text-2xl font-display font-medium text-app-ink tracking-tight mb-1">To'ldirish tarixi</h1>
        <p class="text-sm text-app-inkMuted mb-5">Yuborgan so'rovlar holati</p>

        {% if requests|length > 0 %}
            <div class="space-y-2.5">
                {% for item in requests %}
                    <div class="card p-4">
                        <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                            <div class="text-base font-display font-semibold text-app-ink">
                                {{ item.amount|number_format(0, '.', ' ') }} <span class="text-xs font-sans font-normal text-app-inkMuted">so'm</span>
                            </div>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-[11px] font-semibold
                                {% if item.status == 'pending' %} bg-amber-50 text-amber-900 border border-amber-200
                                {% elseif item.status == 'approved' %} bg-green-50 text-green-800 border border-green-200
                                {% else %} bg-red-50 text-red-800 border border-red-200 {% endif %}">
                                {{ item.statusLabel }}
                            </span>
                        </div>
                        <div class="text-xs text-app-inkMuted space-y-1">
                            <div><span class="text-app-accent font-semibold uppercase tracking-wider text-[10px]">Tur</span> · {{ item.methodLabel }}</div>
                            <div><span class="text-app-accent font-semibold uppercase tracking-wider text-[10px]">Yuborilgan</span> · {{ item.createdAt|date('d.m.Y H:i') }}</div>
                            <div><span class="text-app-accent font-semibold uppercase tracking-wider text-[10px]">Qaror</span> · {{ item.processedAt ? item.processedAt|date('d.m.Y H:i') : '—' }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="card p-8 text-center">
                <p class="text-sm text-app-inkMuted">Hali so'rovlar yo'q.</p>
                <a href="{{ path('app_finance_topup') }}" class="btn-primary inline-flex justify-center min-h-[48px] px-6 mt-4 text-sm">To'ldirish</a>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
