{% extends 'base.html.twig' %}

{% block title %}Moliya bo'limi{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between mb-5">
            <div class="min-w-0">
                <a href="{{ path('app_profile_index') }}" class="text-sm text-app-inkMuted hover:text-app-ink inline-flex items-center min-h-[40px]">← Profil</a>
                <h1 class="text-xl sm:text-2xl font-display font-medium text-app-ink tracking-tight mt-1">Moliya</h1>
                <p class="text-sm text-app-inkMuted mt-1 flex flex-wrap items-center gap-2">
                    Tarif:
                    <span class="inline-flex items-center px-2 py-0.5 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-800 rounded-full text-[11px] font-semibold">{{ user.currentPlanLabel }}</span>
                </p>
            </div>
            <a href="{{ path('app_finance_referral') }}" class="btn-secondary shrink-0 justify-center min-h-[48px] px-4 text-sm self-start sm:self-center">🔗 Referral</a>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:gap-3 mb-5">
            <div class="card p-3 sm:p-4 col-span-2 sm:col-span-1">
                <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Bonus balans</div>
                <div class="text-lg sm:text-xl font-display font-semibold text-app-ink leading-tight">{{ stats.balance|number_format(0, '.', ' ') }} <span class="text-xs font-sans font-normal text-app-inkMuted">so'm</span></div>
            </div>
            <div class="card p-3 sm:p-4">
                <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Jami +</div>
                <div class="text-base sm:text-lg font-semibold text-green-700 leading-tight">+{{ stats.totalEarned|number_format(0, '.', ' ') }}</div>
            </div>
            <div class="card p-3 sm:p-4">
                <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Mahsulot</div>
                <div class="text-base sm:text-lg font-semibold text-blue-700 leading-tight">{{ stats.productEarned|number_format(0, '.', ' ') }}</div>
            </div>
            <div class="card p-3 sm:p-4 col-span-2 sm:col-span-1">
                <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Tarifdan</div>
                <div class="text-base sm:text-lg font-semibold text-violet-700 leading-tight">{{ stats.planEarned|number_format(0, '.', ' ') }}</div>
            </div>
        </div>

        <div class="space-y-4 mb-5">
            <div class="card p-4 sm:p-5">
                <h3 class="font-display font-semibold text-base text-app-ink mb-3">👥 Jamoa</h3>
                <div class="text-2xl font-display font-semibold text-app-ink mb-1">{{ stats.totalReferrals }}</div>
                <div class="text-xs text-app-inkMuted mb-3">ta odam</div>

                {% for planSlug, data in stats.referralsByPlan %}
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 text-sm py-2.5 border-t border-app-hairline first:border-t-0 first:pt-0">
                        <span class="text-app-inkMuted text-xs sm:text-sm">
                            {% if planSlug == 'free' %}❄️ Free{% elseif planSlug == 'start' %}🟡 Start{% elseif planSlug == 'premium' %}🔵 Premium{% else %}🟣 VIP{% endif %}
                        </span>
                        <span class="text-app-ink font-medium text-right text-sm">{{ data.count }} ta ({{ data.productPercent }}%/{{ data.planPercent }}%)</span>
                    </div>
                {% endfor %}
            </div>

            <div class="card p-4 sm:p-5">
                <h3 class="font-display font-semibold text-base text-app-ink mb-3">📋 Tranzaksiyalar</h3>
                {% if stats.transactions|length > 0 %}
                    <div class="space-y-0 max-h-72 overflow-y-auto -mx-1">
                        {% for tx in stats.transactions %}
                            <div class="flex items-start justify-between gap-2 text-sm py-2.5 px-1 border-b border-app-hairline last:border-b-0">
                                <div class="min-w-0">
                                    {% if tx.type in ['product_referral', 'plan_referral', 'admin_topup', 'withdrawal_refunded', 'wallet_topup_approved'] %}
                                        <span class="text-green-700 font-semibold">+{{ tx.amount|number_format(0, '.', ' ') }}</span>
                                    {% elseif tx.type in ['spent', 'withdrawn', 'admin_deduct', 'plan_payment'] %}
                                        <span class="text-red-600 font-semibold">-{{ tx.amount|number_format(0, '.', ' ') }}</span>
                                    {% else %}
                                        <span class="text-app-ink font-medium">{{ tx.amount|number_format(0, '.', ' ') }}</span>
                                    {% endif %}
                                    <div class="text-xs text-app-inkMuted mt-0.5">{{ tx.typeLabel }}</div>
                                </div>
                                <div class="text-[11px] text-app-inkMuted shrink-0 pt-0.5">{{ tx.createdAt|date('d.m.y H:i') }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-sm text-app-inkMuted text-center py-6">Hali tranzaksiya yo'q</p>
                {% endif %}
            </div>
        </div>

        <div class="card p-4 sm:p-5 mb-5">
            <div class="flex flex-col gap-2.5">
                <a href="{{ path('app_finance_topup') }}" class="btn-primary w-full justify-center min-h-[48px] text-sm">
                    💳 Hamyonni to'ldirish
                </a>
                {% if user.isVip %}
                    <a href="{{ path('app_finance_withdraw') }}" class="w-full justify-center min-h-[48px] rounded-[14px] border border-app-hairline bg-white text-app-ink font-semibold text-sm hover:bg-app-canvas transition-colors inline-flex items-center">
                        💸 Naqd yechish
                    </a>
                {% endif %}
            </div>

            {% if not user.isVip %}
                <div class="mt-4 pt-4 border-t border-app-hairline text-center">
                    <p class="text-sm text-app-inkMuted mb-2">Naqd yechish faqat <strong class="text-app-ink">VIP</strong></p>
                    <p class="text-xs text-app-inkMuted mb-3">{{ user.currentPlanLabel }}</p>
                    <a href="{{ path('app_hamkorlik_show', {slug: 'vip'}) }}" class="btn-secondary inline-flex justify-center min-h-[44px] px-5 text-sm">
                        VIP ga o'tish
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="card p-4 sm:p-5">
            <h3 class="font-display font-semibold text-base text-app-ink mb-3">🧾 To'ldirish so'rovlari</h3>
            {% if topupRequests|length > 0 %}
                <div class="space-y-0">
                    {% for topup in topupRequests %}
                        <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between py-3 border-b border-app-hairline last:border-b-0 text-sm">
                            <div class="text-app-ink font-medium">
                                {{ topup.amount|number_format(0, '.', ' ') }} so'm
                                <span class="text-app-inkMuted font-normal text-xs"> · {{ topup.methodLabel }}</span>
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-[11px] font-semibold
                                    {% if topup.status == 'pending' %} bg-amber-50 text-amber-900 border border-amber-200
                                    {% elseif topup.status == 'approved' %} bg-green-50 text-green-800 border border-green-200
                                    {% else %} bg-red-50 text-red-800 border border-red-200 {% endif %}">
                                    {{ topup.statusLabel }}
                                </span>
                                <span class="text-[11px] text-app-inkMuted">{{ topup.createdAt|date('d.m H:i') }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-sm text-app-inkMuted">So'rovlar yo'q.</p>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
