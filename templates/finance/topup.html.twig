{% extends 'base.html.twig' %}

{% block title %}Hamyonni to'ldirish — Moliya{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <a href="{{ path('app_finance_index') }}" class="text-sm text-app-inkMuted hover:text-app-ink inline-flex items-center min-h-[44px]">← Moliya</a>
            <a href="{{ path('app_finance_topup_history') }}" class="inline-flex items-center justify-center min-h-[44px] px-3 rounded-[12px] border border-app-hairline bg-white text-app-ink text-sm font-medium hover:bg-app-canvas transition-colors self-start sm:self-center">
                🕘 Tarix
            </a>
        </div>

        <div class="card overflow-hidden">
            <div class="bg-app-ink text-app-canvas px-4 py-4 sm:py-5 text-center">
                <h1 class="text-lg sm:text-xl font-display font-medium">💳 Hamyonni to'ldirish</h1>
                <p class="text-xs sm:text-sm opacity-90 mt-2 leading-relaxed max-w-md mx-auto">So'rov yuborasiz; admin tasdiqlagach balansga tushadi.</p>
                {% if app.user %}
                <p class="text-sm mt-3 pt-3 border-t border-white/20 opacity-95">
                    Joriy virtual hamyon: <strong class="font-display tabular-nums text-base">{{ app.user.generalBalance|number_format(0, '.', ' ') }}</strong> so'm
                </p>
                {% endif %}
            </div>

            <div class="p-4 sm:p-5">
                <form method="post" action="{{ path('app_finance_topup') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('wallet_topup') }}">

                    <div>
                        <label class="block text-sm font-medium text-app-ink mb-1.5">Summa (so'm)</label>
                        <input type="number" name="amount" min="{{ minAmount }}" step="1000"
                               class="input-field min-h-[48px]" required
                               inputmode="numeric"
                               placeholder="Kamida {{ minAmount|number_format(0, '.', ' ') }}">
                        <p class="text-xs text-app-inkMuted mt-1.5">Minimal: {{ minAmount|number_format(0, '.', ' ') }} so'm</p>
                    </div>

                    <button type="submit" class="btn-primary w-full justify-center min-h-[48px] mt-5 text-sm">
                        So'rovni yuborish
                    </button>
                </form>

                <div class="mt-5 rounded-[12px] bg-app-canvas border border-app-hairline p-3 text-xs text-app-inkMuted leading-relaxed">
                    <p class="font-semibold text-app-ink mb-1.5">Eslatma</p>
                    <ul class="space-y-1 list-disc list-inside">
                        <li>Admin profilingizdagi telefon orqali bog'lanadi</li>
                        <li>Tasdiqlangach mablag' umumiy balansga qo'shiladi</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
