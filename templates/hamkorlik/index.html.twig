{% extends 'base.html.twig' %}

{% block title %}Hamkorlik — Tariflar{% endblock %}

{% block body %}
<style>
@keyframes vipGlowPulse {
    0%, 100% {
        box-shadow: 0 20px 45px rgba(245, 158, 11, 0.20);
    }
    50% {
        box-shadow: 0 28px 65px rgba(245, 158, 11, 0.34);
    }
}

.vip-featured {
    animation: vipGlowPulse 2.8s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
    .vip-featured {
        animation: none;
    }
}
</style>

<div class="bg-beige-50 pt-8 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {% if app.user and currentPlan != 'free' %}
            <div class="inline-flex items-center gap-2 bg-white rounded-full px-6 py-2 shadow-sm">
                <span class="text-sm text-brand-medium">Sizning tarifingiz:</span>
                <span class="font-bold text-peach-600">{{ app.user.currentPlanLabel }}</span>
            </div>
        {% endif %}
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-4 pb-16">
    <div class="mb-8 rounded-3xl bg-gradient-to-r from-brand-dark via-brand-dark to-peach-700 px-6 py-7 text-white shadow-lg">
        <div class="max-w-4xl mx-auto text-center">
            <p class="text-sm uppercase tracking-[0.24em] text-white/70 mb-3">Pesca 2027</p>
            <h2 class="text-2xl md:text-3xl font-display font-bold mb-3">Tarifni tanlang va Pesca tizimida daromad yo'lingizni boshlang.</h2>
            <p class="text-sm md:text-base text-white/85">START oddiy kirish uchun, PREMIUM barqaror rivojlanish uchun, VIP esa maksimal imkoniyat va status uchun. Qaysi bosqichda bo'lsangiz ham, mos daraja tayyor.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        {% for plan in plans %}
            <div class="flex flex-col rounded-2xl shadow-lg border-2 overflow-hidden transition-all duration-300
                {% if plan.slug == 'vip' %}
                    bg-amber-50 border-amber-400 md:order-2 md:scale-[1.03] vip-featured
                {% elseif plan.slug == 'start' %}
                    bg-white border-green-300 md:order-1 md:scale-[0.97]
                {% else %}
                    bg-white border-blue-300 md:order-3 md:scale-[0.97]
                {% endif %}
                hover:shadow-xl
                {% if currentPlan == plan.slug %} ring-4 ring-peach-300 {% endif %}">

                {# Header #}
                <div class="p-6 text-center
                    {% if plan.slug == 'vip' %} bg-amber-100
                    {% elseif plan.slug == 'premium' %} bg-blue-50
                    {% else %} bg-green-50 {% endif %}">

                    {% if plan.slug == 'vip' %}
                        <div class="inline-flex items-center gap-2 mb-3 rounded-full bg-amber-500 px-3 py-1 text-xs font-bold text-white uppercase tracking-wide shadow-md">
                            Eng Tavsiya Etiladi
                        </div>
                    {% endif %}

                    <div class="text-3xl mb-2">
                        {% if plan.slug == 'vip' %}&#x1F451;{% elseif plan.slug == 'premium' %}&#x1F48E;{% else %}&#x1F7E2;{% endif %}
                    </div>
                    <h3 class="text-2xl font-display font-bold
                        {% if plan.slug == 'vip' %} text-amber-700
                        {% elseif plan.slug == 'premium' %} text-blue-700
                        {% else %} text-green-700 {% endif %}">{{ plan.name }}</h3>
                    <div class="mt-3">
                        <span class="text-3xl font-bold text-brand-dark">{{ plan.price|number_format(0, '.', ' ') }}</span>
                        <span class="text-sm text-brand-medium"> so'm</span>
                    </div>
                </div>

                {# Imkoniyatlar #}
                <div class="p-6 space-y-3 flex-1">
                    {% if plan.slug == 'start' %}
                        <p class="text-sm text-brand-medium">👉 Pesca orqali pul qilishni past boshlang'ich byudjet bilan boshlamoqchilar uchun</p>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>👕 1 ta universal forma</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🔓 Pesca yopiq tizimiga to'liq kirish</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🎓 Yopiq bilimlar: savdo va kiyim trendlari bo'yicha doimiy darslar</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>💰 Shaxsiy balans: pul kiritish va ishlatish imkoniyati</span>
                        </div>
                    {% elseif plan.slug == 'premium' %}
                        <p class="text-sm text-brand-medium">👉 Barqaror daromad qilishni xohlaganlar uchun</p>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>👕 1 ta yangi kolleksiya formasi</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>✂️ Qomatga moslashtirilgan dizayn (sizga maxsus)</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🎓 Yopiq masterklasslar: sotuv va rivojlanish strategiyalari</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🔓 Faol a'zolar uchun yopiq community</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>💰 To'liq moliyaviy boshqaruv</span>
                        </div>
                    {% else %}
                        <p class="text-sm text-brand-medium">👉 Jamoa qurib, katta natija va statusga chiqmoqchilar uchun</p>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>👑 VIP status — tizimda yuqori daraja</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>👕 1 ta eksklyuziv forma (faqat VIP uchun)</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>✂️ Individual dizayn va premium xizmat</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🚀 Eng tez bajarilish va ustuvor xizmat</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>🎁 Yopiq bonuslar va maxsus sovg'alar</span>
                        </div>
                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-green-500">✅</span>
                            <span>✈️ Eng faol ishtirokchilar uchun sayohat imkoniyatlari</span>
                        </div>
                    {% endif %}

                    <hr class="my-4">

                    <div class="text-sm font-semibold text-brand-dark mb-2">💸 Qanday pul ishlaysiz:</div>
                    <div class="flex items-center gap-2 text-sm">
                        <span class="text-green-500">✅</span>
                        <span>Siz taklif qilgan odam tarif olganda: <strong>{{ plan.planReferralPercent }}%</strong></span>
                    </div>
                    <div class="flex items-center gap-2 text-sm">
                        <span class="text-green-500">✅</span>
                        <span>Sizning tarmog'ingiz mahsulot olganda: <strong>{{ plan.productReferralPercent }}%</strong></span>
                    </div>

                    {% if plan.canWithdraw %}
                        <div class="flex items-center gap-2 text-sm text-green-600 font-medium">
                            <span class="text-green-500">✅</span>
                            <span>Bonusni naqdga aylantirish imkoni bor</span>
                        </div>
                    {% endif %}

                    <p class="text-xs text-brand-medium pt-1">Daromad natijasi shaxsiy faollik, jamoa va savdo ko'rsatkichlariga bog'liq.</p>
                </div>

                {# Tugma #}
                <div class="p-6 pt-0">
                    {% if currentPlan == plan.slug %}
                        <div class="w-full py-3.5 bg-green-50 text-green-700 text-center rounded-xl font-medium text-sm border border-green-200">
                            ✅ Joriy tarifingiz
                        </div>
                    {% elseif app.user and not app.user.canAccessProductLevel(plan.slug) == false %}
                        <a href="{{ path('app_hamkorlik_show', {slug: plan.slug}) }}"
                           class="block w-full py-3.5 text-center rounded-xl font-bold text-sm transition-all shadow-md hover:shadow-lg
                                  {% if plan.slug == 'vip' %} bg-gradient-to-r from-amber-500 to-amber-600 text-white hover:from-amber-600 hover:to-amber-700
                                  {% elseif plan.slug == 'premium' %} bg-gradient-to-r from-blue-500 to-blue-600 text-white hover:from-blue-600 hover:to-blue-700
                                  {% else %} bg-gradient-to-r from-green-500 to-green-600 text-white hover:from-green-600 hover:to-green-700 {% endif %}">
                            Tarifni ko'rish →
                        </a>
                    {% else %}
                        <a href="{{ path('app_hamkorlik_show', {slug: plan.slug}) }}"
                           class="block w-full py-3.5 text-center rounded-xl font-bold text-sm transition-all shadow-md hover:shadow-lg
                                  {% if plan.slug == 'vip' %} bg-gradient-to-r from-amber-500 to-amber-600 text-white hover:from-amber-600 hover:to-amber-700
                                  {% elseif plan.slug == 'premium' %} bg-gradient-to-r from-blue-500 to-blue-600 text-white hover:from-blue-600 hover:to-blue-700
                                  {% else %} bg-gradient-to-r from-green-500 to-green-600 text-white hover:from-green-600 hover:to-green-700 {% endif %}">
                            Hozir qo'shilish →
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="mt-10 rounded-3xl bg-white px-6 py-8 shadow-md border border-beige-200">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl font-display font-bold text-brand-dark mb-4">Muhim eslatma</h2>
            <p class="text-lg text-brand-medium">⚠️ Birinchi bosqich uchun joylar cheklangan. Keyingi bosqichda narxlar yangilanishi mumkin.</p>
        </div>
    </div>

    {# Qo'shimcha ma'lumot — FAQ Accordion #}
    <div class="mt-12 bg-white rounded-2xl shadow-md p-8">
        <h2 class="text-2xl font-display font-bold text-brand-dark mb-6 text-center">Ko'p beriladigan savollar</h2>
        <div class="max-w-3xl mx-auto divide-y divide-beige-200" id="faq-accordion">
            <div class="faq-item">
                <button type="button" class="faq-toggle w-full flex items-center justify-between py-4 text-left group">
                    <span class="font-semibold text-brand-dark group-hover:text-peach-600 transition-colors">Tarif muddati bormi?</span>
                    <svg class="faq-icon w-5 h-5 text-brand-medium transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="faq-answer hidden pb-4 text-sm text-brand-medium">
                    Yo'q! Barcha tariflar cheksiz muddatga amal qiladi. Bir marta obuna bo'lsangiz, doimiy foydalanasiz.
                </div>
            </div>
            <div class="faq-item">
                <button type="button" class="faq-toggle w-full flex items-center justify-between py-4 text-left group">
                    <span class="font-semibold text-brand-dark group-hover:text-peach-600 transition-colors">Bonus bilan tovar olsa bo'ladimi?</span>
                    <svg class="faq-icon w-5 h-5 text-brand-medium transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="faq-answer hidden pb-4 text-sm text-brand-medium">
                    Ha! Barcha foydalanuvchilar bonuslarini tovar olishda ishlatishi mumkin.
                </div>
            </div>
            <div class="faq-item">
                <button type="button" class="faq-toggle w-full flex items-center justify-between py-4 text-left group">
                    <span class="font-semibold text-brand-dark group-hover:text-peach-600 transition-colors">Naqd pul yechish mumkinmi?</span>
                    <svg class="faq-icon w-5 h-5 text-brand-medium transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="faq-answer hidden pb-4 text-sm text-brand-medium">
                    Faqat VIP a'zolar bonuslarini naqd yechishi mumkin (minimal summa: 5,000,000 so'm).
                </div>
            </div>
            <div class="faq-item">
                <button type="button" class="faq-toggle w-full flex items-center justify-between py-4 text-left group">
                    <span class="font-semibold text-brand-dark group-hover:text-peach-600 transition-colors">Referral qanday ishlaydi?</span>
                    <svg class="faq-icon w-5 h-5 text-brand-medium transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="faq-answer hidden pb-4 text-sm text-brand-medium">
                    Sizning havolangiz orqali kelgan har bir mijozning xarididan va tarif to'lovidan foiz olasiz. Foiz miqdori sizning tarifingizga bog'liq.
                </div>
            </div>
            <div class="faq-item">
                <button type="button" class="faq-toggle w-full flex items-center justify-between py-4 text-left group">
                    <span class="font-semibold text-brand-dark group-hover:text-peach-600 transition-colors">Daromad qanday hisoblanadi?</span>
                    <svg class="faq-icon w-5 h-5 text-brand-medium transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div class="faq-answer hidden pb-4 text-sm text-brand-medium">
                    Siz qo'shgan har bir odam mahsulot xarid qilganda yoki tarifga obuna bo'lganda, sizga foiz hisoblanadi. Foiz miqdori siz uni qo'shgan paytdagi tarifingizga qarab belgilanadi.
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/hamkorlik-faq.js') }}"></script>
{% endblock %}
