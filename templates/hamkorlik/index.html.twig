{% extends 'base.html.twig' %}
{% import 'hamkorlik/_helpers.html.twig' as ham_helpers %}

{% block title %}Hamkorlik — Tariflar{% endblock %}

{% block body %}
<style>
@keyframes vipGlowPulse {
    0%, 100% { box-shadow: 0 12px 32px rgba(245, 158, 11, 0.22); }
    50% { box-shadow: 0 20px 48px rgba(245, 158, 11, 0.34); }
}
.vip-featured { animation: vipGlowPulse 2.8s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) {
    .vip-featured { animation: none; }
}
@keyframes corporateGlowPulse {
    0%, 100% { box-shadow: 0 10px 28px rgba(71, 85, 105, 0.14); }
    50% { box-shadow: 0 16px 40px rgba(51, 65, 85, 0.22); }
}
.corporate-featured { animation: corporateGlowPulse 3s ease-in-out infinite; }
@media (prefers-reduced-motion: reduce) {
    .corporate-featured { animation: none; }
}
</style>

<section class="bg-app-canvas border-b border-app-hairline pb-12 sm:pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-5 md:px-6 pt-6 sm:pt-8 min-w-0">

        {# ─── 1. Oddiy foydalanuvchilar: asosiy bo‘lim ─── #}
        <header class="mb-5 sm:mb-6 text-center sm:text-left">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-app-accent mb-1.5">Jismoniy shaxslar</p>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-semibold text-app-ink tracking-tight leading-tight">Hamkorlik tariflari</h1>
            <p class="mt-2 text-sm text-app-inkMuted max-w-xl mx-auto sm:mx-0 leading-relaxed">Daromad foizlari va tarif narxlari. Pastdan START, PREMIUM yoki VIPni tanlang.</p>
        </header>

        {% if app.user %}
        <div class="rounded-[18px] border border-app-hairline bg-white shadow-sm px-4 py-4 sm:px-6 sm:py-5 mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="min-w-0 text-center sm:text-left">
                {% if currentPlan != 'free' %}
                <p class="text-xs text-app-inkMuted mb-2">Joriy tarif: <span class="font-semibold text-app-ink">{{ app.user.currentPlanLabel }}</span></p>
                {% endif %}
                <p class="text-[10px] font-semibold uppercase tracking-wider text-app-accent">Virtual hamyon</p>
                <p class="text-2xl sm:text-3xl font-display font-bold text-app-ink tabular-nums mt-0.5">{{ app.user.generalBalance|number_format(0, '.', ' ') }} <span class="text-base font-sans font-medium text-app-inkMuted">so'm</span></p>
                <p class="text-xs text-app-inkMuted mt-1">Tarif to‘lovi va xaridlar uchun</p>
            </div>
            <a href="{{ path('app_finance_topup') }}" class="btn-primary justify-center min-h-[48px] text-sm no-underline px-6 w-full sm:w-auto shrink-0">Hamyonni to‘ldirish</a>
        </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 md:gap-5 items-stretch md:px-1 md:py-2">
            {% for plan in plans %}
                {% set isVip = plan.slug == 'vip' %}
                {% set isStart = plan.slug == 'start' %}
                <article class="relative flex flex-col min-w-0 rounded-[20px] border bg-white overflow-hidden shadow-sm transition-all duration-300 hover:shadow-md z-0
                    {% if isVip %} border-amber-300/90 md:order-2 md:scale-[1.045] md:z-20 md:-my-1 vip-featured
                    {% elseif plan.slug == 'premium' %} border-app-hairline md:order-3 md:scale-[0.97]
                    {% else %} border-app-hairline md:order-1 md:scale-[0.97] {% endif %}
                    {% if currentPlan == plan.slug %} ring-2 ring-app-ink ring-offset-2 ring-offset-app-canvas {% endif %}">

                    <a href="{{ path('app_hamkorlik_show', {slug: plan.slug}) }}" class="flex flex-col flex-1 text-left min-h-0 group focus:outline-none focus-visible:ring-2 focus-visible:ring-app-ink focus-visible:ring-inset">
                        <div class="px-5 pt-6 pb-4 text-center border-b border-app-hairline
                            {% if isVip %} bg-gradient-to-b from-amber-50 to-white
                            {% elseif plan.slug == 'premium' %} bg-gradient-to-b from-blue-50/80 to-white
                            {% else %} bg-gradient-to-b from-emerald-50/80 to-white {% endif %}">

                            {% if isVip %}
                                <span class="inline-flex mb-3 rounded-full bg-amber-500 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Tavsiya</span>
                            {% endif %}

                            <div class="text-3xl sm:text-4xl mb-1" aria-hidden="true">
                                {% if isVip %}👑{% elseif plan.slug == 'premium' %}💎{% else %}🌿{% endif %}
                            </div>
                            <h2 class="text-xl sm:text-2xl font-display font-semibold text-app-ink group-hover:text-app-accent transition-colors">{{ plan.name }}</h2>
                            <div class="mt-3">
                                <span class="text-2xl sm:text-3xl font-display font-bold text-app-ink tabular-nums tracking-tight">{{ plan.price|number_format(0, '.', ' ') }}</span>
                                <span class="text-sm text-app-inkMuted ml-1">so'm</span>
                            </div>
                        </div>

                        <div class="px-5 py-4 flex-1 flex flex-col">
                            {% if isStart %}
                                <p class="text-sm text-app-inkMuted leading-snug line-clamp-2">Kirish + forma + yopiq bilimlar. Past boshlang‘ich uchun.</p>
                            {% elseif plan.slug == 'premium' %}
                                <p class="text-sm text-app-inkMuted leading-snug line-clamp-2">Mos dizayn va masterklasslar. Barqaror rivojlanish.</p>
                            {% else %}
                                <p class="text-sm text-app-inkMuted leading-snug line-clamp-3">Cheksiz SmartStyle, mentorlik statusi, VIP bonuslar, sovrin/challenge’lar, maksimal kirish. Faol mentorlar uchun sayohatlar.</p>
                            {% endif %}

                            <div class="mt-4 grid grid-cols-2 gap-2">
                                <div class="rounded-[14px] bg-app-canvas border border-app-hairline px-2 py-2.5 text-center">
                                    <p class="text-[9px] font-semibold uppercase tracking-wider text-app-accent leading-tight">Tarifdan</p>
                                    <p class="text-lg font-display font-bold text-app-ink tabular-nums">{{ (plan.planReferralPercent + 0)|round }}%</p>
                                </div>
                                <div class="rounded-[14px] bg-app-canvas border border-app-hairline px-2 py-2.5 text-center">
                                    <p class="text-[9px] font-semibold uppercase tracking-wider text-app-accent leading-tight">Mahsulotdan</p>
                                    <p class="text-lg font-display font-bold text-app-ink tabular-nums">{{ ham_helpers.product_referral_pct(plan) }}%</p>
                                </div>
                            </div>

                            {% if plan.canWithdraw %}
                                <p class="mt-3 text-center text-xs font-medium text-emerald-700">Naqd yechish imkoniyati</p>
                            {% elseif not isVip %}
                                <p class="mt-3 text-center text-[11px] text-app-inkMuted">Naqd yechish — VIP tarifda</p>
                            {% endif %}

                            <div class="mt-auto pt-5 flex items-center justify-center gap-1 text-sm font-semibold text-app-accent group-hover:text-app-ink">
                                <span>Batafsil</span>
                                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                            </div>
                        </div>
                    </a>

                    <div class="px-5 pb-5 pt-0">
                        {% if currentPlan == plan.slug %}
                            <div class="w-full py-3 rounded-[14px] bg-emerald-50 text-emerald-800 text-center text-sm font-semibold border border-emerald-200">
                                Joriy tarifingiz
                            </div>
                        {% elseif app.user and not app.user.canAccessProductLevel(plan.slug) == false %}
                            <a href="{{ path('app_hamkorlik_show', {slug: plan.slug}) }}"
                               class="btn-primary w-full justify-center min-h-[48px] text-sm no-underline">
                                Davom etish
                            </a>
                        {% else %}
                            <a href="{{ path('app_hamkorlik_show', {slug: plan.slug}) }}"
                               class="btn-primary w-full justify-center min-h-[48px] text-sm no-underline">
                                Qo‘shilish
                            </a>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>

        {# Korporativ — tariflar panjarasidan pastda #}
        <article class="relative flex flex-col min-w-0 max-w-5xl mx-auto rounded-[20px] border border-slate-300/80 bg-white overflow-hidden shadow-sm transition-shadow hover:shadow-md mt-6 sm:mt-8 corporate-featured">
            <div class="px-5 pt-6 pb-4 text-center border-b border-app-hairline bg-gradient-to-b from-slate-100/95 via-slate-50/80 to-white">
                <span class="inline-flex mb-3 rounded-full bg-slate-700 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Tashkilot</span>
                <div class="text-3xl sm:text-4xl mb-1" aria-hidden="true">🏢</div>
                <h2 class="text-xl sm:text-2xl font-display font-semibold text-app-ink tracking-tight">Korporativ hamkorlik</h2>
                <p class="mt-2 text-sm text-app-inkMuted leading-snug max-w-lg mx-auto">Integratsiya, TOP listing, reklama va boshqalar — alohida kelishiladi.</p>
            </div>
            <div class="px-4 sm:px-5 py-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-2 text-xs sm:text-[13px] text-app-ink leading-snug">
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">🤖</span><span>AI personal tavsiya integratsiyasi</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">✨</span><span>SmartStyle’da TOP listing</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">🛒</span><span>Marketplace’da yuqori chiqish</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">📣</span><span>Reklama imkoniyati</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">📊</span><span>To‘liq statistika</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">🖥️</span><span>SmartStyle AI Kiosk</span></div>
                    <div class="flex gap-2 items-start min-h-[2.75rem]"><span class="text-base shrink-0 leading-none pt-0.5" aria-hidden="true">📦</span><span>Mahsulot joylash</span></div>
                </div>
            </div>
            <div class="px-5 pb-5 pt-1">
                <a href="{{ path('app_hamkorlik_corporate') }}" class="btn-primary w-full justify-center min-h-[48px] text-sm no-underline inline-flex items-center gap-2 group/btn">
                    <span>So‘rov formasi</span>
                    <span class="transition-transform group-hover/btn:translate-x-0.5" aria-hidden="true">→</span>
                </a>
            </div>
        </article>

        <div class="mt-10 card p-5 sm:p-6 text-center max-w-2xl mx-auto">
            <h2 class="text-lg sm:text-xl font-display font-semibold text-app-ink mb-2">Eslatma</h2>
            <p class="text-sm text-app-inkMuted leading-relaxed">Joylar cheklangan bo‘lishi mumkin; keyingi bosqichda narxlar yangilanishi mumkin.</p>
        </div>

        <div class="mt-10 card p-5 sm:p-8 min-w-0">
            <h2 class="text-lg sm:text-xl font-display font-semibold text-app-ink mb-4 sm:mb-6 text-center">Ko‘p so‘raladigan savollar</h2>
            <div class="max-w-3xl mx-auto divide-y divide-app-hairline" id="faq-accordion">
                <div class="faq-item">
                    <button type="button" class="faq-toggle w-full flex items-start justify-between gap-3 py-4 text-left group min-w-0">
                        <span class="font-semibold text-app-ink group-hover:text-app-accent transition-colors min-w-0 flex-1 break-words pr-2">Tarif muddati bormi?</span>
                        <svg class="faq-icon w-5 h-5 text-app-inkMuted transition-transform duration-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="faq-answer hidden pb-4 text-sm text-app-inkMuted">
                        Yo'q! Barcha tariflar cheksiz muddatga amal qiladi. Bir marta obuna bo'lsangiz, doimiy foydalanasiz.
                    </div>
                </div>
                <div class="faq-item">
                    <button type="button" class="faq-toggle w-full flex items-start justify-between gap-3 py-4 text-left group min-w-0">
                        <span class="font-semibold text-app-ink group-hover:text-app-accent transition-colors min-w-0 flex-1 break-words pr-2">Bonus bilan tovar olsa bo'ladimi?</span>
                        <svg class="faq-icon w-5 h-5 text-app-inkMuted transition-transform duration-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="faq-answer hidden pb-4 text-sm text-app-inkMuted">
                        Ha! Barcha foydalanuvchilar bonuslarini tovar olishda ishlatishi mumkin.
                    </div>
                </div>
                <div class="faq-item">
                    <button type="button" class="faq-toggle w-full flex items-start justify-between gap-3 py-4 text-left group min-w-0">
                        <span class="font-semibold text-app-ink group-hover:text-app-accent transition-colors min-w-0 flex-1 break-words pr-2">Naqd pul yechish mumkinmi?</span>
                        <svg class="faq-icon w-5 h-5 text-app-inkMuted transition-transform duration-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="faq-answer hidden pb-4 text-sm text-app-inkMuted">
                        Faqat VIP a'zolar bonuslarini naqd yechishi mumkin (minimal summa: 5,000,000 so'm).
                    </div>
                </div>
                <div class="faq-item">
                    <button type="button" class="faq-toggle w-full flex items-start justify-between gap-3 py-4 text-left group min-w-0">
                        <span class="font-semibold text-app-ink group-hover:text-app-accent transition-colors min-w-0 flex-1 break-words pr-2">Referral qanday ishlaydi?</span>
                        <svg class="faq-icon w-5 h-5 text-app-inkMuted transition-transform duration-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="faq-answer hidden pb-4 text-sm text-app-inkMuted">
                        Sizning havolangiz orqali kelgan har bir mijozning xarididan va tarif to'lovidan foiz olasiz. Foiz miqdori sizning tarifingizga bog'liq.
                    </div>
                </div>
                <div class="faq-item">
                    <button type="button" class="faq-toggle w-full flex items-start justify-between gap-3 py-4 text-left group min-w-0">
                        <span class="font-semibold text-app-ink group-hover:text-app-accent transition-colors min-w-0 flex-1 break-words pr-2">Daromad qanday hisoblanadi?</span>
                        <svg class="faq-icon w-5 h-5 text-app-inkMuted transition-transform duration-300 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="faq-answer hidden pb-4 text-sm text-app-inkMuted">
                        Siz qo'shgan har bir odam mahsulot xarid qilganda yoki tarifga obuna bo'lganda, sizga foiz hisoblanadi. Foiz miqdori siz uni qo'shgan paytdagi tarifingizga qarab belgilanadi.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="{{ asset('js/hamkorlik-faq.js') }}"></script>
{% endblock %}
