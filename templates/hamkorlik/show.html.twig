{% extends 'base.html.twig' %}
{% import 'hamkorlik/_helpers.html.twig' as ham_helpers %}

{% block title %}{{ plan.name }} — Hamkorlik{% endblock %}

{% block body %}
{% set isStart = plan.slug == 'start' %}
{% set isPremium = plan.slug == 'premium' %}
{% set isVip = plan.slug == 'vip' %}

<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline py-4 sm:py-6">
    <div class="app-sheet max-w-2xl mx-auto min-w-0">

        <a href="{{ path('app_hamkorlik_index') }}" class="inline-flex items-center gap-2 text-sm text-app-inkMuted hover:text-app-ink transition-colors mb-4 min-h-[44px]">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Tariflarga qaytish
        </a>

        {# ─── Hero ─── #}
        <div class="rounded-[20px] overflow-hidden border shadow-sm mb-4
            {% if isVip %} border-amber-300/80 bg-gradient-to-br from-amber-50 via-white to-app-canvas
            {% elseif isPremium %} border-app-hairline bg-gradient-to-br from-blue-50/90 via-white to-app-canvas
            {% else %} border-app-hairline bg-gradient-to-br from-emerald-50/90 via-white to-app-canvas {% endif %}">
            <div class="px-4 py-6 sm:px-6 sm:py-8 text-center">
                <div class="text-4xl sm:text-5xl mb-2" aria-hidden="true">
                    {% if isVip %}👑{% elseif isPremium %}💎{% else %}🚀{% endif %}
                </div>
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-app-accent mb-1">Hamkorlik tarif</p>
                <h1 class="text-2xl sm:text-3xl font-display font-semibold text-app-ink tracking-tight">{{ plan.name }}</h1>
                <div class="mt-4 flex flex-wrap items-baseline justify-center gap-1">
                    <span class="text-3xl sm:text-4xl font-display font-bold text-app-ink tabular-nums tracking-tight">{{ plan.price|number_format(0, '.', ' ') }}</span>
                    <span class="text-sm text-app-inkMuted">so'm</span>
                    <span class="w-full sm:w-auto text-xs font-medium text-app-inkMuted mt-1 sm:mt-0 sm:ml-2">(bir martalik)</span>
                </div>
                <p class="mt-4 text-sm text-app-inkMuted leading-relaxed max-w-md mx-auto">
                    {% if isStart %}
                        Tizimga kirish, SmartStyle va moliya vositalari — kichik byudjet bilan boshlash uchun.
                    {% elseif isPremium %}
                        Barqaror rivojlanish: kengroq imkoniyatlar va kuchliroq daromad ulushi.
                    {% else %}
                        Cheksiz SmartStyle, to‘liq mentorlik statusi, VIP bonuslar va challenge’lar — eng faol mentorlar uchun sayohatlar.
                    {% endif %}
                </p>
            </div>
        </div>

        {# ─── Qisqa sabab ─── #}
        <div class="card p-4 sm:p-5 mb-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-app-accent mb-2">Nega bu tarif?</h2>
            <p class="text-sm text-app-ink leading-relaxed">
                {% if isStart %}
                    Pesca hamkorligiga murakkabsiz kirish: avvalo tizim va vositalarni o‘rganasiz, keyin jamoani kengaytirasiz.
                {% elseif isPremium %}
                    Amaliy bilimlar, ustuvor qo‘llab-quvvatlash va yuqori darajadagi mahsulotlar bilan ishlash.
                {% else %}
                    Jamoada yetakchi bo‘lish, sovrin va challenge turlari hamda tizimning barcha imkoniyatlaridan to‘liq foydalanish uchun yuqori paket.
                {% endif %}
            </p>
        </div>

        {# ─── Beriladi ─── #}
        <h2 class="text-base font-display font-semibold text-app-ink mb-3 px-0.5">Beriladi</h2>
        <div class="card divide-y divide-app-hairline overflow-hidden mb-4 p-0">
            {% if isStart %}
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">✨</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">SmartStyle AI</span> — oyiga <span class="tabular-nums font-semibold">30</span> marta foydalanish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🔓</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">Pesca</span> yopiq tizimiga kirish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">💰</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Shaxsiy balans <span class="text-app-inkMuted">(wallet)</span>: kiritish va xaridlarda ishlatish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-start sm:items-center">
                    <span class="text-xl shrink-0 mt-0.5 sm:mt-0" aria-hidden="true">🎓</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Yopiq masterclasslar <span class="text-app-inkMuted">(savdo, dizayn, tikuv)</span></p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">📊</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Oddiy statistika</p>
                </div>
            {% elseif isPremium %}
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">✨</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">SmartStyle</span> — oyiga <span class="tabular-nums font-semibold">100</span> marta foydalanish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🔓</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">To‘liq tizimga kirish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">💰</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">To‘liq moliyaviy boshqaruv</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">📊</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Kengaytirilgan statistika</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🎯</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Prioritet support</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-start sm:items-center">
                    <span class="text-xl shrink-0 mt-0.5 sm:mt-0" aria-hidden="true">🧑‍🏫</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug">Yordamchi mentorlik lavozimi</p>
                </div>
            {% else %}
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">♾️</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">SmartStyle</span> — oyiga limit yo‘q, cheksiz AI tahlil va tavsiyalar</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🧠</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">Mentorlik statusi</span> — tizimda to‘liq mentor darajasi va ustuvor ko‘rinish</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🎁</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">VIP bonuslar</span> — yopiq aksiyalar va maxsus takliflar</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🏆</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">Sovrinlar va challenge’lar</span> — loyiha e’lonlari bo‘yicha ishtirok imkoniyatlari</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">🔓</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">Maksimal kirish</span> — barcha bo‘limlar, funksiyalar va ustuvor qo‘llab-quvvatlash</p>
                </div>
                <div class="flex gap-3 px-4 py-3.5 sm:py-4 min-h-[52px] items-center">
                    <span class="text-xl shrink-0" aria-hidden="true">✈️</span>
                    <p class="text-sm sm:text-[15px] text-app-ink leading-snug"><span class="font-semibold">Sayohatlar</span> — eng faol mentorlar uchun alohida sayohat imkoniyatlari</p>
                </div>
            {% endif %}
        </div>

        {# ─── Daromad ─── #}
        <h2 class="text-base font-display font-semibold text-app-ink mb-3 px-0.5">Daromad</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
            <div class="card p-4 text-center">
                <p class="text-[10px] font-bold uppercase tracking-wider text-app-accent mb-1">Tarif tavsiyasi</p>
                <p class="text-2xl sm:text-3xl font-display font-bold text-app-ink tabular-nums">{{ (plan.planReferralPercent + 0)|round }}%</p>
                <p class="text-xs text-app-inkMuted mt-2 leading-snug">To‘g‘ridan-to‘g‘ri taklif qilgan odam pullik tarif olganda</p>
            </div>
            <div class="card p-4 text-center">
                <p class="text-[10px] font-bold uppercase tracking-wider text-app-accent mb-1">Tarmoq — mahsulot</p>
                <p class="text-2xl sm:text-3xl font-display font-bold text-app-ink tabular-nums">{{ ham_helpers.product_referral_pct(plan) }}%</p>
                <p class="text-xs text-app-inkMuted mt-2 leading-snug">Tarmog‘ingiz mahsulot sotib olganda</p>
            </div>
        </div>
        {% if not isStart %}
        <p class="text-xs text-app-inkMuted mb-4 px-0.5">Natija faollik va jamoa rivojlanishiga bog‘liq.</p>
        {% endif %}

        {% if plan.canWithdraw %}
        <div class="rounded-[14px] border border-emerald-200 bg-emerald-50 px-4 py-3 mb-4 text-center text-sm text-emerald-900">
            Bonusni naqd yechish mumkin <span class="text-emerald-800/90">(min 5&nbsp;000&nbsp;000 so'm)</span>
        </div>
        {% else %}
        <div class="rounded-[14px] border border-app-hairline bg-app-canvas px-4 py-3 mb-4 text-center text-sm text-app-inkMuted">
            Naqd yechish — faqat <strong class="text-app-ink">VIP</strong> tarifida
        </div>
        {% endif %}

        {# ─── Virtual hamyon (kirgan foydalanuvchi) ─── #}
        {% if app.user %}
        <div class="card p-4 sm:p-5 mb-4 border border-app-hairline bg-gradient-to-br from-white to-app-canvas/90">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-app-accent mb-1">Virtual hamyon</h2>
            <p class="text-xs text-app-inkMuted mb-3">Umumiy balans — tarif to‘lovi va do‘konda xarid uchun ishlatiladi.</p>
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
                <div>
                    <p class="text-2xl sm:text-3xl font-display font-bold text-app-ink tabular-nums tracking-tight">{{ app.user.generalBalance|number_format(0, '.', ' ') }} <span class="text-base font-sans font-semibold text-app-inkMuted">so'm</span></p>
                    {% if canUpgrade and app.user.generalBalance < plan.price %}
                    <p class="text-sm text-amber-900 mt-3 rounded-[12px] bg-amber-50 border border-amber-100 px-3 py-2 leading-snug">
                        Ushbu tarif narxi: <strong class="tabular-nums">{{ plan.price|number_format(0, '.', ' ') }}</strong> so'm. Balans yetarli bo‘lishi uchun avval hamyonni to‘ldiring.
                    </p>
                    {% endif %}
                </div>
                <div class="flex flex-col gap-2 w-full sm:w-auto sm:min-w-[200px] shrink-0">
                    <a href="{{ path('app_finance_topup') }}" class="btn-primary justify-center min-h-[48px] text-sm no-underline">Hamyonni to‘ldirish</a>
                    {% if app.user.hasMembership %}
                    <a href="{{ path('app_finance_index') }}" class="btn-secondary justify-center min-h-[44px] text-sm no-underline">Moliya bo‘limi</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}

        {# ─── A'zo bo'lish ─── #}
        {% if app.user %}
            {% if canUpgrade %}
                {% if app.user.generalBalance >= plan.price %}
                <form method="post" action="{{ path('app_hamkorlik_subscribe', {slug: plan.slug}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('subscribe_' ~ plan.slug) }}">
                    <input type="hidden" name="payment_method" value="balance">
                    <button type="submit" class="btn-primary w-full justify-center min-h-[52px] text-sm sm:text-base">
                        Tarifni faollashtirish — {{ plan.price|number_format(0, '.', ' ') }} so'm
                    </button>
                </form>
                {% else %}
                <div class="rounded-[14px] border border-red-200 bg-red-50 px-4 py-4 text-center text-sm text-red-800 space-y-3">
                    <p>Balansda yetarli mablag‘ yo‘q. Kerak: <strong class="tabular-nums">{{ plan.price|number_format(0, '.', ' ') }}</strong> so'm</p>
                    <a href="{{ path('app_finance_topup') }}" class="btn-primary inline-flex justify-center min-h-[48px] text-sm no-underline w-full sm:w-auto sm:min-w-[220px]">Hamyonni to‘ldirish</a>
                </div>
                {% endif %}
            {% else %}
            <div class="rounded-[14px] border border-emerald-200 bg-emerald-50 px-4 py-4 text-center text-sm font-medium text-emerald-900">
                Siz allaqachon bu yoki yuqori tarifdasiz
            </div>
            {% endif %}
        {% else %}
        <a href="{{ path('app_login') }}" class="btn-primary w-full justify-center min-h-[52px] text-sm sm:text-base">
            Kirish — tarifni tanlash
        </a>
        {% endif %}
    </div>
</section>
{% endblock %}
