{% extends 'base.html.twig' %}

{% block title %}Natijalar — SmartStyle{% endblock %}

{% block body %}
{% set sorted_recs = recommendations|sort((a, b) => b.score <=> a.score) %}
{% set hero_recs = sorted_recs|slice(0, 6) %}
{% set hero_ids = [] %}
{% for r in hero_recs %}
    {% set hero_ids = hero_ids|merge([r.product.id]) %}
{% endfor %}
{% set top_matches = recommendations|filter(r => r.score >= 90) %}
{% set top_rest = top_matches|filter(r => r.product.id not in hero_ids) %}
{% set good_matches = recommendations|filter(r => r.score >= 70 and r.score < 90) %}
{% set good_rest = good_matches|filter(r => r.product.id not in hero_ids) %}
{% set ok_matches = recommendations|filter(r => r.score >= 50 and r.score < 70) %}
{% set ok_rest = ok_matches|filter(r => r.product.id not in hero_ids) %}
{% set low_matches = recommendations|filter(r => r.score < 50) %}
{% set low_rest = low_matches|filter(r => r.product.id not in hero_ids) %}

<section class="py-6 md:py-12 bg-app-canvas border-b border-app-hairline">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="mb-6">
            <a href="{{ path('app_smart_style_index') }}" class="inline-flex items-center gap-2 text-sm text-app-inkMuted hover:text-app-ink transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                SmartStyle
            </a>
        </div>

        {# ─── 1. Birinchi ko‘rinish: manekin animatsiyasi + eng yuqori tavsiyalar ─── #}
        <div class="relative overflow-hidden rounded-[22px] border border-app-hairline bg-gradient-to-br from-white via-white to-app-canvas shadow-sm mb-8 md:mb-10">
            <div class="absolute inset-0 pointer-events-none opacity-[0.07]" aria-hidden="true" style="background-image: radial-gradient(circle at 20% 20%, #8b7355 0%, transparent 45%), radial-gradient(circle at 80% 60%, #c4a574 0%, transparent 40%);"></div>

            <div class="relative flex flex-col lg:flex-row lg:items-stretch lg:gap-10 p-5 sm:p-7 md:p-8">
                {% if profile.mannequinImage %}
                <div class="relative flex flex-col items-center justify-center shrink-0 mx-auto lg:mx-0 w-full max-w-[320px] lg:max-w-[340px] py-1">
                    <div class="pointer-events-none absolute left-1/2 top-[42%] h-52 w-52 -translate-x-1/2 -translate-y-1/2 rounded-full bg-app-accent/20 blur-3xl sm:h-60 sm:w-60 smartstyle-orb-pulse" aria-hidden="true"></div>
                    <div class="relative z-10 smartstyle-glass-backdrop smartstyle-glass-backdrop--showcase">
                        <div class="smartstyle-ring smartstyle-ring-1" aria-hidden="true"></div>
                        <div class="smartstyle-ring smartstyle-ring-2" aria-hidden="true"></div>
                        <div class="smartstyle-ring smartstyle-ring-3" aria-hidden="true"></div>
                        <div class="smartstyle-character-frame smartstyle-character-frame--float">
                            <img src="{{ profile.mannequinImage }}"
                                 alt="{{ profile.bodyTypeLabel }}"
                                 class="relative z-10 w-full h-full object-contain object-center select-none"
                                 width="260" height="420" fetchpriority="high">
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="flex-1 min-w-0 flex flex-col mt-8 lg:mt-0 {% if not profile.mannequinImage %}lg:pt-0{% endif %}">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-1">
                        <div>
                            <p class="text-[10px] font-bold tracking-[0.22em] uppercase text-app-accent mb-1">SmartStyle</p>
                            <h1 class="text-xl sm:text-2xl md:text-3xl font-display font-medium text-app-ink tracking-tight leading-tight">Sizga mos kiyimlar</h1>
                            <p class="text-xs sm:text-sm text-app-inkMuted mt-1">{{ recommendations|length }} ta tavsiya · eng moslari yuqorida</p>
                        </div>
                        <a href="{{ path('app_smart_style_scan') }}"
                           class="self-start inline-flex items-center gap-1.5 px-3 py-2.5 rounded-[14px] bg-white border border-app-hairline text-xs font-semibold text-app-inkMuted hover:text-app-ink hover:border-app-ink/20 transition-all whitespace-nowrap min-h-[44px]">
                            🔄 Qayta skan
                        </a>
                    </div>

                    {% if hero_recs|length > 0 %}
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3 mt-5 flex-1">
                        {% for rec in hero_recs %}
                            {% set tier_color = rec.score >= 90 ? 'green' : (rec.score >= 70 ? 'blue' : (rec.score >= 50 ? 'yellow' : 'yellow')) %}
                            {{ _self.product_card(rec.product, rec.score, tier_color, 'eager') }}
                        {% endfor %}
                    </div>
                    {% elseif recommendations|length == 0 %}
                    <div class="mt-6 rounded-[16px] border border-dashed border-app-hairline bg-app-canvas/80 px-4 py-8 text-center">
                        <p class="text-sm text-app-inkMuted mb-4">Hozircha profilingizga mos mahsulotlar yo‘q. Profilni pastdan ko‘ring yoki kolleksiyani oching.</p>
                        <a href="{{ path('app_product_index') }}" class="btn-primary inline-flex justify-center min-h-[48px] px-6">Kolleksiyaga o‘tish</a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ─── 2. Qolgan tavsiyalar (bir xil tasnif, takrorlanmasin) ─── #}
        {% if recommendations|length > 0 %}

            {% if top_rest|length > 0 %}
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-green-100 text-green-700 rounded-full text-sm font-bold">
                        🏆 Eng mos
                    </span>
                    <span class="text-xs text-app-inkMuted">{{ top_rest|length }} ta</span>
                    <div class="flex-1 h-px bg-app-hairline"></div>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
                    {% for rec in top_rest %}
                        {{ _self.product_card(rec.product, rec.score, 'green') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if good_rest|length > 0 %}
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-100 text-blue-700 rounded-full text-sm font-bold">
                        👍 Juda mos
                    </span>
                    <span class="text-xs text-app-inkMuted">{{ good_rest|length }} ta</span>
                    <div class="flex-1 h-px bg-app-hairline"></div>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
                    {% for rec in good_rest %}
                        {{ _self.product_card(rec.product, rec.score, 'blue') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if ok_rest|length > 0 %}
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-amber-100 text-amber-700 rounded-full text-sm font-bold">
                        👌 Mos
                    </span>
                    <span class="text-xs text-app-inkMuted">{{ ok_rest|length }} ta</span>
                    <div class="flex-1 h-px bg-app-hairline"></div>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
                    {% for rec in ok_rest %}
                        {{ _self.product_card(rec.product, rec.score, 'yellow') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if low_rest|length > 0 %}
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-5">
                    <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-app-canvas text-app-ink border border-app-hairline rounded-full text-sm font-semibold">
                        🧩 Boshqa variantlar
                    </span>
                    <span class="text-xs text-app-inkMuted">{{ low_rest|length }} ta</span>
                    <div class="flex-1 h-px bg-app-hairline"></div>
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
                    {% for rec in low_rest %}
                        {{ _self.product_card(rec.product, rec.score, 'yellow') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

        {% endif %}

        {# ─── 3. Profil va maslahatlar — ixcham, batafsil ixtiyoriy ─── #}
        <details class="group rounded-[20px] border border-app-hairline bg-white overflow-hidden mb-6 md:mb-8 shadow-sm open:shadow-md transition-shadow">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-4 sm:px-5 sm:py-4 text-left hover:bg-app-canvas/40 transition-colors min-h-[52px] [&::-webkit-details-marker]:hidden">
                <div class="min-w-0">
                    <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-app-accent mb-0.5">Profilingiz</p>
                    <p class="text-sm font-semibold text-app-ink leading-snug">
                        {{ profile.faceShapeLabel }} · {{ profile.skinToneLabel }}{% if profile.bodyType %} · {{ profile.bodyTypeLabel }}{% endif %}
                    </p>
                    <p class="text-xs text-app-inkMuted mt-0.5">O‘lcham, voqea, uslub va kiyim maslahatlari — bosib oching</p>
                </div>
                <span class="shrink-0 text-app-inkMuted text-lg leading-none transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
            </summary>
            <div class="px-4 pb-5 sm:px-5 border-t border-app-hairline bg-app-canvas/30">
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5 pt-4">
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Yuz shakli</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">👤 {{ profile.faceShapeLabel }}</p>
                    </div>
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Teri rangi</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">🎨 {{ profile.skinToneLabel }}</p>
                    </div>
                    {% if profile.gender %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Jins</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">{{ profile.gender == 'male' ? '👨 Erkak' : '👩 Ayol' }}</p>
                    </div>
                    {% endif %}
                    {% if profile.bodyType %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Tana turi</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">🧍 {{ profile.bodyTypeLabel }}</p>
                    </div>
                    {% endif %}
                    {% if profile.occasion %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Voqea</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">🎯 {{ profile.occasionLabel }}</p>
                    </div>
                    {% endif %}
                    {% if profile.styleIntent %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Uslub</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">✨ {{ profile.styleIntentLabel }}</p>
                    </div>
                    {% endif %}
                    {% if profile.season %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Fasl</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">
                            {% if profile.season == 'spring' %}🌸{% elseif profile.season == 'summer' %}☀️{% elseif profile.season == 'autumn' %}🍂{% else %}❄️{% endif %}
                            {{ profile.seasonLabel }}
                        </p>
                    </div>
                    {% endif %}
                    {% if profile.heightCm %}
                    <div class="rounded-[14px] px-3 py-2.5 border border-app-hairline bg-white">
                        <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-1">Bo'y</p>
                        <p class="text-sm font-semibold text-app-ink leading-tight">📏 {{ profile.heightCm }} sm</p>
                    </div>
                    {% endif %}
                </div>

                {% if tips|length > 0 %}
                <div class="mt-4">
                    <p class="text-[9px] font-bold uppercase tracking-widest text-app-accent mb-2">💡 Kiyim tavsiyalari</p>
                    <div class="flex flex-wrap gap-1.5">
                        {% for tip in tips %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-white text-app-ink rounded-full text-xs font-medium border border-app-hairline">
                            <svg class="w-2.5 h-2.5 shrink-0 text-app-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                            {{ tip }}
                        </span>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </details>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 md:pt-8 border-t border-app-hairline">
            <a href="{{ path('app_home') }}" class="btn-secondary flex-1 justify-center">
                🏠 Bosh sahifaga qaytish
            </a>
            <a href="{{ path('app_product_index') }}" class="btn-secondary flex-1 justify-center">
                🛒 Hamma mahsulotlarni ko'rish
            </a>
        </div>
    </div>
</section>

<style>
    .smartstyle-glass-backdrop {
        position: relative;
        width: 300px;
        height: 460px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .smartstyle-glass-backdrop--showcase {
        filter: drop-shadow(0 12px 28px rgba(28, 27, 26, 0.12));
    }

    .smartstyle-character-frame {
        position: relative;
        z-index: 2;
        width: 260px;
        height: 420px;
        border-radius: 140px 140px 120px 120px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(160deg, #ffffff 0%, #f7f5f2 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1.5px solid #e8e4de;
        box-shadow: 0 4px 24px rgba(28, 27, 26, 0.06);
    }

    .smartstyle-character-frame--float {
        animation: smartstyleFloat 5s ease-in-out infinite;
    }

    .smartstyle-ring {
        position: absolute;
        border-radius: 9999px;
        pointer-events: none;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    .smartstyle-ring-1 {
        width: 306px;
        height: 466px;
        border-radius: 153px 153px 133px 133px;
        border: 2px solid rgba(139, 115, 85, 0.45);
        animation: smartstylePulse 2.4s ease-in-out infinite;
        box-shadow: 0 0 0 0 rgba(139, 115, 85, 0.25);
    }

    .smartstyle-ring-2 {
        width: 348px;
        height: 508px;
        border-radius: 174px 174px 154px 154px;
        border: 1.5px solid rgba(196, 165, 116, 0.55);
        animation: smartstylePulse 3.2s ease-in-out infinite reverse;
        box-shadow: 0 0 24px rgba(196, 165, 116, 0.2);
    }

    .smartstyle-ring-3 {
        width: 382px;
        height: 542px;
        border-radius: 191px 191px 168px 168px;
        border: 1px solid rgba(39, 167, 231, 0.22);
        animation: smartstylePulseWide 4s ease-in-out infinite;
    }

    .smartstyle-orb-pulse {
        animation: smartstyleOrb 3.5s ease-in-out infinite;
    }

    @keyframes smartstyleFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    @keyframes smartstylePulse {
        0%, 100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.55;
            box-shadow: 0 0 0 0 rgba(139, 115, 85, 0.15);
        }
        50% {
            transform: translate(-50%, -50%) scale(1.06);
            opacity: 1;
            box-shadow: 0 0 28px 6px rgba(139, 115, 85, 0.12);
        }
    }

    @keyframes smartstylePulseWide {
        0%, 100% {
            transform: translate(-50%, -50%) scale(0.98);
            opacity: 0.35;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.04);
            opacity: 0.75;
        }
    }

    @keyframes smartstyleOrb {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 0.9; transform: scale(1.12); }
    }

    @media (max-width: 1023px) {
        .smartstyle-glass-backdrop,
        .smartstyle-glass-backdrop--showcase {
            width: 220px;
            height: 340px;
        }
        .smartstyle-character-frame {
            width: 192px;
            height: 306px;
            border-radius: 96px 96px 82px 82px;
        }
        .smartstyle-ring-1 {
            width: 228px;
            height: 348px;
            border-radius: 114px 114px 94px 94px;
        }
        .smartstyle-ring-2 {
            width: 256px;
            height: 376px;
            border-radius: 128px 128px 108px 108px;
        }
        .smartstyle-ring-3 {
            width: 284px;
            height: 404px;
            border-radius: 142px 142px 118px 118px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .smartstyle-character-frame--float,
        .smartstyle-ring-1,
        .smartstyle-ring-2,
        .smartstyle-ring-3,
        .smartstyle-orb-pulse {
            animation: none !important;
        }
        .smartstyle-character-frame--float {
            transform: none;
        }
    }
</style>

{% macro product_card(product, score, color, img_loading) %}
<a href="{{ path('app_product_show', {id: product.id}) }}"
   class="group relative flex flex-col rounded-[20px] overflow-hidden border border-app-hairline bg-white hover:border-app-ink/15 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">

    <div class="absolute top-3 left-3 z-10">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold shadow-sm
            {% if color == 'green' %}bg-green-500 text-white
            {% elseif color == 'blue' %}bg-blue-500 text-white
            {% else %}bg-amber-400 text-white{% endif %}">
            {{ score }}%
        </span>
    </div>

    <div class="aspect-[4/5] md:aspect-[3/4] bg-app-canvas overflow-hidden relative">
        {% if product.imageSrc %}
            <img src="{{ product.imageSrc }}" alt="{{ product.name }}"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 loading="{{ img_loading|default('lazy') }}" decoding="async">
        {% else %}
            <div class="w-full h-full flex items-center justify-center">
                <svg class="w-14 h-14 text-app-hairline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
        {% endif %}

        <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
            <span class="text-white text-xs font-semibold bg-white/20 backdrop-blur-sm px-3 py-1.5 rounded-full">Ko'rish →</span>
        </div>
    </div>

    <div class="p-2.5 md:p-4 flex flex-col gap-1">
        {% if product.category %}
            <p class="text-xs text-app-inkMuted truncate">{{ product.category.icon }} {{ product.category.name }}</p>
        {% endif %}
        <h3 class="font-semibold text-app-ink group-hover:text-app-accent transition-colors text-sm md:text-base leading-snug line-clamp-2">{{ product.name }}</h3>
        <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between mt-auto pt-1">
            <p class="text-app-ink font-display font-semibold text-sm md:text-base tabular-nums">{{ product.price|number_format(0, '.', ' ') }} <span class="text-xs font-sans font-medium text-app-inkMuted">so'm</span></p>
            {% if product.size|length > 0 %}
                <div class="flex flex-wrap gap-1 sm:justify-end max-w-full">
                    {% for s in product.size|slice(0, 2) %}
                        <span class="text-[10px] sm:text-xs bg-app-canvas text-app-inkMuted px-1.5 py-0.5 rounded border border-app-hairline">{{ s }}</span>
                    {% endfor %}
                    {% if product.size|length > 2 %}<span class="text-[10px] text-app-inkMuted">+{{ product.size|length - 2 }}</span>{% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</a>
{% endmacro %}
{% endblock %}
