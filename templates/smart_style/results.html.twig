{% extends 'base.html.twig' %}

{% block title %}Natijalar — SmartStyle{% endblock %}

{% block body %}
<section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        {# ─── Header with Profile ─── #}
        <div class="mb-8">
            <a href="{{ path('app_smart_style_index') }}" class="inline-flex items-center gap-2 text-sm text-brand-medium hover:text-peach-600 transition-colors mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                SmartStyle
            </a>
        </div>

        {# ─── Profile Summary ─── #}
        <div class="card p-6 md:p-8 mb-8">
            <div class="flex flex-col md:flex-row md:items-center gap-6">
                <div class="flex items-center gap-4 flex-1">
                    <div class="flex gap-3">
                        <div class="bg-beige-50 rounded-2xl px-5 py-3 text-center">
                            <span class="text-2xl">👤</span>
                            <p class="text-xs text-brand-medium mt-1">{{ profile.faceShapeLabel }}</p>
                        </div>
                        <div class="bg-beige-50 rounded-2xl px-5 py-3 text-center">
                            <span class="text-2xl">🎨</span>
                            <p class="text-xs text-brand-medium mt-1">{{ profile.skinToneLabel }}</p>
                        </div>
                    </div>
                    <div>
                        <h1 class="text-xl md:text-2xl font-display font-bold text-brand-dark">Sizga mos kiyimlar</h1>
                        <p class="text-sm text-brand-medium">{{ recommendations|length }} ta mahsulot topildi</p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <a href="{{ path('app_smart_style_scan') }}" class="btn-secondary text-sm !py-2 !px-4">🔄 Qayta skanerlash</a>
                </div>
            </div>

            {# Tips #}
            {% if tips|length > 0 %}
            <div class="mt-6 pt-6 border-t border-beige-200">
                <h3 class="text-sm font-semibold text-brand-dark mb-3">💡 Sizga mos kiyim turlari:</h3>
                <div class="flex flex-wrap gap-2">
                    {% for tip in tips %}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        {{ tip }}
                    </span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>

        {# ─── Recommendations ─── #}
        {% if recommendations|length > 0 %}

            {# Eng mos (90-100%) #}
            {% set top_matches = recommendations|filter(r => r.score >= 90) %}
            {% if top_matches|length > 0 %}
            <div class="mb-8">
                <div class="flex items-center gap-2 mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
                        🏆 Eng mos
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for rec in top_matches %}
                        {{ _self.product_card(rec.product, rec.score, 'green') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Juda mos (70-89%) #}
            {% set good_matches = recommendations|filter(r => r.score >= 70 and r.score < 90) %}
            {% if good_matches|length > 0 %}
            <div class="mb-8">
                <div class="flex items-center gap-2 mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-semibold">
                        👍 Juda mos
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for rec in good_matches %}
                        {{ _self.product_card(rec.product, rec.score, 'blue') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {# Mos (50-69%) #}
            {% set ok_matches = recommendations|filter(r => r.score >= 50 and r.score < 70) %}
            {% if ok_matches|length > 0 %}
            <div class="mb-8">
                <div class="flex items-center gap-2 mb-4">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-semibold">
                        👌 Mos
                    </span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    {% for rec in ok_matches %}
                        {{ _self.product_card(rec.product, rec.score, 'yellow') }}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

        {% else %}
        <div class="card p-12 text-center">
            <div class="text-5xl mb-4">🔍</div>
            <h2 class="text-xl font-display font-bold text-brand-dark mb-3">Mos mahsulot topilmadi</h2>
            <p class="text-brand-medium mb-6">Hozircha sizning profilingizga mos mahsulotlar yo'q. Tez orada yangi mahsulotlar qo'shiladi!</p>
            <a href="{{ path('app_product_index') }}" class="btn-primary">Barcha mahsulotlarni ko'rish</a>
        </div>
        {% endif %}

        {# ─── Bottom Navigation ─── #}
        <div class="flex flex-col sm:flex-row gap-3 mt-8 pt-8 border-t border-beige-200">
            <a href="{{ path('app_home') }}" class="btn-secondary flex-1 justify-center">
                🏠 Bosh sahifaga qaytish
            </a>
            <a href="{{ path('app_product_index') }}" class="btn-secondary flex-1 justify-center">
                🛒 Hamma mahsulotlarni ko'rish
            </a>
        </div>
    </div>
</section>

{# ─── Product Card Macro ─── #}
{% macro product_card(product, score, color) %}
<a href="{{ path('app_product_show', {id: product.id}) }}" class="card group relative">
    {# Score Badge #}
    <div class="absolute top-3 right-3 z-10">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold
            {% if color == 'green' %}bg-green-100 text-green-700
            {% elseif color == 'blue' %}bg-blue-100 text-blue-700
            {% else %}bg-yellow-100 text-yellow-700{% endif %}">
            ⭐ {{ score }}%
        </span>
    </div>

    {# Image #}
    <div class="aspect-[3/4] bg-beige-100 relative overflow-hidden">
        {% if product.imageSrc %}
            <img src="{{ product.imageSrc }}" alt="{{ product.name }}"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                 loading="lazy">
        {% else %}
            <div class="w-full h-full flex items-center justify-center">
                <svg class="w-16 h-16 text-beige-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
        {% endif %}
    </div>

    {# Info #}
    <div class="p-5">
        <h3 class="font-semibold text-brand-dark mb-1 group-hover:text-peach-600 transition-colors">{{ product.name }}</h3>
        {% if product.category %}
            <p class="text-xs text-brand-medium mb-1">{{ product.category.icon }} {{ product.category.name }}</p>
        {% endif %}
        <p class="text-peach-600 font-display font-bold text-lg">{{ product.price|number_format(0, '.', ' ') }} so'm</p>
    </div>
</a>
{% endmacro %}
{% endblock %}
