{% extends 'base.html.twig' %}

{% block title %}Skanerlash — SmartStyle{% endblock %}

{% block body %}
<section class="py-6 md:py-10 bg-app-canvas border-b border-app-hairline">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

        {# ─── Header ─── #}
        <div class="mb-5 md:mb-8">
            <a href="{{ path('app_smart_style_index') }}" class="inline-flex items-center gap-2 text-sm text-app-inkMuted hover:text-app-ink transition-colors mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Orqaga
            </a>
            <h1 class="text-2xl md:text-3xl font-display font-medium text-app-ink tracking-tight">SmartStyle tahlili</h1>
            <p class="text-app-inkMuted text-sm mt-2 leading-relaxed">Bir nechta qisqa qadamdan o'ting: xohlaganlarini o'tkazib yuborishingiz mumkin, yuz skan esa majburiy.</p>
        </div>

        {% set smart_style_scan_blocked = smartStyleQuota.limit is not null and smartStyleQuota.blocked %}

        {% if smart_style_scan_blocked %}
        <div class="card p-6 md:p-8 border border-amber-200 bg-amber-50/80 text-center">
            <div class="text-4xl mb-3" aria-hidden="true">⏳</div>
            <h2 class="text-lg font-display font-semibold text-app-ink mb-2">Bu oy uchun limit tugadi</h2>
            <p class="text-sm text-app-inkMuted leading-relaxed mb-5">
                Sizning <strong>{{ smartStyleQuota.plan|upper }}</strong> tarifingiz bo‘yicha SmartStyle tahlili bu oy <strong>{{ smartStyleQuota.limit }}</strong> martadan oshmaydi.
                Limit <strong>{{ smartStyleQuota.nextResetLabel }}</strong> sanasidan yangilanadi. Cheksiz yoki kattaroq limit uchun yuqori tarifga o‘ting.
            </p>
            <div class="flex flex-col sm:flex-row gap-2 justify-center">
                <a href="{{ path('app_hamkorlik_index') }}" class="btn-primary justify-center min-h-[48px]">Hamkorlik — tariflar</a>
                <a href="{{ path('app_smart_style_index') }}" class="btn-secondary justify-center min-h-[48px]">SmartStyle bosh sahifa</a>
            </div>
        </div>
        {% else %}
        {% if smartStyleQuota.limit is not null %}
        <div class="mb-4 rounded-[14px] border border-app-hairline bg-white px-4 py-3 text-xs sm:text-sm text-app-inkMuted">
            <span class="font-semibold text-app-ink">SmartStyle limiti (bu oy):</span>
            ishlatilgan <strong class="text-app-ink tabular-nums">{{ smartStyleQuota.used }}</strong> / <strong class="text-app-ink tabular-nums">{{ smartStyleQuota.limit }}</strong>
            {% if smartStyleQuota.remaining > 0 %}— yana <strong class="text-app-ink tabular-nums">{{ smartStyleQuota.remaining }}</strong> marta{% endif %}.
            Yangilanish: <strong class="text-app-ink">{{ smartStyleQuota.nextResetLabel }}</strong>.
        </div>
        {% elseif smartStyleQuota.limit is null %}
        <div class="mb-4 rounded-[14px] border border-amber-200 bg-amber-50/90 px-4 py-3 text-xs sm:text-sm text-app-ink">
            <span class="font-semibold">VIP</span>
            <span class="text-app-inkMuted"> — SmartStyle uchun oylik limit yo‘q (cheksiz).</span>
        </div>
        {% endif %}

        {# ─── Camera Container ─── #}
        <div id="smart-style-app">
            {# Step 1: Gender (mandatory) #}
            <div id="step-gender" class="card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-app-ink mb-2 text-center">1-qadam: Jinsni tanlang</h2>
                <p class="text-sm text-app-inkMuted mb-6 text-center">Aniqroq tavsiya va tana tipini aniqlash uchun zarur.</p>
                <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
                    <button type="button" data-gender="male"
                            class="gender-btn group flex flex-col items-center gap-3 p-6 rounded-[14px] border-2 border-app-hairline bg-white hover:bg-app-canvas transition-all duration-200">
                        <span class="text-5xl group-hover:scale-105 transition-transform">👨</span>
                        <span class="font-display font-semibold text-app-ink text-base">Erkak</span>
                    </button>
                    <button type="button" data-gender="female"
                            class="gender-btn group flex flex-col items-center gap-3 p-6 rounded-[14px] border-2 border-app-hairline bg-white hover:bg-app-canvas transition-all duration-200">
                        <span class="text-5xl group-hover:scale-105 transition-transform">👩</span>
                        <span class="font-display font-semibold text-app-ink text-base">Ayol</span>
                    </button>
                </div>
            </div>

            {# Step 2: Occasion (optional) #}
            <div id="step-occasion" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-app-ink mb-2 text-center">2-qadam: Nimaga kiyim tanlayapsiz?</h2>
                <p class="text-sm text-app-inkMuted mb-6 text-center">Bu qadamni xohlasangiz o'tkazib yuborishingiz mumkin</p>
                <div id="occasion-buttons" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-3">
                    <button type="button" data-value="office" class="occasion-btn smart-toggle-btn">💼 Ish / Ofis</button>
                    <button type="button" data-value="study" class="occasion-btn smart-toggle-btn">📚 O'qish</button>
                    <button type="button" data-value="event" class="occasion-btn smart-toggle-btn">🎉 Bazm / Tadbir</button>
                    <button type="button" data-value="casual_street" class="occasion-btn smart-toggle-btn">🧢 Kundalik / Ko'cha</button>
                    <button type="button" data-value="sport" class="occasion-btn smart-toggle-btn">🏃 Sport / Aktiv</button>
                    <button type="button" data-value="travel" class="occasion-btn smart-toggle-btn">✈️ Sayohat</button>
                    <button type="button" data-value="home" class="occasion-btn smart-toggle-btn">🏠 Uy / Casual</button>
                    <button type="button" data-value="other" class="occasion-btn smart-toggle-btn">✨ Boshqa</button>
                </div>
                <p id="occasion-hint" class="text-xs text-app-inkMuted mb-4">Bir nechta variantni tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-occasion" type="button" class="btn-secondary">O'tkazib yuborish</button>
                    <button id="btn-next-occasion" type="button" class="btn-primary">Davom etish</button>
                </div>
            </div>

            {# Step 3: Style Intent (optional) #}
            <div id="step-style" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-app-ink mb-2 text-center">3-qadam: Qanday uslub xohlaysiz?</h2>
                <p class="text-sm text-app-inkMuted mb-6 text-center">Bu qadamni xohlasangiz o'tkazib yuborishingiz mumkin</p>
                <div id="style-buttons" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-3">
                    <button type="button" data-value="minimal" class="style-btn smart-toggle-btn">▫️ Minimal</button>
                    <button type="button" data-value="classic" class="style-btn smart-toggle-btn">🕴️ Klassik</button>
                    <button type="button" data-value="street" class="style-btn smart-toggle-btn">🧢 Street</button>
                    <button type="button" data-value="elegant" class="style-btn smart-toggle-btn">✨ Elegant</button>
                    <button type="button" data-value="trendy" class="style-btn smart-toggle-btn">🔥 Trendy</button>
                    <button type="button" data-value="sport_chic" class="style-btn smart-toggle-btn">🏃 Sport-chic</button>
                </div>
                <p class="text-xs text-app-inkMuted mb-4">Bir nechta uslubni birga tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-style" type="button" class="btn-secondary">O'tkazib yuborish</button>
                    <button id="btn-next-style" type="button" class="btn-primary">Davom etish</button>
                </div>
            </div>

            {# Step 4: Season (optional) #}
            <div id="step-season" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-app-ink mb-2 text-center">4-qadam: Ob-havo (fasl)</h2>
                <p class="text-sm text-app-inkMuted mb-6 text-center">Qaysi fasl uchun kiyim qidiryapsiz?</p>
                <div id="season-buttons" class="grid grid-cols-2 gap-2.5 mb-3">
                    <button type="button" data-value="spring" class="season-btn smart-toggle-btn">🌸 Bahor</button>
                    <button type="button" data-value="summer" class="season-btn smart-toggle-btn">☀️ Yoz</button>
                    <button type="button" data-value="autumn" class="season-btn smart-toggle-btn">🍂 Kuz</button>
                    <button type="button" data-value="winter" class="season-btn smart-toggle-btn">❄️ Qish</button>
                </div>
                <p id="season-hint" class="text-xs text-app-inkMuted mb-4">Bir nechta fasl tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-season" type="button" class="btn-secondary">O'tkazib yuborish</button>
                    <button id="btn-next-season" type="button" class="btn-primary">Davom etish</button>
                </div>
            </div>

            {# Step 5: Measurements (optional) #}
            <div id="step-measurements" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-app-ink mb-2 text-center">5-qadam: Tana ma'lumoti</h2>
                <p class="text-sm text-app-inkMuted mb-5 text-center">Har bir joyni o'lchab kiriting. Rasmda ko'rsatilgan chiziq bo'yicha santimetr lenta bilan o'lchang.</p>

                <div class="measure-actor-layout mb-5">
                    <div class="measure-menu-panel">
                        <button type="button" class="measure-menu-btn is-active" data-target="measure-height">📏 Bo'y</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-shoulder">🧥 Yelka</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-chest">💗 Ko'krak</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-waist">🪢 Bel</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-hip">🌀 Son</button>
                    </div>

                    <div class="measure-stage-panel">
                        <div id="measure-height" class="measure-stage is-active">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/measurements/boy.png') }}" alt="Bo'y o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Bo'y (sm)</p>
                            <p class="measure-stage-text">Boshning eng yuqori nuqtasidan to tovongacha o'lchang.</p>
                            <input id="height-cm" type="number" min="100" max="230" placeholder="Masalan: 170" class="input-field measure-input">
                        </div>

                        <div id="measure-shoulder" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/measurements/yelka.png') }}" alt="Yelka o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Yelka (sm)</p>
                            <p class="measure-stage-text">Bir yelka uchidan ikkinchi yelka uchigacha o'lchang.</p>
                            <input id="shoulder-cm" type="number" min="30" max="80" placeholder="Masalan: 42" class="input-field measure-input">
                        </div>

                        <div id="measure-chest" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/measurements/kokrak.png') }}" alt="Ko'krak o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Ko'krak (sm)</p>
                            <p class="measure-stage-text">Ko'krakning eng keng qismidan aylana bo'yicha o'lchang.</p>
                            <input id="chest-cm" type="number" min="50" max="180" placeholder="Masalan: 94" class="input-field measure-input">
                        </div>

                        <div id="measure-waist" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/measurements/bel.png') }}" alt="Bel o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Bel (sm)</p>
                            <p class="measure-stage-text">Belning eng ingichka joyidan aylana bo'yicha o'lchang.</p>
                            <input id="waist-cm" type="number" min="40" max="180" placeholder="Masalan: 72" class="input-field measure-input">
                        </div>

                        <div id="measure-hip" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/measurements/son.png') }}" alt="Son o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Son (sm)</p>
                            <p class="measure-stage-text">Sonning eng keng qismidan aylana bo'yicha o'lchang.</p>
                            <input id="hip-cm" type="number" min="50" max="200" placeholder="Masalan: 98" class="input-field measure-input">
                        </div>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-measurements" type="button" class="btn-secondary">O'tkazib yuborish</button>
                    <button id="btn-next-measurements" type="button" class="btn-primary">Davom etish</button>
                </div>
            </div>

            {# Step 6: Camera / Upload (mandatory) #}
            <div id="step-camera" class="hidden card smart-step-card p-4 md:p-8">
                <div class="relative mx-auto mb-5 md:mb-6 w-[220px] h-[220px] sm:w-[280px] sm:h-[280px]">
                    {# Camera preview #}
                    <video id="camera-preview" class="absolute inset-0 w-full h-full object-cover rounded-full hidden" autoplay playsinline></video>

                    {# Image preview #}
                    <img id="image-preview" class="absolute inset-0 w-full h-full object-cover rounded-full hidden" alt="Preview">

                    {# Placeholder #}
                    <div id="camera-placeholder" class="absolute inset-0 w-full h-full rounded-full bg-app-canvas flex items-center justify-center border-4 border-dashed border-app-hairline">
                        <div class="text-center p-4">
                            <div class="text-5xl mb-3">😊</div>
                            <p class="text-sm text-app-inkMuted leading-tight">Yuzingizni<br>shu yerga</p>
                        </div>
                    </div>

                    {# Scanning overlay #}
                    <div id="scan-overlay" class="hidden absolute inset-0 rounded-full border-4 border-app-accent animate-pulse"></div>
                </div>

                {# Buttons #}
                <div id="camera-buttons" class="space-y-2.5">
                    <button id="btn-camera" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        📷 Kamerani ochish
                    </button>
                    <label class="w-full btn-secondary justify-center py-3 cursor-pointer block text-center text-sm md:text-base">
                        🖼 Galereyadan yuklash
                        <input id="file-input" type="file" accept="image/*" class="hidden">
                    </label>
                </div>

                {# Capture & Analyze buttons (hidden initially) #}
                <div id="capture-buttons" class="hidden space-y-2.5">
                    <button id="btn-capture" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        📸 Suratga olish
                    </button>
                    <button id="btn-cancel-camera" type="button"
                            class="w-full btn-secondary justify-center py-3">
                        ✕ Bekor qilish
                    </button>
                </div>

                {# Analyze button (after capture/upload) #}
                <div id="analyze-buttons" class="hidden space-y-2.5">
                    <button id="btn-analyze" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        ✨ Tahlil qilish
                    </button>
                    <button id="btn-retake" type="button"
                            class="w-full btn-secondary justify-center py-3">
                        🔄 Qayta olish
                    </button>
                </div>
            </div>

            {# Step 2: Loading #}
            <div id="step-loading" class="hidden card p-6 md:p-12 text-center">
                <div class="mb-6">
                    <div class="w-24 h-24 mx-auto rounded-full bg-app-canvas border border-app-hairline flex items-center justify-center mb-4">
                        <svg class="w-12 h-12 text-app-ink animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
                <h2 class="text-xl font-display font-semibold text-app-ink mb-3">Tahlil qilinmoqda...</h2>
                <div class="w-full bg-app-hairline rounded-full h-2 mb-4 max-w-xs mx-auto">
                    <div id="progress-bar" class="bg-app-ink h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
                <p id="loading-text" class="text-sm text-app-inkMuted">Model yuklanmoqda...</p>
            </div>

            {# Step 3: Error #}
            <div id="step-error" class="hidden card p-6 md:p-12 text-center">
                <div class="text-5xl mb-4">😕</div>
                <h2 id="error-title" class="text-xl font-display font-semibold text-app-ink mb-3">Xatolik</h2>
                <div id="error-text" class="text-sm text-app-inkMuted mb-6 text-left max-w-md mx-auto">Yuzni aniqlab bo'lmadi. Iltimos, qaytadan urinib ko'ring.</div>
                <button id="btn-retry" type="button" class="btn-primary">Qayta urinish</button>
                <a id="btn-tariffs" href="{{ path('app_hamkorlik_index') }}" class="hidden mt-3 btn-primary justify-center min-h-[48px] inline-flex w-full sm:w-auto sm:min-w-[12rem]">Hamkorlik — tariflar</a>
            </div>
        </div>

        {# Privacy note #}
        <div class="mt-5 text-center">
            <p class="text-[11px] md:text-xs text-app-inkMuted flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-app-accent shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                Rasmingiz serverga yuborilmaydi. Barcha tahlil brauzeringizda amalga oshiriladi.
            </p>
        </div>

        {# Hidden canvas for processing #}
        <canvas id="processing-canvas" class="hidden"></canvas>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if not (smartStyleQuota.limit is not null and smartStyleQuota.blocked) %}
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-core@4.17.0/dist/tf-core.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-converter@4.17.0/dist/tf-converter.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-backend-webgl@4.17.0/dist/tf-backend-webgl.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-landmarks-detection@1.0.5/dist/face-landmarks-detection.js"></script>
    <script src="{{ asset('js/smart-style-scan.js') }}" data-analyze-url="{{ path('app_smart_style_analyze') }}" data-results-url="{{ path('app_smart_style_results') }}"></script>
    {% endif %}
{% endblock %}
