{% extends 'base.html.twig' %}

{% block title %}Skanerlash — SmartStyle{% endblock %}

{% block body %}
<section class="py-6 md:py-10">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">

        {# ─── Header ─── #}
        <div class="mb-5 md:mb-8">
            <a href="{{ path('app_smart_style_index') }}" class="inline-flex items-center gap-2 text-sm text-brand-medium hover:text-peach-600 transition-colors mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Orqaga
            </a>
            <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">SmartStyle tahlili</h1>
            <p class="text-brand-medium text-sm mt-1.5">Bir nechta qisqa qadamdan o'ting: xohlaganlarini o'tkazib yuborishingiz mumkin, yuz skan esa majburiy.</p>
        </div>

        {# ─── Camera Container ─── #}
        <div id="smart-style-app">
            {# Step 1: Occasion (optional) #}
            <div id="step-occasion" class="card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-brand-dark mb-2 text-center">1-qadam: Nimaga kiyim tanlayapsiz?</h2>
                <p class="text-sm text-brand-medium mb-6 text-center">Bu qadamni xohlasangiz o'tkazib yuborishingiz mumkin</p>
                <div id="occasion-buttons" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-3">
                    <button type="button" data-value="office" class="occasion-btn smart-toggle-btn">💼 Ish / Ofis</button>
                    <button type="button" data-value="study" class="occasion-btn smart-toggle-btn">📚 O'qish</button>
                    <button type="button" data-value="event" class="occasion-btn smart-toggle-btn">🎉 Bazm / Tadbir</button>
                    <button type="button" data-value="casual_street" class="occasion-btn smart-toggle-btn">🧢 Kundalik / Ko'cha</button>
                    <button type="button" data-value="sport" class="occasion-btn smart-toggle-btn">🏃 Sport / Aktiv</button>
                    <button type="button" data-value="travel" class="occasion-btn smart-toggle-btn">✈️ Sayohat</button>
                    <button type="button" data-value="home" class="occasion-btn smart-toggle-btn">🏠 Uy / Casual</button>
                    <button type="button" data-value="other" class="occasion-btn smart-toggle-btn">✨ Boshqa</button>
                </div>
                <p id="occasion-hint" class="text-xs text-brand-medium mb-4">Bir nechta variantni tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-occasion" type="button" class="btn-secondary smart-skip-btn">O'tkazib yuborish</button>
                    <button id="btn-next-occasion" type="button" class="btn-primary smart-next-btn">Davom etish</button>
                </div>
            </div>

            {# Step 2: Style Intent (optional) #}
            <div id="step-style" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-brand-dark mb-2 text-center">2-qadam: Qanday uslub xohlaysiz?</h2>
                <p class="text-sm text-brand-medium mb-6 text-center">Bu qadamni xohlasangiz o'tkazib yuborishingiz mumkin</p>
                <div id="style-buttons" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-3">
                    <button type="button" data-value="minimal" class="style-btn smart-toggle-btn">▫️ Minimal</button>
                    <button type="button" data-value="classic" class="style-btn smart-toggle-btn">🕴️ Klassik</button>
                    <button type="button" data-value="street" class="style-btn smart-toggle-btn">🧢 Street</button>
                    <button type="button" data-value="elegant" class="style-btn smart-toggle-btn">✨ Elegant</button>
                    <button type="button" data-value="trendy" class="style-btn smart-toggle-btn">🔥 Trendy</button>
                    <button type="button" data-value="sport_chic" class="style-btn smart-toggle-btn">🏃 Sport-chic</button>
                </div>
                <p class="text-xs text-brand-medium mb-4">Bir nechta uslubni birga tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-style" type="button" class="btn-secondary smart-skip-btn">O'tkazib yuborish</button>
                    <button id="btn-next-style" type="button" class="btn-primary smart-next-btn">Davom etish</button>
                </div>
            </div>

            {# Step 3: Season (optional) #}
            <div id="step-season" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-brand-dark mb-2 text-center">3-qadam: Ob-havo (fasl)</h2>
                <p class="text-sm text-brand-medium mb-6 text-center">Qaysi fasl uchun kiyim qidiryapsiz?</p>
                <div id="season-buttons" class="grid grid-cols-2 gap-2.5 mb-3">
                    <button type="button" data-value="spring" class="season-btn smart-toggle-btn">🌸 Bahor</button>
                    <button type="button" data-value="summer" class="season-btn smart-toggle-btn">☀️ Yoz</button>
                    <button type="button" data-value="autumn" class="season-btn smart-toggle-btn">🍂 Kuz</button>
                    <button type="button" data-value="winter" class="season-btn smart-toggle-btn">❄️ Qish</button>
                </div>
                <p id="season-hint" class="text-xs text-brand-medium mb-4">Bir nechta fasl tanlashingiz mumkin.</p>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-season" type="button" class="btn-secondary smart-skip-btn">O'tkazib yuborish</button>
                    <button id="btn-next-season" type="button" class="btn-primary smart-next-btn">Davom etish</button>
                </div>
            </div>

            {# Step 4: Measurements (optional) #}
            <div id="step-measurements" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-brand-dark mb-2 text-center">4-qadam: Tana ma'lumoti</h2>
                <p class="text-sm text-brand-medium mb-5 text-center">Har bir joyni o'lchab kiriting. Rasmda ko'rsatilgan chiziq bo'yicha santimetr lenta bilan o'lchang.</p>

                <div class="measure-actor-layout mb-5">
                    <div class="measure-menu-panel">
                        <button type="button" class="measure-menu-btn is-active" data-target="measure-height">📏 Bo'y</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-shoulder">🧥 Yelka</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-chest">💗 Ko'krak</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-waist">🪢 Bel</button>
                        <button type="button" class="measure-menu-btn" data-target="measure-hip">🌀 Son</button>
                    </div>

                    <div class="measure-stage-panel">
                        <div id="measure-height" class="measure-stage is-active">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/smartstyle/measures/height.png') }}" alt="Bo'y o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Bo'y (sm)</p>
                            <p class="measure-stage-text">Boshning eng yuqori nuqtasidan to tovongacha o'lchang.</p>
                            <input id="height-cm" type="number" min="100" max="230" placeholder="Masalan: 170" class="input-field measure-input">
                        </div>

                        <div id="measure-shoulder" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/smartstyle/measures/shoulder.png') }}" alt="Yelka o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Yelka (sm)</p>
                            <p class="measure-stage-text">Bir yelka uchidan ikkinchi yelka uchigacha o'lchang.</p>
                            <input id="shoulder-cm" type="number" min="30" max="80" placeholder="Masalan: 42" class="input-field measure-input">
                        </div>

                        <div id="measure-chest" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/smartstyle/measures/chest.png') }}" alt="Ko'krak o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Ko'krak (sm)</p>
                            <p class="measure-stage-text">Ko'krakning eng keng qismidan aylana bo'yicha o'lchang.</p>
                            <input id="chest-cm" type="number" min="50" max="180" placeholder="Masalan: 94" class="input-field measure-input">
                        </div>

                        <div id="measure-waist" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/smartstyle/measures/waist.png') }}" alt="Bel o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Bel (sm)</p>
                            <p class="measure-stage-text">Belning eng ingichka joyidan aylana bo'yicha o'lchang.</p>
                            <input id="waist-cm" type="number" min="40" max="180" placeholder="Masalan: 72" class="input-field measure-input">
                        </div>

                        <div id="measure-hip" class="measure-stage hidden">
                            <div class="measure-stage-visual">
                                <img src="{{ asset('images/smartstyle/measures/hip.png') }}" alt="Son o'lchash" class="measure-stage-image">
                            </div>
                            <p class="measure-stage-title">Son (sm)</p>
                            <p class="measure-stage-text">Sonning eng keng qismidan aylana bo'yicha o'lchang.</p>
                            <input id="hip-cm" type="number" min="50" max="200" placeholder="Masalan: 98" class="input-field measure-input">
                        </div>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-2 justify-end mt-1">
                    <button id="btn-skip-measurements" type="button" class="btn-secondary smart-skip-btn">O'tkazib yuborish</button>
                    <button id="btn-next-measurements" type="button" class="btn-primary smart-next-btn">Davom etish</button>
                </div>
            </div>

            {# Step 5: Gender Selection (optional) #}
            <div id="step-gender" class="hidden card smart-step-card p-4 md:p-8">
                <h2 class="text-lg font-display font-semibold text-brand-dark mb-2 text-center">Qo'shimcha: Jinsingizni tanlang</h2>
                <p class="text-sm text-brand-medium mb-6 text-center">Aniqroq tavsiya uchun. Xohlasangiz o'tkazib yuboring.</p>
                <div class="grid grid-cols-2 gap-3 max-w-sm mx-auto mb-4">
                    <button type="button" data-gender="male"
                            class="gender-btn group flex flex-col items-center gap-2 p-5 rounded-2xl border-2 border-beige-200 hover:border-peach-400 hover:bg-peach-50 transition-all duration-200">
                        <span class="text-4xl group-hover:scale-110 transition-transform">👨</span>
                        <span class="font-display font-semibold text-brand-dark">Erkak</span>
                    </button>
                    <button type="button" data-gender="female"
                            class="gender-btn group flex flex-col items-center gap-2 p-5 rounded-2xl border-2 border-beige-200 hover:border-peach-400 hover:bg-peach-50 transition-all duration-200">
                        <span class="text-4xl group-hover:scale-110 transition-transform">👩</span>
                        <span class="font-display font-semibold text-brand-dark">Ayol</span>
                    </button>
                </div>
                <div class="text-center">
                    <button id="btn-skip-gender" type="button" class="btn-secondary smart-skip-btn">O'tkazib yuborish</button>
                </div>
            </div>

            {# Step 6: Camera / Upload (mandatory) #}
            <div id="step-camera" class="hidden card smart-step-card p-4 md:p-8">
                <div class="relative mx-auto mb-5 md:mb-6 w-[220px] h-[220px] sm:w-[280px] sm:h-[280px]">
                    {# Camera preview #}
                    <video id="camera-preview" class="absolute inset-0 w-full h-full object-cover rounded-full hidden" autoplay playsinline></video>

                    {# Image preview #}
                    <img id="image-preview" class="absolute inset-0 w-full h-full object-cover rounded-full hidden" alt="Preview">

                    {# Placeholder #}
                    <div id="camera-placeholder" class="absolute inset-0 w-full h-full rounded-full bg-beige-100 flex items-center justify-center border-4 border-dashed border-beige-300">
                        <div class="text-center p-4">
                            <div class="text-5xl mb-3">😊</div>
                            <p class="text-sm text-brand-medium leading-tight">Yuzingizni<br>shu yerga</p>
                        </div>
                    </div>

                    {# Scanning overlay #}
                    <div id="scan-overlay" class="hidden absolute inset-0 rounded-full border-4 border-peach-500 animate-pulse"></div>
                </div>

                {# Buttons #}
                <div id="camera-buttons" class="space-y-2.5">
                    <button id="btn-camera" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        📷 Kamerani ochish
                    </button>
                    <label class="w-full btn-secondary justify-center py-3 cursor-pointer block text-center text-sm md:text-base">
                        🖼 Galereyadan yuklash
                        <input id="file-input" type="file" accept="image/*" class="hidden">
                    </label>
                </div>

                {# Capture & Analyze buttons (hidden initially) #}
                <div id="capture-buttons" class="hidden space-y-2.5">
                    <button id="btn-capture" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        📸 Suratga olish
                    </button>
                    <button id="btn-cancel-camera" type="button"
                            class="w-full btn-secondary justify-center py-3">
                        ✕ Bekor qilish
                    </button>
                </div>

                {# Analyze button (after capture/upload) #}
                <div id="analyze-buttons" class="hidden space-y-2.5">
                    <button id="btn-analyze" type="button"
                            class="w-full btn-primary justify-center py-3.5 text-base">
                        ✨ Tahlil qilish
                    </button>
                    <button id="btn-retake" type="button"
                            class="w-full btn-secondary justify-center py-3">
                        🔄 Qayta olish
                    </button>
                </div>
            </div>

            {# Step 2: Loading #}
            <div id="step-loading" class="hidden card p-6 md:p-12 text-center">
                <div class="mb-6">
                    <div class="w-24 h-24 mx-auto rounded-full bg-peach-50 flex items-center justify-center mb-4">
                        <svg class="w-12 h-12 text-peach-500 animate-spin" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </div>
                </div>
                <h2 class="text-xl font-display font-bold text-brand-dark mb-3">Tahlil qilinmoqda...</h2>
                <div class="w-full bg-beige-200 rounded-full h-2 mb-4 max-w-xs mx-auto">
                    <div id="progress-bar" class="bg-peach-500 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>
                <p id="loading-text" class="text-sm text-brand-medium">Model yuklanmoqda...</p>
            </div>

            {# Step 3: Error #}
            <div id="step-error" class="hidden card p-6 md:p-12 text-center">
                <div class="text-5xl mb-4">😕</div>
                <h2 class="text-xl font-display font-bold text-brand-dark mb-3">Xatolik</h2>
                <p id="error-text" class="text-sm text-brand-medium mb-6">Yuzni aniqlab bo'lmadi. Iltimos, qaytadan urinib ko'ring.</p>
                <button id="btn-retry" type="button" class="btn-primary">Qayta urinish</button>
            </div>
        </div>

        {# Privacy note #}
        <div class="mt-5 text-center">
            <p class="text-[11px] md:text-xs text-brand-medium flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                Rasmingiz serverga yuborilmaydi. Barcha tahlil brauzeringizda amalga oshiriladi.
            </p>
        </div>

        {# Hidden canvas for processing #}
        <canvas id="processing-canvas" class="hidden"></canvas>
    </div>
</section>

<style>
    .smart-step-card {
        background: linear-gradient(180deg, #ffffff 0%, #fffaf5 100%);
        border: 1px solid rgba(231, 218, 197, 0.9);
        box-shadow: 0 8px 30px rgba(141, 107, 79, 0.08);
    }

    .smart-skip-btn {
        border: 1px solid rgba(225, 193, 160, 0.9);
        background: linear-gradient(180deg, #fffaf4 0%, #fff0e1 100%);
        color: #8a5a35;
        font-weight: 700;
        letter-spacing: 0.01em;
        box-shadow: 0 4px 14px rgba(184, 132, 88, 0.14);
        transition: transform 140ms ease, box-shadow 160ms ease, border-color 160ms ease, color 160ms ease;
    }

    .smart-skip-btn:hover {
        border-color: #eca66a;
        color: #7c471f;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(236, 166, 106, 0.28);
    }

    .smart-skip-btn:active {
        transform: translateY(0);
        box-shadow: 0 3px 10px rgba(236, 166, 106, 0.2);
    }

    .smart-next-btn {
        background: linear-gradient(135deg, #f39a52 0%, #e77c2a 100%);
        border: 1px solid rgba(214, 111, 32, 0.95);
        color: #fff;
        font-weight: 800;
        letter-spacing: 0.01em;
        box-shadow: 0 10px 22px rgba(231, 124, 42, 0.28);
        transition: transform 140ms ease, box-shadow 160ms ease, filter 160ms ease;
    }

    .smart-next-btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.02);
        box-shadow: 0 14px 26px rgba(231, 124, 42, 0.32);
    }

    .smart-next-btn:active {
        transform: translateY(0);
        box-shadow: 0 6px 14px rgba(231, 124, 42, 0.25);
    }

    .measure-actor-layout {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 14px;
        align-items: stretch;
    }

    .measure-menu-panel {
        border: 1px solid #eadfce;
        border-radius: 1rem;
        background: #fffdf9;
        padding: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    }

    .measure-menu-btn {
        border: 1px solid #ead8bf;
        border-radius: 0.8rem;
        background: #fff8ef;
        color: #5e4c3e;
        font-size: 0.85rem;
        font-weight: 700;
        text-align: left;
        padding: 0.58rem 0.7rem;
        transition: all 180ms ease;
    }

    .measure-menu-btn:hover {
        border-color: #efba88;
        transform: translateX(2px);
        background: #fff1e3;
    }

    .measure-menu-btn.is-active {
        border-color: #ef944e;
        background: linear-gradient(180deg, #ffeed9 0%, #ffe3c3 100%);
        color: #7f451c;
        box-shadow: 0 6px 16px rgba(239, 148, 78, 0.2);
    }

    .measure-stage-panel {
        border: 1px solid #eadfce;
        border-radius: 1rem;
        background: #ffffff;
        padding: 0.75rem;
        box-shadow: 0 10px 26px rgba(169, 126, 86, 0.1);
        min-height: 350px;
    }

    .measure-stage {
        height: 100%;
    }

    .measure-stage-visual {
        border-radius: 0.9rem;
        min-height: 225px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background: radial-gradient(circle at 35% 20%, #fff8ef 0%, #f9eddd 100%);
        overflow: hidden;
        position: relative;
    }

    .measure-stage-visual::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent 34%, rgba(255, 255, 255, 0.45) 50%, transparent 66%);
        transform: translateX(-120%);
        animation: measureShine 4.2s ease-in-out infinite;
    }

    .measure-stage-image {
        width: 100%;
        max-width: 260px;
        height: 210px;
        object-fit: contain;
        animation: measureFloat 4s ease-in-out infinite;
    }

    .measure-stage-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #3f3125;
        margin-bottom: 0.2rem;
    }

    .measure-stage-text {
        font-size: 0.75rem;
        color: #7c6755;
        margin-bottom: 0.5rem;
    }

    .smart-toggle-btn {
        border: 2px solid #e7dac5;
        background: #fffdf9;
        color: #5a4737;
        border-radius: 0.9rem;
        padding: 0.7rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.25;
        transition: all 180ms ease;
    }

    .smart-toggle-btn:hover {
        border-color: #f0b486;
        background: #fff3e7;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(240, 180, 134, 0.2);
    }

    .smart-toggle-btn.is-selected {
        border-color: #f39a52;
        background: linear-gradient(180deg, #fff4e7 0%, #ffe9d4 100%);
        color: #8b4f1f;
        box-shadow: 0 6px 16px rgba(243, 154, 82, 0.2);
    }

    .measure-card {
        transition: transform 200ms ease, box-shadow 220ms ease, border-color 200ms ease;
    }

    .measure-card:hover {
        transform: translateY(-2px);
        border-color: #efbd94;
        box-shadow: 0 10px 22px rgba(206, 154, 109, 0.16);
    }

    .measure-visual {
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 30% 20%, #fff8ef 0%, #f9efdf 100%);
    }

    .measure-visual::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, transparent 35%, rgba(255, 255, 255, 0.45) 50%, transparent 65%);
        transform: translateX(-120%);
        animation: measureShine 3.8s ease-in-out infinite;
        pointer-events: none;
    }

    .measure-visual img {
        animation: measureFloat 4s ease-in-out infinite;
    }

    .measure-input {
        border-width: 2px;
        border-color: #eadcc9;
        transition: border-color 160ms ease, box-shadow 160ms ease;
    }

    .measure-input:focus {
        border-color: #ef9a5a;
        box-shadow: 0 0 0 4px rgba(239, 154, 90, 0.14);
    }

    @keyframes measureFloat {
        0%,
        100% { transform: translateY(0px); }
        50% { transform: translateY(-4px); }
    }

    @keyframes measureShine {
        0%,
        20% { transform: translateX(-120%); }
        50% { transform: translateX(130%); }
        100% { transform: translateX(130%); }
    }

    @media (max-width: 850px) {
        .measure-actor-layout {
            grid-template-columns: 1fr;
        }

        .measure-menu-panel {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .measure-menu-btn {
            text-align: center;
