{% extends 'base.html.twig' %}

{% block title %}Mening buyurtmalarim — Pesca{% endblock %}

{% block body %}
<section class="py-6 md:py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">Mening buyurtmalarim</h1>
                <p class="text-sm text-brand-medium mt-1">Barcha buyurtmalaringiz tarixi</p>
            </div>
            <a href="{{ path('app_profile_index') }}" class="btn-secondary text-sm">← Profil</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-800 rounded-xl text-sm">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm">{{ message }}</div>
        {% endfor %}

        {% if orders|length == 0 %}
            <div class="card p-10 text-center">
                <div class="w-16 h-16 mx-auto mb-4 bg-beige-100 rounded-full flex items-center justify-center text-2xl">🛍️</div>
                <p class="text-brand-medium mb-4">Hali buyurtma berilmagan.</p>
                <a href="{{ path('app_product_index') }}" class="btn-primary">Xaridni boshlash</a>
            </div>
        {% else %}
            <div class="space-y-4">
                {% for order in orders %}
                    {% set paymentColor = order.paymentStatus == 'approved' ? 'green' : (order.paymentStatus == 'rejected' ? 'red' : 'yellow') %}
                    {% set statusColorMap = {
                        'in_production': 'blue',
                        'ready': 'emerald',
                        'completed': 'gray',
                        'canceled': 'red',
                        'paid': 'green',
                        'payment_pending': 'yellow',
                        'new': 'yellow'
                    } %}
                    {% set orderColor = statusColorMap[order.orderStatus] ?? 'gray' %}

                    <div class="card p-4 md:p-5">
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div>
                                <div class="font-display font-bold text-brand-dark text-lg">#{{ order.id }}</div>
                                <div class="text-xs text-brand-light mt-0.5">{{ order.createdAt|date('d.m.Y H:i') }}</div>
                            </div>
                            <div class="flex flex-wrap gap-2 justify-end">
                                <span class="badge bg-{{ paymentColor }}-100 text-{{ paymentColor }}-700 text-xs">
                                    {{ order.paymentStatusLabel }}
                                </span>
                                <span class="badge bg-{{ orderColor }}-100 text-{{ orderColor }}-700 text-xs">
                                    {{ order.orderStatusLabel }}
                                </span>
                            </div>
                        </div>

                        <div class="border-t border-beige-100 pt-3 space-y-2">
                            {% for item in order.items %}
                                <div class="flex items-center gap-3">
                                    {% if item.productImageSnapshot %}
                                        <img src="{{ item.productImageSnapshot }}" alt="" class="w-10 h-10 rounded-lg object-cover bg-beige-100 flex-shrink-0">
                                    {% else %}
                                        <div class="w-10 h-10 rounded-lg bg-beige-100 flex-shrink-0"></div>
                                    {% endif %}
                                    <div class="flex-1 min-w-0">
                                        <div class="text-sm font-medium text-brand-dark truncate">{{ item.productNameSnapshot }}</div>
                                        <div class="text-xs text-brand-light">
                                            {{ item.quantity }} dona{% if item.selectedSize %} · {{ item.selectedSize }}{% endif %}
                                        </div>
                                    </div>
                                    <div class="text-sm font-semibold text-brand-dark flex-shrink-0">
                                        {{ item.lineTotal|number_format(0, '.', ' ') }} so'm
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div class="border-t border-beige-100 mt-3 pt-3 flex items-center justify-between">
                            <div class="text-sm text-brand-medium">
                                Lokatsiya: <span class="text-brand-dark font-medium">{{ order.locationLabel }}</span>
                            </div>
                            <div class="font-display font-bold text-brand-dark">
                                {{ order.subtotalAmount|number_format(0, '.', ' ') }} so'm
                            </div>
                        </div>

                        {% if order.notes %}
                            <div class="mt-2 text-xs text-brand-medium bg-beige-50 rounded-lg px-3 py-2">
                                Izoh: {{ order.notes }}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
