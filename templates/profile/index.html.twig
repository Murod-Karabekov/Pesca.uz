{% extends 'base.html.twig' %}

{% block title %}Shaxsiy kabinet{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="card p-4 sm:p-5 mb-4">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-app-accent mb-1.5">Shaxsiy kabinet</p>
                    <h1 class="text-xl sm:text-2xl font-display font-medium text-app-ink leading-tight">Salom, {{ user.fullName|split(' ')[0] }}!</h1>
                    <p class="text-sm text-app-inkMuted mt-1.5 leading-snug">Profilingiz va balansingiz.</p>
                </div>
                <div class="flex flex-col items-center gap-2 shrink-0">
                    <div class="w-12 h-12 rounded-[14px] bg-app-ink text-app-canvas flex items-center justify-center font-semibold text-lg">
                        {{ user.fullName|first|upper }}
                    </div>
                    <a href="{{ path('app_logout') }}" class="inline-flex items-center justify-center gap-1 min-h-[40px] px-3 rounded-[12px] border border-app-hairline bg-white text-app-inkMuted text-xs font-medium hover:text-app-ink hover:bg-app-canvas transition-colors">
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 4v1a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h5a2 2 0 012 2v1"/>
                        </svg>
                        Chiqish
                    </a>
                </div>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-800 rounded-full text-[11px] font-semibold">{{ user.currentPlanLabel }}</span>
                <span class="inline-flex items-center px-2.5 py-1 bg-app-canvas border border-app-hairline rounded-full text-[11px] text-app-inkMuted">A'zo: {{ user.createdAt|date('d.m.Y') }}</span>
            </div>
        </div>

        <nav class="app-pill-nav mb-4" aria-label="Profil bo'limlari">
            <a href="{{ path('app_profile_index') }}" class="bg-app-ink text-app-canvas border-app-ink border">Umumiy</a>
            <a href="{{ path('app_profile_edit') }}" class="bg-white text-app-ink border-app-hairline border hover:bg-app-canvas">Tahrirlash</a>
            <a href="{{ path('app_profile_password') }}" class="bg-white text-app-ink border-app-hairline border hover:bg-app-canvas">Parol</a>
            {% if user.hasMembership %}
                <a href="{{ path('app_finance_index') }}" class="bg-white text-app-ink border-app-hairline border hover:bg-app-canvas">Moliya</a>
            {% else %}
                <a href="{{ path('app_hamkorlik_index') }}" class="bg-white text-app-ink border-app-hairline border hover:bg-app-canvas">Tariflar</a>
            {% endif %}
        </nav>

        <div class="space-y-4">
            <div class="card p-4 sm:p-5">
                <div class="flex items-center justify-between gap-2 mb-3">
                    <h2 class="font-display font-semibold text-base text-app-ink">Shaxsiy ma'lumotlar</h2>
                    <a href="{{ path('app_profile_edit') }}" class="text-xs font-semibold text-app-accent hover:text-app-ink min-h-[44px] inline-flex items-center px-2">Tahrirlash</a>
                </div>

                <div class="space-y-2 text-sm">
                    <div class="rounded-[12px] bg-app-canvas border border-app-hairline px-3 py-2.5 flex items-center justify-between gap-2">
                        <span class="text-app-inkMuted shrink-0">Ism</span>
                        <span class="text-app-ink font-medium text-right truncate">{{ user.fullName }}</span>
                    </div>
                    <div class="rounded-[12px] bg-app-canvas border border-app-hairline px-3 py-2.5 flex items-center justify-between gap-2">
                        <span class="text-app-inkMuted shrink-0">Telefon</span>
                        <span class="text-app-ink font-medium text-right font-mono text-xs sm:text-sm">{{ user.phone }}</span>
                    </div>
                    <div class="rounded-[12px] bg-app-canvas border border-app-hairline px-3 py-2.5">
                        <div class="text-app-inkMuted text-xs mb-2">Referral havola</div>
                        <div class="flex items-stretch gap-2">
                            <input type="text" readonly id="referral-link"
                                   value="{{ app.request.schemeAndHttpHost }}/register/{{ user.referralCode }}"
                                   class="text-[11px] sm:text-xs font-mono bg-white border border-app-hairline rounded-[10px] px-2.5 py-2.5 flex-1 min-w-0 text-app-ink">
                            <button type="button" id="copy-btn"
                                    class="min-w-[48px] shrink-0 px-3 rounded-[10px] border border-app-hairline bg-white text-app-ink text-sm font-semibold hover:bg-app-canvas transition-colors"
                                    title="Nusxalash">
                                📋
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-2.5">
                <a href="{{ path('app_cart_index') }}" class="card p-4 flex items-center gap-3 min-h-[56px] active:opacity-90">
                    <div class="w-11 h-11 rounded-[12px] bg-app-canvas border border-app-hairline flex items-center justify-center text-xl shrink-0">🛒</div>
                    <div class="min-w-0">
                        <div class="font-semibold text-app-ink text-sm">Savatcha</div>
                        <div class="text-xs text-app-inkMuted">Buyurtma</div>
                    </div>
                </a>
                <a href="{{ path('app_order_history') }}" class="card p-4 flex items-center gap-3 min-h-[56px] active:opacity-90">
                    <div class="w-11 h-11 rounded-[12px] bg-app-canvas border border-app-hairline flex items-center justify-center text-xl shrink-0">📋</div>
                    <div class="min-w-0">
                        <div class="font-semibold text-app-ink text-sm">Buyurtmalarim</div>
                        <div class="text-xs text-app-inkMuted">Tarix</div>
                    </div>
                </a>
                <a href="{{ path('app_smart_style_index') }}" class="card p-4 flex items-center gap-3 min-h-[56px] active:opacity-90">
                    <div class="w-11 h-11 rounded-[12px] bg-app-canvas border border-app-hairline flex items-center justify-center text-xl shrink-0">✨</div>
                    <div class="min-w-0">
                        <div class="font-semibold text-app-ink text-sm">SmartStyle</div>
                        <div class="text-xs text-app-inkMuted">Tavsiyalar</div>
                    </div>
                </a>
            </div>

            <div class="card p-4 sm:p-5">
                <div class="flex items-center justify-between gap-2 mb-3">
                    <h2 class="font-display font-semibold text-base text-app-ink">Virtual hamyon</h2>
                    {% if user.hasMembership %}
                        <a href="{{ path('app_finance_index') }}" class="text-xs font-semibold text-app-accent hover:text-app-ink min-h-[44px] inline-flex items-center px-2">Moliya</a>
                    {% endif %}
                </div>

                <div class="space-y-2.5">
                    <div class="rounded-[14px] border border-app-hairline bg-app-canvas p-4">
                        <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Umumiy balans</div>
                        <div class="text-xl sm:text-2xl font-display font-semibold text-app-ink leading-tight">{{ user.generalBalance|number_format(0, '.', ' ') }} <span class="text-sm font-sans font-medium text-app-inkMuted">so'm</span></div>
                        <div class="text-xs text-app-inkMuted mt-1">Tarif to'lovlari</div>
                    </div>

                    <div class="rounded-[14px] border border-app-hairline bg-white p-4">
                        <div class="text-[10px] font-semibold uppercase tracking-widest text-app-accent mb-1">Bonus balans</div>
                        <div class="text-xl sm:text-2xl font-display font-semibold text-app-ink leading-tight">{{ balance|number_format(0, '.', ' ') }} <span class="text-sm font-sans font-medium text-app-inkMuted">so'm</span></div>
                        <div class="text-xs text-app-inkMuted mt-1">Referral</div>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="{{ path('app_finance_topup') }}" class="btn-primary w-full justify-center min-h-[48px] text-sm">
                        💳 Hamyonni to'ldirish
                    </a>
                </div>

                {% if not user.hasMembership %}
                    <div class="mt-3 rounded-[12px] bg-app-canvas border border-app-hairline p-3 text-xs text-app-inkMuted leading-relaxed">
                        Hamkorlik tarifiga a'zo bo'ling — bonus daromadlar.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<script src="{{ asset('js/profile-referral.js') }}"></script>
{% endblock %}
