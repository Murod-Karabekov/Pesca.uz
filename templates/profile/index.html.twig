{% extends 'base.html.twig' %}

{% block title %}Shaxsiy kabinet{% endblock %}

{% block body %}
<section class="py-6 md:py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-beige-200 bg-gradient-to-b from-white to-beige-50 p-5 md:p-8 mb-5 md:mb-7">
            <div class="flex items-end justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <p class="text-xs uppercase tracking-[0.16em] text-brand-muted mb-2">Shaxsiy kabinet</p>
                    <h1 class="text-2xl md:text-4xl font-display font-bold text-brand-dark leading-tight">Salom, {{ user.fullName }}!</h1>
                    <p class="text-sm text-brand-medium mt-1">Profilingiz va balansingizni shu yerda boshqarasiz.</p>
                </div>
                <div class="flex flex-col items-center gap-2 shrink-0">
                    <div class="w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-gradient-to-br from-peach-400 to-peach-600 text-white flex items-center justify-center font-bold text-xl md:text-2xl">
                        {{ user.fullName|first|upper }}
                    </div>
                    <a href="{{ path('app_logout') }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-beige-300 bg-white text-brand-medium text-xs font-medium hover:bg-beige-100 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H9m4 4v1a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2h5a2 2 0 012 2v1"/>
                        </svg>
                        Chiqish
                    </a>
                </div>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-700 rounded-full text-xs font-semibold">{{ user.currentPlanLabel }}</span>
                <span class="inline-flex items-center px-3 py-1 bg-white border border-beige-200 rounded-full text-xs text-brand-medium">A'zo bo'lgan: {{ user.createdAt|date('d.m.Y') }}</span>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-5 md:mb-7">
            <a href="{{ path('app_profile_index') }}" class="rounded-xl bg-brand-dark text-white text-xs md:text-sm font-medium px-3 py-3 text-center">Umumiy</a>
            <a href="{{ path('app_profile_edit') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-3 text-center hover:bg-beige-100 transition-colors">Tahrirlash</a>
            <a href="{{ path('app_profile_password') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-3 text-center hover:bg-beige-100 transition-colors">Parol</a>
            {% if user.hasMembership %}
                <a href="{{ path('app_finance_index') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-3 text-center hover:bg-beige-100 transition-colors">Moliya</a>
            {% else %}
                <a href="{{ path('app_hamkorlik_index') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-3 text-center hover:bg-beige-100 transition-colors">Tariflar</a>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
            <div class="space-y-4 md:space-y-6">
                <div class="card p-4 md:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-display font-semibold text-lg text-brand-dark">Shaxsiy ma'lumotlar</h2>
                        <a href="{{ path('app_profile_edit') }}" class="text-xs md:text-sm text-peach-600 hover:text-peach-700 font-medium">Tahrirlash</a>
                    </div>

                    <div class="space-y-3 text-sm">
                        <div class="rounded-xl bg-beige-50 px-3 py-2.5 flex items-center justify-between gap-2">
                            <span class="text-brand-light">To'liq ism</span>
                            <span class="text-brand-dark font-medium text-right">{{ user.fullName }}</span>
                        </div>
                        <div class="rounded-xl bg-beige-50 px-3 py-2.5 flex items-center justify-between gap-2">
                            <span class="text-brand-light">Telefon</span>
                            <span class="text-brand-dark font-medium text-right">{{ user.phone }}</span>
                        </div>
                        <div class="rounded-xl bg-beige-50 px-3 py-2.5">
                            <div class="text-brand-light mb-2">Referral havola</div>
                            <div class="flex items-center gap-2">
                                <input type="text" readonly id="referral-link"
                                       value="{{ app.request.schemeAndHttpHost }}/register/{{ user.referralCode }}"
                                       class="text-xs font-mono bg-white border border-beige-200 rounded-lg px-2.5 py-2 flex-1 min-w-0 text-brand-dark">
                                <button type="button" id="copy-btn"
                                        class="px-3 py-2 bg-peach-100 text-peach-700 rounded-lg text-xs font-semibold hover:bg-peach-200 transition-colors">
                                    📋
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <a href="{{ path('app_cart_index') }}" class="card p-4 hover:shadow-md transition-shadow flex items-center gap-3">
                        <div class="w-11 h-11 bg-peach-100 rounded-xl flex items-center justify-center text-xl">🛒</div>
                        <div>
                            <div class="font-semibold text-brand-dark text-sm">Savatcha</div>
                            <div class="text-xs text-brand-light">Buyurtmalar</div>
                        </div>
                    </a>
                    <a href="{{ path('app_order_history') }}" class="card p-4 hover:shadow-md transition-shadow flex items-center gap-3">
                        <div class="w-11 h-11 bg-blue-100 rounded-xl flex items-center justify-center text-xl">📋</div>
                        <div>
                            <div class="font-semibold text-brand-dark text-sm">Buyurtmalarim</div>
                            <div class="text-xs text-brand-light">Tarix</div>
                        </div>
                    </a>
                    <a href="{{ path('app_smart_style_index') }}" class="card p-4 hover:shadow-md transition-shadow flex items-center gap-3">
                        <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center text-xl">✨</div>
                        <div>
                            <div class="font-semibold text-brand-dark text-sm">SmartStyle</div>
                            <div class="text-xs text-brand-light">Tavsiyalar</div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="space-y-4 md:space-y-6">
                <div class="card p-4 md:p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-display font-semibold text-lg text-brand-dark">Virtual hamyon</h2>
                        {% if user.hasMembership %}
                            <a href="{{ path('app_finance_index') }}" class="text-xs md:text-sm text-peach-600 hover:text-peach-700 font-medium">Batafsil</a>
                        {% endif %}
                    </div>

                    <div class="space-y-3">
                        <div class="rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-800 p-5 text-white">
                            <div class="text-xs uppercase tracking-wider opacity-75 mb-2">Umumiy balans</div>
                            <div class="text-2xl md:text-3xl font-bold leading-none">{{ user.generalBalance|number_format(0, '.', ' ') }} <span class="text-sm md:text-base opacity-80">so'm</span></div>
                            <div class="text-xs opacity-70 mt-2">Tarif to'lovlari uchun</div>
                        </div>

                        <div class="rounded-2xl bg-gradient-to-br from-brand-dark to-gray-800 p-5 text-white">
                            <div class="text-xs uppercase tracking-wider opacity-75 mb-2">Bonus balans</div>
                            <div class="text-2xl md:text-3xl font-bold leading-none">{{ balance|number_format(0, '.', ' ') }} <span class="text-sm md:text-base opacity-80">so'm</span></div>
                            <div class="text-xs opacity-70 mt-2">Referral daromadlar</div>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-wrap items-center gap-2">
                        <a href="{{ path('app_finance_topup') }}"
                           class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 text-white rounded-xl text-sm font-medium hover:bg-emerald-700 transition-colors">
                            💳 Hamyonni to'ldirish
                        </a>
                    </div>

                    {% if not user.hasMembership %}
                        <div class="mt-4 rounded-xl bg-beige-50 p-4 text-sm text-brand-medium">
                            Hamkorlik tarifiga a'zo bo'ling va bonus daromadlarni faollashtiring.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<script src="{{ asset('js/profile-referral.js') }}"></script>
{% endblock %}
