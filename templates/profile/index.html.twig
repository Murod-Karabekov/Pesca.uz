{% extends 'base.html.twig' %}

{% block title %}Shaxsiy kabinet{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {# Header #}
    <div class="mb-8">
        <h1 class="text-3xl font-display font-bold text-brand-dark">Shaxsiy kabinet</h1>
        <p class="text-sm text-brand-medium mt-1">Xush kelibsiz, {{ user.fullName }}!</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# ─── Sidebar ─── #}
        <div class="space-y-4">
            {# User card #}
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 p-6 text-center">
                <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-peach-400 to-peach-600 rounded-full flex items-center justify-center">
                    <span class="text-3xl font-bold text-white">{{ user.fullName|first|upper }}</span>
                </div>
                <h2 class="font-display font-semibold text-lg text-brand-dark">{{ user.fullName }}</h2>
                <p class="text-sm text-brand-medium mt-1">{{ user.phone }}</p>
                <div class="mt-3">
                    <span class="inline-flex items-center gap-1 px-3 py-1 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-700 rounded-full text-xs font-semibold">
                        {{ user.currentPlanLabel }}
                    </span>
                </div>
                <p class="text-xs text-brand-light mt-3">A'zo bo'lgan: {{ user.createdAt|date('d.m.Y') }}</p>
                <a href="{{ path('app_logout') }}" class="mt-4 inline-flex items-center gap-2 px-5 py-2 bg-red-50 text-red-600 rounded-xl text-sm font-medium hover:bg-red-100 transition-colors">
                    🚪 Chiqish
                </a>
            </div>

            {# Navigation #}
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 overflow-hidden">
                <a href="{{ path('app_profile_index') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium bg-peach-50 text-peach-700 border-l-4 border-peach-500">
                    <span>👤</span> Umumiy
                </a>
                <a href="{{ path('app_profile_edit') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>✏️</span> Ma'lumotlarni tahrirlash
                </a>
                <a href="{{ path('app_profile_password') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>🔒</span> Parolni o'zgartirish
                </a>
                {% if user.hasMembership %}
                <a href="{{ path('app_finance_index') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>💰</span> Moliya bo'limi
                </a>
                {% endif %}
            </div>
        </div>

        {# ─── Main Content ─── #}
        <div class="lg:col-span-2 space-y-6">
            {# Shaxsiy ma'lumotlar #}
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 p-6">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="font-display font-semibold text-lg text-brand-dark">👤 Shaxsiy ma'lumotlar</h3>
                    <a href="{{ path('app_profile_edit') }}" class="text-sm text-peach-600 hover:text-peach-700 font-medium">Tahrirlash →</a>
                </div>
                <div class="space-y-4">
                    <div class="flex items-center justify-between py-3 border-b border-beige-100">
                        <span class="text-sm text-brand-light">To'liq ism</span>
                        <span class="text-sm font-medium text-brand-dark">{{ user.fullName }}</span>
                    </div>
                    <div class="flex items-center justify-between py-3 border-b border-beige-100">
                        <span class="text-sm text-brand-light">Telefon raqam</span>
                        <span class="text-sm font-medium text-brand-dark">{{ user.phone }}</span>
                    </div>
                    <div class="flex items-center justify-between py-3 border-b border-beige-100">
                        <span class="text-sm text-brand-light">Tarif</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-700 rounded-full text-xs font-semibold">
                            {{ user.currentPlanLabel }}
                        </span>
                    </div>
                    <div class="flex items-center justify-between py-3 border-b border-beige-100">
                        <span class="text-sm text-brand-light">Referral havola</span>
                        <div class="flex items-center gap-2">
                            <input type="text" readonly id="referral-link"
                                   value="{{ app.request.schemeAndHttpHost }}/register/{{ user.referralCode }}"
                                   class="text-xs font-mono bg-beige-50 border border-beige-200 rounded-lg px-2.5 py-1.5 w-48 sm:w-64 text-brand-dark">
                            <button onclick="copyReferral()" id="copy-btn"
                                    class="px-2.5 py-1.5 bg-peach-100 text-peach-700 rounded-lg text-xs font-medium hover:bg-peach-200 transition-colors">
                                📋
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center justify-between py-3">
                        <span class="text-sm text-brand-light">Ro'yxatdan o'tgan</span>
                        <span class="text-sm font-medium text-brand-dark">{{ user.createdAt|date('d.m.Y') }}</span>
                    </div>
                </div>
            </div>

            {# Virtual hamyon #}
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 p-6">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="font-display font-semibold text-lg text-brand-dark">💳 Virtual hamyon</h3>
                    {% if user.hasMembership %}
                        <a href="{{ path('app_finance_index') }}" class="text-sm text-peach-600 hover:text-peach-700 font-medium">Batafsil →</a>
                    {% endif %}
                </div>

                {# Umumiy balans #}
                <div class="bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-xl p-6 text-white mb-4">
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xs uppercase tracking-wider opacity-70">Umumiy balans</span>
                        <span class="text-xs opacity-70">Pesca Wallet</span>
                    </div>
                    <div class="text-3xl font-bold mb-1">{{ user.generalBalance|number_format(0, '.', ' ') }} <span class="text-lg opacity-70">so'm</span></div>
                    <div class="text-xs opacity-60 mt-4">{{ user.fullName }} • Tarif to'lovlari uchun</div>
                </div>

                {# Bonus balans #}
                <div class="bg-gradient-to-br from-brand-dark to-gray-800 rounded-xl p-6 text-white">
                    <div class="flex items-center justify-between mb-6">
                        <span class="text-xs uppercase tracking-wider opacity-70">Bonus balans</span>
                        <span class="text-xs opacity-70">Pesca Bonus</span>
                    </div>
                    <div class="text-3xl font-bold mb-1">{{ balance|number_format(0, '.', ' ') }} <span class="text-lg opacity-70">so'm</span></div>
                    <div class="text-xs opacity-60 mt-4">{{ user.fullName }} • Referral daromadlar</div>
                </div>

                {% if not user.hasMembership %}
                    <div class="mt-4 bg-beige-50 rounded-xl p-4 text-center">
                        <p class="text-sm text-brand-medium mb-2">Hamkorlik tarifiga a'zo bo'ling va bonus ishlab toping!</p>
                        <a href="{{ path('app_hamkorlik_index') }}" class="inline-flex items-center gap-1 text-sm font-medium text-peach-600 hover:text-peach-700">
                            Tariflarni ko'rish →
                        </a>
                    </div>
                {% endif %}
            </div>

            {# Tezkor havolalar #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a href="{{ path('app_cart_index') }}" class="bg-white rounded-2xl shadow-sm border border-beige-200 p-5 hover:shadow-md transition-shadow flex items-center gap-4">
                    <div class="w-12 h-12 bg-peach-100 rounded-xl flex items-center justify-center text-xl">🛒</div>
                    <div>
                        <div class="font-semibold text-brand-dark text-sm">Savatcha</div>
                        <div class="text-xs text-brand-light">Buyurtmalaringiz</div>
                    </div>
                </a>
                <a href="{{ path('app_smart_style_index') }}" class="bg-white rounded-2xl shadow-sm border border-beige-200 p-5 hover:shadow-md transition-shadow flex items-center gap-4">
                    <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center text-xl">✨</div>
                    <div>
                        <div class="font-semibold text-brand-dark text-sm">SmartStyle</div>
                        <div class="text-xs text-brand-light">Uslub tavsiyalari</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function copyReferral() {
    const input = document.getElementById('referral-link');
    navigator.clipboard.writeText(input.value).then(() => {
        const btn = document.getElementById('copy-btn');
        btn.textContent = '✅';
        setTimeout(() => btn.textContent = '📋', 2000);
    });
}
</script>
{% endblock %}
