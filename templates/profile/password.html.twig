{% extends 'base.html.twig' %}

{% block title %}Parolni o'zgartirish{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <a href="{{ path('app_profile_index') }}" class="text-sm text-brand-medium hover:text-peach-600 inline-flex items-center gap-1 mb-4">
            ← Profilga qaytish
        </a>
        <h1 class="text-3xl font-display font-bold text-brand-dark">Parolni o'zgartirish</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Sidebar #}
        <div class="space-y-4">
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 overflow-hidden">
                <a href="{{ path('app_profile_index') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>👤</span> Umumiy
                </a>
                <a href="{{ path('app_profile_edit') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>✏️</span> Ma'lumotlarni tahrirlash
                </a>
                <a href="{{ path('app_profile_password') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium bg-peach-50 text-peach-700 border-l-4 border-peach-500">
                    <span>🔒</span> Parolni o'zgartirish
                </a>
                {% if user.hasMembership %}
                <a href="{{ path('app_finance_index') }}"
                   class="flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-brand-medium hover:bg-beige-50 transition-colors border-l-4 border-transparent">
                    <span>💰</span> Moliya bo'limi
                </a>
                {% endif %}
            </div>
        </div>

        {# Form #}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-sm border border-beige-200 p-6">
                <h3 class="font-display font-semibold text-lg text-brand-dark mb-6">🔒 Parolni o'zgartirish</h3>

                <form method="post" action="{{ path('app_profile_password') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                    <div class="space-y-5">
                        <div>
                            <label for="current_password" class="block text-sm font-medium text-brand-dark mb-1.5">Joriy parol</label>
                            <input type="password" id="current_password" name="current_password"
                                   class="input-field" required
                                   placeholder="Hozirgi parolingiz">
                        </div>

                        <hr class="border-beige-200">

                        <div>
                            <label for="new_password" class="block text-sm font-medium text-brand-dark mb-1.5">Yangi parol</label>
                            <input type="password" id="new_password" name="new_password"
                                   class="input-field" required minlength="6"
                                   placeholder="Kamida 6 ta belgi">
                        </div>

                        <div>
                            <label for="confirm_password" class="block text-sm font-medium text-brand-dark mb-1.5">Yangi parolni tasdiqlash</label>
                            <input type="password" id="confirm_password" name="confirm_password"
                                   class="input-field" required minlength="6"
                                   placeholder="Yangi parolni qayta kiriting">
                        </div>
                    </div>

                    <div class="flex items-center gap-3 mt-8">
                        <button type="submit" class="btn-primary">Parolni o'zgartirish</button>
                        <a href="{{ path('app_profile_index') }}" class="btn-secondary">Bekor qilish</a>
                    </div>
                </form>

                <div class="mt-6 bg-beige-50 rounded-xl p-4 text-xs text-brand-light">
                    <p class="font-medium text-brand-dark mb-2">Parol talablari:</p>
                    <ul class="space-y-1 list-disc list-inside">
                        <li>Kamida 6 ta belgidan iborat bo'lishi kerak</li>
                        <li>Xavfsizlik uchun harf, raqam va maxsus belgilar ishlating</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
