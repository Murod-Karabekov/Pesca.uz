{% extends 'base.html.twig' %}

{% block title %}Parolni o'zgartirish{% endblock %}

{% block body %}
<section class="py-6 md:py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-5">
            <a href="{{ path('app_profile_index') }}" class="text-sm text-brand-medium hover:text-peach-600 inline-flex items-center gap-1.5 mb-3">
                ← Profilga qaytish
            </a>
            <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">Parolni o'zgartirish</h1>
        </div>

        <div class="grid grid-cols-3 gap-2 mb-5">
            <a href="{{ path('app_profile_index') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-2.5 text-center hover:bg-beige-100 transition-colors">Umumiy</a>
            <a href="{{ path('app_profile_edit') }}" class="rounded-xl bg-white border border-beige-300 text-brand-dark text-xs md:text-sm font-medium px-3 py-2.5 text-center hover:bg-beige-100 transition-colors">Tahrirlash</a>
            <a href="{{ path('app_profile_password') }}" class="rounded-xl bg-brand-dark text-white text-xs md:text-sm font-medium px-3 py-2.5 text-center">Parol</a>
        </div>

        <div class="card p-4 md:p-6">
            <h3 class="font-display font-semibold text-lg text-brand-dark mb-5">Xavfsizlik sozlamalari</h3>

            <form method="post" action="{{ path('app_profile_password') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                <div class="space-y-4">
                    <div>
                        <label for="current_password" class="block text-sm font-medium text-brand-dark mb-1.5">Joriy parol</label>
                        <input type="password" id="current_password" name="current_password"
                               class="input-field" required
                               placeholder="Hozirgi parolingiz">
                    </div>

                    <div class="h-px bg-beige-200"></div>

                    <div>
                        <label for="new_password" class="block text-sm font-medium text-brand-dark mb-1.5">Yangi parol</label>
                        <input type="password" id="new_password" name="new_password"
                               class="input-field" required minlength="6"
                               placeholder="Kamida 6 ta belgi">
                    </div>

                    <div>
                        <label for="confirm_password" class="block text-sm font-medium text-brand-dark mb-1.5">Yangi parolni tasdiqlash</label>
                        <input type="password" id="confirm_password" name="confirm_password"
                               class="input-field" required minlength="6"
                               placeholder="Yangi parolni qayta kiriting">
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mt-7">
                    <button type="submit" class="btn-primary">Parolni o'zgartirish</button>
                    <a href="{{ path('app_profile_index') }}" class="btn-secondary">Bekor qilish</a>
                </div>
            </form>

            <div class="mt-5 bg-beige-50 rounded-xl p-4 text-xs text-brand-light">
                <p class="font-medium text-brand-dark mb-2">Parol talablari:</p>
                <ul class="space-y-1 list-disc list-inside">
                    <li>Kamida 6 ta belgidan iborat bo'lishi kerak</li>
                    <li>Xavfsizlik uchun harf, raqam va maxsus belgilar ishlating</li>
                </ul>
            </div>
        </div>
    </div>
</section>
{% endblock %}
