{% extends 'base.html.twig' %}

{% block title %}Parolni o'zgartirish{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="mb-4">
            <a href="{{ path('app_profile_index') }}" class="text-sm text-app-inkMuted hover:text-app-ink inline-flex items-center gap-1.5 min-h-[44px] py-1">
                ← Profilga
            </a>
            <h1 class="text-xl sm:text-2xl font-display font-medium text-app-ink mt-1 tracking-tight">Parolni o'zgartirish</h1>
        </div>

        <nav class="app-pill-nav-3 mb-4" aria-label="Profil bo'limlari">
            <a href="{{ path('app_profile_index') }}" class="bg-white text-app-ink border border-app-hairline hover:bg-app-canvas">Umumiy</a>
            <a href="{{ path('app_profile_edit') }}" class="bg-white text-app-ink border border-app-hairline hover:bg-app-canvas">Tahrirlash</a>
            <a href="{{ path('app_profile_password') }}" class="bg-app-ink text-app-canvas border border-app-ink">Parol</a>
        </nav>

        <div class="card p-4 sm:p-5">
            <h3 class="font-display font-semibold text-base text-app-ink mb-4">Xavfsizlik</h3>

            <form method="post" action="{{ path('app_profile_password') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                <div class="space-y-4">
                    <div>
                        <label for="current_password" class="block text-sm font-medium text-app-ink mb-1.5">Joriy parol</label>
                        <input type="password" id="current_password" name="current_password"
                               class="input-field min-h-[48px]" required
                               placeholder="Hozirgi parol"
                               autocomplete="current-password">
                    </div>

                    <div class="h-px bg-app-hairline"></div>

                    <div>
                        <label for="new_password" class="block text-sm font-medium text-app-ink mb-1.5">Yangi parol</label>
                        <input type="password" id="new_password" name="new_password"
                               class="input-field min-h-[48px]" required minlength="6"
                               placeholder="Kamida 6 belgi"
                               autocomplete="new-password">
                    </div>

                    <div>
                        <label for="confirm_password" class="block text-sm font-medium text-app-ink mb-1.5">Tasdiqlash</label>
                        <input type="password" id="confirm_password" name="confirm_password"
                               class="input-field min-h-[48px]" required minlength="6"
                               placeholder="Yana bir marta"
                               autocomplete="new-password">
                    </div>
                </div>

                <div class="flex flex-col gap-2.5 mt-6">
                    <button type="submit" class="btn-primary w-full justify-center min-h-[48px]">O'zgartirish</button>
                    <a href="{{ path('app_profile_index') }}" class="btn-secondary w-full justify-center min-h-[48px]">Bekor</a>
                </div>
            </form>

            <div class="mt-4 rounded-[12px] bg-app-canvas border border-app-hairline p-3 text-xs text-app-inkMuted leading-relaxed">
                <p class="font-semibold text-app-ink mb-1.5">Talablar</p>
                <ul class="space-y-1 list-disc list-inside">
                    <li>Kamida 6 belgi</li>
                    <li>Harflar va raqamlar aralashmasi tavsiya etiladi</li>
                </ul>
            </div>
        </div>
    </div>
</section>
{% endblock %}
