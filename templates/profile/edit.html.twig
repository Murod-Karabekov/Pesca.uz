{% extends 'base.html.twig' %}

{% block title %}Ma'lumotlarni tahrirlash{% endblock %}

{% block body %}
<section class="min-h-[60vh] bg-app-canvas border-b border-app-hairline">
    <div class="app-sheet">
        <div class="mb-4">
            <a href="{{ path('app_profile_index') }}" class="text-sm text-app-inkMuted hover:text-app-ink inline-flex items-center gap-1.5 min-h-[44px] py-1">
                ← Profilga
            </a>
            <h1 class="text-xl sm:text-2xl font-display font-medium text-app-ink mt-1 tracking-tight">Ma'lumotlarni tahrirlash</h1>
        </div>

        <nav class="app-pill-nav-3 mb-4" aria-label="Profil bo'limlari">
            <a href="{{ path('app_profile_index') }}" class="bg-white text-app-ink border border-app-hairline hover:bg-app-canvas">Umumiy</a>
            <a href="{{ path('app_profile_edit') }}" class="bg-app-ink text-app-canvas border border-app-ink">Tahrirlash</a>
            <a href="{{ path('app_profile_password') }}" class="bg-white text-app-ink border border-app-hairline hover:bg-app-canvas">Parol</a>
        </nav>

        <div class="card p-4 sm:p-5">
            <h3 class="font-display font-semibold text-base text-app-ink mb-4">Shaxsiy ma'lumotlar</h3>

            <form method="post" action="{{ path('app_profile_edit') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('profile_edit') }}">

                <div class="space-y-4">
                    <div>
                        <label for="full_name" class="block text-sm font-medium text-app-ink mb-1.5">To'liq ism</label>
                        <input type="text" id="full_name" name="full_name"
                               value="{{ user.fullName }}"
                               class="input-field min-h-[48px]" required
                               placeholder="Ismingiz va familiyangiz"
                               autocomplete="name">
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-medium text-app-ink mb-1.5">Telefon</label>
                        <input type="tel" id="phone" name="phone"
                               value="{{ user.phone }}"
                               class="input-field min-h-[48px]" required
                               placeholder="+998901234567"
                               pattern="\+998\d{9}"
                               inputmode="tel"
                               autocomplete="tel">
                        <p class="text-xs text-app-inkMuted mt-1.5">+998XXXXXXXXX</p>
                    </div>
                </div>

                <div class="flex flex-col gap-2.5 mt-6">
                    <button type="submit" class="btn-primary w-full justify-center min-h-[48px]">Saqlash</button>
                    <a href="{{ path('app_profile_index') }}" class="btn-secondary w-full justify-center min-h-[48px]">Bekor</a>
                </div>
            </form>
        </div>
    </div>
</section>
{% endblock %}
