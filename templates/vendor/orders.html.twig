{% extends 'vendor/base.html.twig' %}

{% block title %}Buyurtmalar{% endblock %}

{% block main %}
<div class="max-w-7xl mx-auto">
    <div class="mb-8 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Buyurtmalar</h1>
            <p class="text-gray-500 mt-1">Qatorni bossangiz mahsulotlar ro'yxati ochiladi.</p>
        </div>
        <a
            href="{{ path('vendor_orders_history') }}"
            class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-gray-300 text-gray-600 hover:text-amber-700 hover:border-amber-300 hover:bg-amber-50 transition-colors"
            title="Yetkazib berilganlar tarixi"
            aria-label="Yetkazib berilganlar tarixi"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-2.64-6.36M21 3v6h-6"/>
            </svg>
        </a>
    </div>

    <div class="bg-white rounded-2xl border p-4 md:p-5 mb-6 flex items-center justify-between">
        <span class="text-sm text-gray-500">Aktiv buyurtmalar soni</span>
        <span class="text-xl font-bold text-gray-800">{{ activeOrders|length }}</span>
    </div>

    {% if activeOrders|length > 0 %}
        <div class="bg-white rounded-2xl border overflow-hidden mb-10">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mijoz</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mahsulot</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Jami</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Sana</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for card in activeOrders %}
                            {% set order = card.order %}
                            {% set firstItem = card.items|first %}
                            <tr class="vendor-order-row hover:bg-gray-50/70 transition-colors cursor-pointer" data-order-id="{{ order.id }}">
                                <td class="px-5 py-4 text-sm font-semibold text-gray-800">#{{ order.id }}</td>
                                <td class="px-5 py-4 text-sm text-gray-600">
                                    <div class="font-medium text-gray-800">{{ order.customerFullName }}</div>
                                    <div class="text-xs text-gray-500">{{ order.customerPhone }}</div>
                                </td>
                                <td class="px-5 py-4 text-sm text-gray-600">
                                    {% if firstItem %}
                                        <div class="font-medium text-gray-800">{{ firstItem.productNameSnapshot }}</div>
                                        <div class="text-xs text-gray-500">+{{ card.items|length - 1 }} ta qo'shimcha</div>
                                    {% endif %}
                                </td>
                                <td class="px-5 py-4 text-sm font-semibold text-gray-800">{{ card.total|number_format(0, '.', ' ') }} so'm</td>
                                <td class="px-5 py-4 text-sm text-gray-600">{{ order.createdAt|date('d.m.Y H:i') }}</td>
                                <td class="px-5 py-4">
                                    <div class="order-actions flex items-center justify-end gap-2">
                                            <form action="{{ path('vendor_order_confirm', {orderId: order.id}) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vendor_confirm_' ~ order.id) }}">
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 justify-center px-3.5 py-2 rounded-lg border border-emerald-300 text-emerald-700 bg-emerald-50 hover:bg-emerald-100 transition-colors text-xs font-semibold whitespace-nowrap">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Tayyor - yetkazdim
                                            </button>
                                        </form>

                                                                                <form action="{{ path('vendor_order_cancel', {orderId: order.id}) }}" method="POST" class="vendor-cancel-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vendor_cancel_' ~ order.id) }}">
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 justify-center px-3.5 py-2 rounded-lg border border-red-300 text-red-700 bg-red-50 hover:bg-red-100 transition-colors text-xs font-semibold whitespace-nowrap">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                </svg>
                                                Bekor qilish
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <tr class="vendor-order-details-row hidden bg-gray-50/60" data-order-details-id="{{ order.id }}">
                                <td colspan="6" class="px-5 py-5">
                                    <div class="rounded-2xl border bg-white p-4 md:p-5">
                                        <div class="flex items-center justify-between gap-3 mb-4">
                                            <h4 class="font-semibold text-gray-800">Buyurtma tarkibi</h4>
                                            <span class="text-xs text-gray-500">#{{ order.id }}</span>
                                        </div>

                                        <div class="space-y-3">
                                            {% for item in card.items %}
                                                <div class="border rounded-xl p-3 flex flex-col md:flex-row md:items-center gap-3">
                                                    <div class="w-16 h-16 rounded-lg overflow-hidden bg-gray-100 flex-shrink-0">
                                                        {% if item.productImageSnapshot %}
                                                            <img src="{{ item.productImageSnapshot }}" alt="{{ item.productNameSnapshot }}" class="w-full h-full object-cover">
                                                        {% else %}
                                                            <div class="w-full h-full flex items-center justify-center text-[10px] text-gray-400">Rasm yo'q</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-semibold text-gray-800">{{ item.productNameSnapshot }}</p>
                                                        <p class="text-xs text-gray-600">
                                                            {{ item.unitPrice|number_format(0, '.', ' ') }} so'm x {{ item.quantity }} dona
                                                            {% if item.selectedSize %} | O'lcham: {{ item.selectedSize }}{% endif %}
                                                        </p>
                                                    </div>
                                                    <div class="text-sm font-semibold text-gray-800">{{ item.lineTotal|number_format(0, '.', ' ') }} so'm</div>
                                                </div>
                                            {% endfor %}
                                        </div>

                                        {% if order.notes %}
                                            <div class="mt-4 p-3 rounded-xl bg-gray-50 border">
                                                <p class="text-xs uppercase tracking-wider text-gray-500 mb-1">Mijoz izohi</p>
                                                <p class="text-sm text-gray-700">{{ order.notes }}</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="bg-white rounded-2xl border p-12 text-center mb-10">
            <p class="text-gray-500">Aktiv buyurtmalar topilmadi.</p>
        </div>
    {% endif %}
</div>

<div id="cancel-modal" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/40" data-cancel-modal-close></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="w-full max-w-sm rounded-2xl bg-white border border-gray-200 shadow-2xl p-5 sm:p-6">
            <h3 class="text-base sm:text-lg font-semibold text-gray-800">Buyurtmani bekor qilasizmi?</h3>
            <p class="text-sm text-gray-500 mt-2">Bu amal qaytarib bo'lmaydi. Davom etishni xohlaysizmi?</p>
            <div class="mt-5 grid grid-cols-2 gap-2.5">
                <button type="button" id="cancel-modal-no" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-gray-300 text-gray-700 bg-white hover:bg-gray-50 text-sm font-semibold">
                    Yo'q
                </button>
                <button type="button" id="cancel-modal-yes" class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg border border-red-300 text-red-700 bg-red-50 hover:bg-red-100 text-sm font-semibold">
                    Ha, bekor qil
                </button>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/vendor-orders.js') }}"></script>
{% endblock %}
