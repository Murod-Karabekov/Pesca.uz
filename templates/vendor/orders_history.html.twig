{% extends 'vendor/base.html.twig' %}

{% block title %}Yetkazib Berilganlar Tarixi{% endblock %}

{% block main %}
<div class="max-w-7xl mx-auto">
    <div class="mb-8 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Yetkazib berilganlar tarixi</h1>
            <p class="text-gray-500 mt-1">Tasdiqlangan buyurtmalar arxivi.</p>
        </div>
        <a
            href="{{ path('vendor_orders') }}"
            class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-gray-300 text-gray-600 hover:text-amber-700 hover:border-amber-300 hover:bg-amber-50 transition-colors"
            title="Aktiv buyurtmalar"
            aria-label="Aktiv buyurtmalar"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </a>
    </div>

    {% if historyOrders|length > 0 %}
        <div class="bg-white rounded-2xl border overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mijoz</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Jami</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tasdiqlangan</th>
                            <th class="px-5 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Holat</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for card in historyOrders %}
                            {% set order = card.order %}
                            {% set tx = card.tx %}
                            {% set isApproved = order.paymentStatus == 'approved' %}
                            <tr class="vendor-history-row hover:bg-gray-50/70 transition-colors cursor-pointer" data-history-id="{{ order.id }}">
                                <td class="px-5 py-4 text-sm font-semibold text-gray-800">#{{ order.id }}</td>
                                <td class="px-5 py-4 text-sm text-gray-600">
                                    <div class="font-medium text-gray-800">{{ order.customerFullName }}</div>
                                    <div class="text-xs text-gray-500">{{ order.customerPhone }}</div>
                                </td>
                                <td class="px-5 py-4 text-sm font-semibold text-gray-800">{{ (tx ? tx.saleAmount : card.total)|number_format(0, '.', ' ') }} so'm</td>
                                <td class="px-5 py-4 text-sm text-gray-600">{{ order.approvedAt ? order.approvedAt|date('d.m.Y H:i') : order.createdAt|date('d.m.Y H:i') }}</td>
                                <td class="px-5 py-4">
                                    {% if isApproved %}
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">Tasdiqlangan</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">Rad etilgan</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr class="vendor-history-details-row hidden bg-gray-50/60" data-history-details-id="{{ order.id }}">
                                <td colspan="5" class="px-5 py-5">
                                    <div class="rounded-2xl border bg-white p-4 md:p-5">
                                        <div class="space-y-3">
                                            {% for item in card.items %}
                                                <div class="border rounded-xl p-3 flex flex-col md:flex-row md:items-center gap-3">
                                                    <div class="w-14 h-14 rounded-lg overflow-hidden bg-gray-100 flex-shrink-0">
                                                        {% if item.productImageSnapshot %}
                                                            <img src="{{ item.productImageSnapshot }}" alt="{{ item.productNameSnapshot }}" class="w-full h-full object-cover">
                                                        {% else %}
                                                            <div class="w-full h-full flex items-center justify-center text-[10px] text-gray-400">Rasm yo'q</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-semibold text-gray-800">{{ item.productNameSnapshot }}</p>
                                                        <p class="text-xs text-gray-600">{{ item.quantity }} dona{% if item.selectedSize %} | O'lcham: {{ item.selectedSize }}{% endif %}</p>
                                                    </div>
                                                    <div class="text-sm font-semibold text-gray-800">{{ item.lineTotal|number_format(0, '.', ' ') }} so'm</div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="bg-white rounded-2xl border p-10 text-center">
            <p class="text-gray-500">Tarix bo'sh.</p>
        </div>
    {% endif %}
</div>

<script src="{{ asset('js/vendor-orders-history.js') }}"></script>
{% endblock %}
