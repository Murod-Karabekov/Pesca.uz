{% extends 'vendor/base.html.twig' %}

{% block title %}Yetkazib Berilganlar Tarixi{% endblock %}

{% block main %}
<div class="w-full min-w-0">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-xl sm:text-2xl md:text-3xl font-display font-semibold text-app-ink app-prose-tight">Yetkazib berilganlar tarixi</h1>
            <p class="text-sm text-app-inkMuted mt-1 app-prose-tight">Tasdiqlangan buyurtmalar arxivi.</p>
        </div>
        <a
            href="{{ path('vendor_orders') }}"
            class="inline-flex items-center justify-center min-w-[48px] min-h-[48px] shrink-0 rounded-[14px] border border-app-hairline bg-white text-app-inkMuted hover:text-app-ink hover:bg-app-canvas transition-colors self-start"
            title="Aktiv buyurtmalar"
            aria-label="Aktiv buyurtmalar"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
        </a>
    </div>

    {% if historyOrders|length > 0 %}
        <div class="card overflow-hidden min-w-0">
            <div class="app-table-scroll">
                <table class="w-full min-w-[640px]">
                    <thead class="bg-app-canvas border-b border-app-hairline">
                        <tr>
                            <th class="px-3 sm:px-5 py-3 text-left text-[10px] sm:text-xs font-semibold text-app-inkMuted uppercase tracking-wider whitespace-nowrap">Order</th>
                            <th class="px-3 sm:px-5 py-3 text-left text-[10px] sm:text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Mijoz</th>
                            <th class="px-3 sm:px-5 py-3 text-left text-[10px] sm:text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Jami</th>
                            <th class="px-3 sm:px-5 py-3 text-left text-[10px] sm:text-xs font-semibold text-app-inkMuted uppercase tracking-wider whitespace-nowrap">Tasdiqlangan</th>
                            <th class="px-3 sm:px-5 py-3 text-left text-[10px] sm:text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Holat</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-app-hairline">
                        {% for card in historyOrders %}
                            {% set order = card.order %}
                            {% set tx = card.tx %}
                            {% set isApproved = order.paymentStatus == 'approved' %}
                            <tr class="vendor-history-row hover:bg-app-canvas/60 transition-colors cursor-pointer" data-history-id="{{ order.id }}">
                                <td class="px-3 sm:px-5 py-3 text-xs sm:text-sm font-semibold text-app-ink whitespace-nowrap">#{{ order.id }}</td>
                                <td class="px-3 sm:px-5 py-3 text-xs sm:text-sm text-app-inkMuted max-w-[14rem]">
                                    <div class="font-medium text-app-ink app-prose-tight">{{ order.customerFullName }}</div>
                                    <div class="text-[11px] text-app-inkMuted break-all">{{ order.customerPhone }}</div>
                                </td>
                                <td class="px-3 sm:px-5 py-3 text-xs sm:text-sm font-semibold text-app-ink app-money whitespace-nowrap">{{ (tx ? tx.saleAmount : card.total)|number_format(0, '.', ' ') }} so'm</td>
                                <td class="px-3 sm:px-5 py-3 text-xs sm:text-sm text-app-inkMuted whitespace-nowrap">{{ order.approvedAt ? order.approvedAt|date('d.m.Y H:i') : order.createdAt|date('d.m.Y H:i') }}</td>
                                <td class="px-3 sm:px-5 py-3">
                                    {% if isApproved %}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium bg-green-100 text-green-800">Tasdiqlangan</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium bg-red-100 text-red-800">Rad etilgan</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr class="vendor-history-details-row hidden bg-app-canvas/70" data-history-details-id="{{ order.id }}">
                                <td colspan="5" class="px-3 sm:px-5 py-4 sm:py-5">
                                    <div class="rounded-[16px] border border-app-hairline bg-white p-3 sm:p-5 min-w-0">
                                        <div class="space-y-3">
                                            {% for item in card.items %}
                                                <div class="border border-app-hairline rounded-[14px] p-3 flex flex-col md:flex-row md:items-center gap-3 min-w-0">
                                                    <div class="w-14 h-14 rounded-lg overflow-hidden bg-app-canvas shrink-0 border border-app-hairline">
                                                        {% if item.productImageSnapshot %}
                                                            <img src="{{ item.productImageSnapshot }}" alt="" class="w-full h-full object-cover">
                                                        {% else %}
                                                            <div class="w-full h-full flex items-center justify-center text-[10px] text-app-inkMuted">Rasm yo'q</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="flex-1 min-w-0">
                                                        <p class="text-sm font-semibold text-app-ink app-prose-tight">{{ item.productNameSnapshot }}</p>
                                                        <p class="text-xs text-app-inkMuted app-prose-tight">{{ item.quantity }} dona{% if item.selectedSize %} | O'lcham: {{ item.selectedSize }}{% endif %}</p>
                                                    </div>
                                                    <div class="text-sm font-semibold text-app-ink app-money shrink-0 md:text-right">{{ item.lineTotal|number_format(0, '.', ' ') }} so'm</div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="card p-10 text-center">
            <p class="text-app-inkMuted">Tarix bo'sh.</p>
        </div>
    {% endif %}
</div>

<script src="{{ asset('js/vendor-orders-history.js') }}"></script>
{% endblock %}
