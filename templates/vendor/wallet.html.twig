{% extends 'vendor/base.html.twig' %}

{% block title %}Virtual Kassa{% endblock %}

{% block main %}
<div class="max-w-5xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Virtual Kassa</h1>

    {# ─── Jami ko'rsatkichlar ─── #}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-2xl border shadow-sm p-5">
            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Jami savdo summasi</p>
            <p class="text-3xl font-bold text-gray-800">{{ vendor.totalEarnings|number_format(0, '.', ' ') }}</p>
            <p class="text-sm text-gray-400">so'm (barcha vaqt)</p>
        </div>

        <div class="bg-orange-50 rounded-2xl border border-orange-200 p-5">
            <p class="text-xs text-orange-600 uppercase tracking-wide mb-1">Platforma ulushi (to'lanmagan)</p>
            <p class="text-3xl font-bold text-orange-700">{{ unsettled|number_format(0, '.', ' ') }}</p>
            <p class="text-sm text-orange-500">so'm (admin undirishi kerak)</p>
        </div>

        <div class="bg-green-50 rounded-2xl border border-green-200 p-5">
            <p class="text-xs text-green-600 uppercase tracking-wide mb-1">Sizning qo'lingizdagi</p>
            <p class="text-3xl font-bold text-green-700">
                {{ (vendor.totalEarnings - unsettled)|number_format(0, '.', ' ') }}
            </p>
            <p class="text-sm text-green-500">so'm (taxminiy)</p>
        </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-sm text-yellow-800 mb-6">
        <strong>Qanday ishlaydi?</strong>
        Har safar "Tayyor — yetkazib berdim" bossangiz, kiritgan summa kassaga yoziladi.
        Oyning oxirida admin platforma ulushini sizdan to'ldirishingizni so'raydi.
    </div>

    {# ─── Tranzaksiyalar tarixi ─── #}
    {% if transactions is empty %}
        <div class="bg-white rounded-2xl border p-12 text-center text-gray-400">
            <p class="text-4xl mb-3">📋</p>
            <p>Hali tranzaksiya yo'q</p>
        </div>
    {% else %}
        <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b">
                <h2 class="font-semibold text-gray-800">Tranzaksiyalar tarixi</h2>
            </div>
            <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                <tr class="bg-gray-50 text-gray-500 text-xs uppercase border-b">
                    <th class="text-left px-6 py-3">Zakaz</th>
                    <th class="text-right px-4 py-3">Savdo summasi</th>
                    <th class="text-right px-4 py-3">Platforma ulushi</th>
                    <th class="text-right px-4 py-3">Sizda qoldi</th>
                    <th class="text-center px-4 py-3">Holati</th>
                    <th class="text-right px-6 py-3">Sana</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for tx in transactions %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-3 font-medium">#{{ tx.order.id }}</td>
                    <td class="px-4 py-3 text-right font-semibold text-gray-800">
                        {{ tx.saleAmount|number_format(0, '.', ' ') }} so'm
                    </td>
                    <td class="px-4 py-3 text-right text-orange-600">
                        {{ tx.commissionAmount|number_format(0, '.', ' ') }} so'm
                        <span class="text-xs text-gray-400">({{ tx.commissionRate }}%)</span>
                    </td>
                    <td class="px-4 py-3 text-right font-semibold text-green-700">
                        {{ tx.vendorAmount|number_format(0, '.', ' ') }} so'm
                    </td>
                    <td class="px-4 py-3 text-center">
                        {% if tx.status == 'settled' %}
                            <span class="inline-flex px-2 py-1 rounded-full text-xs bg-gray-100 text-gray-600">Yopildi</span>
                        {% else %}
                            <span class="inline-flex px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">Faol</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-3 text-right text-gray-400 text-xs">
                        {{ tx.createdAt|date('d.m.Y H:i') }}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
