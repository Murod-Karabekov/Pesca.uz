{% extends 'vendor/base.html.twig' %}

{% block title %}Mahsulotlar{% endblock %}

{% block main %}
<div class="w-full min-w-0">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-5">
        <h1 class="text-xl sm:text-2xl font-display font-semibold text-app-ink app-prose-tight">Mening mahsulotlarim</h1>
        <a href="{{ path('vendor_product_new') }}"
           class="btn-primary shrink-0 justify-center min-h-[48px] px-5 text-sm w-full sm:w-auto">
            + Yangi mahsulot
        </a>
    </div>

    {% if products is empty %}
        <div class="card p-10 sm:p-12 text-center text-app-inkMuted">
            <p class="text-4xl mb-3">👗</p>
            <p class="font-medium mb-4 text-app-ink">Hali mahsulot yo'q</p>
            <a href="{{ path('vendor_product_new') }}" class="btn-primary inline-flex justify-center min-h-[48px] px-6 text-sm">
                Birinchi mahsulotni qo'shish
            </a>
        </div>
    {% else %}
        <div class="card overflow-hidden min-w-0">
            <div class="app-table-scroll">
            <table class="w-full text-xs sm:text-sm min-w-[520px]">
                <thead>
                <tr class="bg-app-canvas text-app-inkMuted text-[10px] sm:text-xs uppercase border-b border-app-hairline">
                    <th class="text-left px-3 sm:px-6 py-3">Mahsulot</th>
                    <th class="text-right px-2 sm:px-4 py-3">Narxi</th>
                    <th class="text-center px-2 py-3">Holati</th>
                    <th class="text-right px-3 sm:px-6 py-3">Sana</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-app-hairline">
                {% for product in products %}
                <tr class="hover:bg-app-canvas/50">
                    <td class="px-3 sm:px-6 py-3 max-w-[55vw] sm:max-w-none">
                        <div class="flex items-start gap-2 sm:gap-3 min-w-0">
                            {% if product.image %}
                                <img src="{{ product.imageSrc }}" alt=""
                                     class="w-10 h-10 object-cover rounded-lg border shrink-0 mt-0.5"
                                     onerror="this.style.display='none'">
                            {% else %}
                                <div class="w-10 h-10 bg-app-canvas rounded-lg flex items-center justify-center shrink-0 text-lg border border-app-hairline">👕</div>
                            {% endif %}
                            <div class="min-w-0 flex-1">
                                <p class="font-medium text-app-ink app-prose-tight leading-snug">{{ product.name }}</p>
                                {% if product.category %}
                                    <p class="text-[11px] text-app-inkMuted mt-0.5 app-prose-tight">{{ product.category.name }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="px-2 sm:px-4 py-3 text-right font-semibold text-app-ink app-money text-[11px] sm:text-sm align-top">
                        {{ product.price|number_format(0, '.', ' ') }} so'm
                    </td>
                    <td class="px-2 py-3 text-center align-top">
                        {% if product.publishStatus == 'published' %}
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium bg-green-100 text-green-800">
                                ✓ Saytda
                            </span>
                        {% elseif product.publishStatus == 'pending' %}
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium bg-amber-100 text-amber-900">
                                ⏳ Kutilmoqda
                            </span>
                        {% else %}
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] sm:text-xs font-medium bg-red-100 text-red-800">
                                ✕ Rad etildi
                            </span>
                        {% endif %}
                    </td>
                    <td class="px-3 sm:px-6 py-3 text-right text-app-inkMuted text-[10px] sm:text-xs whitespace-nowrap align-top">
                        {{ product.createdAt|date('d.m.Y') }}
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </div>

        <p class="text-[11px] sm:text-xs text-app-inkMuted mt-3 text-center app-prose-tight px-1">
            Kutilmoqda — admin SmartStyle sozlamalarini to'ldirib tasdiqlaydi, so'ng saytda ko'rinadi.
        </p>
    {% endif %}
</div>
{% endblock %}
