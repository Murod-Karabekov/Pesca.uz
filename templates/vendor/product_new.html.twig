{% extends 'vendor/base.html.twig' %}

{% block title %}Yangi mahsulot{% endblock %}

{% block main %}
<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="{{ path('vendor_products') }}" class="text-gray-400 hover:text-gray-600">
            ← Orqaga
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Yangi mahsulot qo'shish</h1>
    </div>

    <div class="bg-white rounded-2xl border shadow-sm p-6">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6 text-sm text-blue-800">
            <strong>Eslatma:</strong> Mahsulot yuborilgandan keyin admin tekshiradi. SmartStyle sozlamalarini admin to'ldiradi.
            Tasdiqlangandan so'ng saytda ko'rinadi.
        </div>

        <form action="{{ path('vendor_product_new') }}" method="POST" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('vendor_product_new') }}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Mahsulot nomi *</label>
                <input type="text" name="name" required maxlength="255"
                       placeholder="Masalan: Qora ko'ylak"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Narxi (so'm) *</label>
                <input type="number" name="price" required min="1"
                       placeholder="Masalan: 350000"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Tavsif</label>
                <textarea name="description" rows="3" maxlength="2000"
                          placeholder="Mahsulot haqida qisqacha ma'lumot..."
                          class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none"></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">O'lchamlar</label>
                <div class="flex flex-wrap gap-2">
                    {% for size in sizes %}
                        <label class="flex items-center gap-2 border rounded-lg px-3 py-2 cursor-pointer hover:bg-gray-50 text-sm">
                            <input type="checkbox" name="sizes[]" value="{{ size }}" class="rounded">
                            {{ size }}
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Kategoriya</label>
                <select name="category"
                        class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white">
                    <option value="">— Tanlang —</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}">{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Rasm linki (URL)</label>
                <input type="url" name="image"
                       placeholder="https://example.com/rasm.jpg"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none">
                <p class="text-xs text-gray-400 mt-1">Rasm URL'ini kiriting. Admindan so'rash ham mumkin.</p>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold text-sm transition-colors">
                    Yuborish (admin tekshiruvi uchun)
                </button>
                <a href="{{ path('vendor_products') }}"
                   class="px-5 py-3 border rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    Bekor qilish
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
