<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F7F5F2">
    <title>{% block title %}Do'konchi paneli{% endblock %} — Pesca</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-screen bg-app-canvas text-app-ink antialiased pb-[env(safe-area-inset-bottom,0px)]">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div data-flash class="fixed top-4 right-4 z-50 max-w-[min(100vw-2rem,24rem)] px-5 py-4 rounded-[14px] shadow-sm text-sm font-medium border border-app-hairline app-prose-tight
                {% if label == 'success' %} bg-white text-green-800
                {% elseif label == 'error' %} bg-white text-red-800
                {% elseif label == 'warning' %} bg-white text-amber-900
                {% else %} bg-white text-app-ink {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="flex min-h-screen min-w-0">
        <aside class="hidden lg:flex lg:flex-col w-60 shrink-0 bg-app-ink text-app-canvas sticky top-0 h-screen overflow-y-auto border-r border-white/10">
            <div class="p-5 border-b border-white/10">
                <a href="{{ path('vendor_dashboard') }}" class="flex items-center gap-2 min-w-0">
                    <span class="text-lg font-display font-semibold truncate">🏪 Do'konchi</span>
                </a>
                {% if vendor is defined %}
                    <p class="text-xs text-white/60 mt-1 app-prose-tight">{{ vendor.name }}</p>
                {% endif %}
            </div>

            <nav class="flex-1 p-3 space-y-1">
                <a href="{{ path('vendor_dashboard') }}"
                   class="flex items-center gap-3 min-h-[44px] px-3 rounded-[12px] text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') == 'vendor_dashboard' ? 'bg-white/15 text-app-canvas' : 'text-white/65 hover:bg-white/10 hover:text-app-canvas' }}">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Bosh sahifa
                </a>

                <a href="{{ path('vendor_orders') }}"
                   class="flex items-center gap-3 min-h-[44px] px-3 rounded-[12px] text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') starts with 'vendor_order' ? 'bg-white/15 text-app-canvas' : 'text-white/65 hover:bg-white/10 hover:text-app-canvas' }}">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Buyurtmalar
                </a>

                <a href="{{ path('vendor_products') }}"
                   class="flex items-center gap-3 min-h-[44px] px-3 rounded-[12px] text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') starts with 'vendor_product' ? 'bg-white/15 text-app-canvas' : 'text-white/65 hover:bg-white/10 hover:text-app-canvas' }}">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                    </svg>
                    Mahsulotlar
                </a>

                <a href="{{ path('vendor_wallet') }}"
                   class="flex items-center gap-3 min-h-[44px] px-3 rounded-[12px] text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') == 'vendor_wallet' ? 'bg-white/15 text-app-canvas' : 'text-white/65 hover:bg-white/10 hover:text-app-canvas' }}">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                    Virtual kassa
                </a>
            </nav>

            <div class="p-3 border-t border-white/10">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 min-h-[44px] px-3 rounded-[12px] text-sm text-white/65 hover:bg-white/10 hover:text-app-canvas transition-colors">
                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Chiqish
                </a>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            <header class="lg:hidden sticky top-0 z-30 bg-app-canvas/95 backdrop-blur border-b border-app-hairline px-3 py-2 flex items-center justify-between gap-2 min-w-0">
                <button type="button" class="min-w-[48px] min-h-[48px] inline-flex items-center justify-center rounded-[14px] border border-app-hairline bg-white text-app-ink shrink-0" data-mobile-sidebar-open="vendor-mobile-sidebar" aria-label="Menyuni ochish">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <span class="font-display font-semibold text-app-ink text-sm truncate min-w-0 text-center flex-1 px-1">🏪 Do'konchi</span>
                <a href="{{ path('app_logout') }}" class="text-xs font-semibold text-red-600 shrink-0 min-h-[44px] inline-flex items-center px-2">Chiqish</a>
            </header>

            <div id="vendor-mobile-sidebar" class="lg:hidden fixed inset-0 z-50 hidden" data-mobile-sidebar>
                <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200" data-mobile-sidebar-backdrop></div>
                <aside class="absolute left-0 top-0 h-full w-[min(20rem,88vw)] bg-app-ink text-app-canvas transform -translate-x-full transition-transform duration-200 shadow-xl" data-mobile-sidebar-drawer>
                    <div class="p-4 border-b border-white/10 flex items-center justify-between gap-2">
                        <span class="text-base font-semibold">Menyu</span>
                        <button type="button" class="min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-[12px] border border-white/25" data-mobile-sidebar-close="vendor-mobile-sidebar" aria-label="Yopish">✕</button>
                    </div>
                    <nav class="p-3 space-y-1 text-sm overflow-y-auto max-h-[calc(100vh-5rem)]">
                        <a href="{{ path('vendor_dashboard') }}" class="block min-h-[44px] flex items-center px-3 rounded-[12px] {{ app.request.attributes.get('_route') == 'vendor_dashboard' ? 'bg-white/15 text-app-canvas' : 'text-white/70' }}">Bosh sahifa</a>
                        <a href="{{ path('vendor_orders') }}" class="block min-h-[44px] flex items-center px-3 rounded-[12px] {{ app.request.attributes.get('_route') starts with 'vendor_order' ? 'bg-white/15 text-app-canvas' : 'text-white/70' }}">Buyurtmalar</a>
                        <a href="{{ path('vendor_products') }}" class="block min-h-[44px] flex items-center px-3 rounded-[12px] {{ app.request.attributes.get('_route') starts with 'vendor_product' ? 'bg-white/15 text-app-canvas' : 'text-white/70' }}">Mahsulotlar</a>
                        <a href="{{ path('vendor_wallet') }}" class="block min-h-[44px] flex items-center px-3 rounded-[12px] {{ app.request.attributes.get('_route') == 'vendor_wallet' ? 'bg-white/15 text-app-canvas' : 'text-white/70' }}">Virtual kassa</a>
                        <a href="{{ path('app_logout') }}" class="block min-h-[44px] flex items-center px-3 rounded-[12px] text-red-300">Chiqish</a>
                    </nav>
                </aside>
            </div>

            <main class="flex-1 min-w-0 w-full max-w-6xl mx-auto px-4 py-4 sm:px-5 sm:py-6 lg:px-8">
                {% block main %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="{{ asset('js/mobile-sidebar.js?v=1') }}"></script>
    <script src="{{ asset('js/csp-safe-actions.js') }}"></script>
    <script src="{{ asset('js/vendor-base.js') }}"></script>
</body>
</html>
