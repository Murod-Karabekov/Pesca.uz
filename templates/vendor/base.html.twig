<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Do'konchi paneli{% endblock %} — Pesca</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-screen bg-gray-50">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div data-flash class="fixed top-4 right-4 z-50 max-w-sm px-6 py-4 rounded-xl shadow-lg text-sm font-medium
                {% if label == 'success' %} bg-green-50 text-green-800 border border-green-200
                {% elseif label == 'error' %} bg-red-50 text-red-800 border border-red-200
                {% elseif label == 'warning' %} bg-yellow-50 text-yellow-800 border border-yellow-200
                {% else %} bg-blue-50 text-blue-800 border border-blue-200 {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="flex min-h-screen">
        {# ─── Sidebar ─── #}
        <aside class="hidden lg:flex lg:flex-col w-60 bg-gray-900 text-white sticky top-0 h-screen overflow-y-auto">
            <div class="p-5 border-b border-white/10">
                <a href="{{ path('vendor_dashboard') }}" class="flex items-center gap-2">
                    <span class="text-xl font-bold">🏪 Do'konchi</span>
                </a>
                {% if vendor is defined %}
                    <p class="text-xs text-gray-400 mt-1 truncate">{{ vendor.name }}</p>
                {% endif %}
            </div>

            <nav class="flex-1 p-3 space-y-1">
                <a href="{{ path('vendor_dashboard') }}"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') == 'vendor_dashboard' ? 'bg-white/10 text-white' : 'text-gray-400 hover:bg-white/5 hover:text-white' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Bosh sahifa
                </a>

                <a href="{{ path('vendor_orders') }}"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') starts with 'vendor_order' ? 'bg-white/10 text-white' : 'text-gray-400 hover:bg-white/5 hover:text-white' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Buyurtmalar
                </a>

                <a href="{{ path('vendor_products') }}"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') starts with 'vendor_product' ? 'bg-white/10 text-white' : 'text-gray-400 hover:bg-white/5 hover:text-white' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                    </svg>
                    Mahsulotlar
                </a>

                <a href="{{ path('vendor_wallet') }}"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                          {{ app.request.attributes.get('_route') == 'vendor_wallet' ? 'bg-white/10 text-white' : 'text-gray-400 hover:bg-white/5 hover:text-white' }}">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                    </svg>
                    Virtual kassa
                </a>
            </nav>

            <div class="p-3 border-t border-white/10">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-gray-400 hover:bg-white/5 hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Chiqish
                </a>
            </div>
        </aside>

        {# ─── Main ─── #}
        <div class="flex-1 overflow-auto">
            {# Mobile header #}
            <header class="lg:hidden bg-white border-b px-4 py-3 flex items-center justify-between">
                <button type="button" class="p-2 rounded-lg border border-gray-300 text-gray-700" data-mobile-sidebar-open="vendor-mobile-sidebar" aria-label="Menyuni ochish">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <span class="font-bold text-gray-800">🏪 Do'konchi paneli</span>
                <a href="{{ path('app_logout') }}" class="text-sm text-red-500">Chiqish</a>
            </header>

            <div id="vendor-mobile-sidebar" class="lg:hidden fixed inset-0 z-50 hidden" data-mobile-sidebar>
                <div class="absolute inset-0 bg-black/30 opacity-0 transition-opacity duration-200" data-mobile-sidebar-backdrop></div>
                <aside class="absolute left-0 top-0 h-full w-72 max-w-[85vw] bg-gray-900 text-white transform -translate-x-full transition-transform duration-200" data-mobile-sidebar-drawer>
                    <div class="p-4 border-b border-white/10 flex items-center justify-between">
                        <span class="text-lg font-semibold">Do'konchi menyu</span>
                        <button type="button" class="p-2 rounded-lg border border-white/20" data-mobile-sidebar-close="vendor-mobile-sidebar" aria-label="Yopish">✕</button>
                    </div>
                    <nav class="p-4 space-y-2 text-sm">
                        <a href="{{ path('vendor_dashboard') }}" class="block px-3 py-2 rounded-lg {{ app.request.attributes.get('_route') == 'vendor_dashboard' ? 'bg-white/10 text-white' : 'text-gray-300' }}">Bosh sahifa</a>
                        <a href="{{ path('vendor_orders') }}" class="block px-3 py-2 rounded-lg {{ app.request.attributes.get('_route') starts with 'vendor_order' ? 'bg-white/10 text-white' : 'text-gray-300' }}">Buyurtmalar</a>
                        <a href="{{ path('vendor_products') }}" class="block px-3 py-2 rounded-lg {{ app.request.attributes.get('_route') starts with 'vendor_product' ? 'bg-white/10 text-white' : 'text-gray-300' }}">Mahsulotlar</a>
                        <a href="{{ path('vendor_wallet') }}" class="block px-3 py-2 rounded-lg {{ app.request.attributes.get('_route') == 'vendor_wallet' ? 'bg-white/10 text-white' : 'text-gray-300' }}">Virtual kassa</a>
                        <a href="{{ path('app_logout') }}" class="block px-3 py-2 rounded-lg text-red-300">Chiqish</a>
                    </nav>
                </aside>
            </div>

            <main class="p-6">
                {% block main %}{% endblock %}
            </main>
        </div>
    </div>

    <script src="{{ asset('js/mobile-sidebar.js?v=1') }}"></script>
    <script src="{{ asset('js/csp-safe-actions.js') }}"></script>
    <script src="{{ asset('js/vendor-base.js') }}"></script>
</body>
</html>
