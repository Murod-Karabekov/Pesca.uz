{% extends 'admin/base.html.twig' %}

{% block title %}Korporativ hamkorlik so‘rovlari{% endblock %}

{% block admin_body %}
<div class="mb-8">
    <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Korporativ hamkorlik so‘rovlari</h1>
    <p class="text-app-inkMuted mt-1">Tashkilotlar korporativ so‘rovlari (yangidan eskiga).</p>
</div>

{% if requests|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline overflow-hidden overflow-x-auto">
        <table class="min-w-full">
            <thead class="bg-app-canvas">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Tashkilot</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Aloqa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Sana</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for item in requests %}
                    <tr>
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-app-ink">{{ item.organizationName }}</div>
                            {% if item.submittedByUser %}
                                <div class="text-xs text-app-inkMuted">Akkaunt: {{ item.submittedByUser.phone }}</div>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-sm text-app-ink">
                            <div>{{ item.contactFullName }}</div>
                            <div class="text-xs text-app-inkMuted">{{ item.phone }}</div>
                        </td>
                        <td class="px-4 py-3 text-sm text-app-inkMuted whitespace-nowrap">{{ item.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="px-4 py-3">
                            <a href="{{ path('admin_corporate_partnership_show', {id: item.id}) }}" class="text-sm font-semibold text-app-accent hover:text-app-ink">Batafsil →</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="text-center text-app-inkMuted py-12 card">Hozircha so‘rov yo‘q.</p>
{% endif %}
{% endblock %}
