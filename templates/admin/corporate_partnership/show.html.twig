{% extends 'admin/base.html.twig' %}

{% block title %}{{ inquiry.organizationName }} — Korporativ{% endblock %}

{% block admin_body %}
<div class="mb-6">
    <a href="{{ path('admin_corporate_partnership_index') }}" class="text-sm text-app-inkMuted hover:text-app-ink">← Ro‘yxat</a>
    <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink mt-2">{{ inquiry.organizationName }}</h1>
    <p class="text-sm text-app-inkMuted mt-1">{{ inquiry.createdAt|date('d.m.Y H:i') }}</p>
</div>

<div class="card p-5 sm:p-6 space-y-4 text-sm max-w-3xl">
    <div>
        <p class="text-xs font-semibold uppercase text-app-inkMuted">Mas'ul shaxs</p>
        <p class="text-app-ink font-medium">{{ inquiry.contactFullName }}</p>
    </div>
    <div>
        <p class="text-xs font-semibold uppercase text-app-inkMuted">Telefon</p>
        <p class="text-app-ink"><a href="tel:{{ inquiry.phone }}" class="text-app-accent hover:underline">{{ inquiry.phone }}</a></p>
    </div>
    <div>
        <p class="text-xs font-semibold uppercase text-app-inkMuted">Manzil</p>
        <p class="text-app-ink whitespace-pre-wrap">{{ inquiry.address }}</p>
    </div>
    <div>
        <p class="text-xs font-semibold uppercase text-app-inkMuted">Takliflar</p>
        <p class="text-app-ink whitespace-pre-wrap">{{ inquiry.additionalNotes }}</p>
    </div>
    {% if inquiry.submittedByUser %}
    <div class="pt-3 border-t border-app-hairline">
        <p class="text-xs font-semibold uppercase text-app-inkMuted">Tizim foydalanuvchisi</p>
        <p class="text-app-ink">{{ inquiry.submittedByUser.fullName }} — {{ inquiry.submittedByUser.phone }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
