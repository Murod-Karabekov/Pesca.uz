{% extends 'admin/base.html.twig' %}

{% block title %}Do'konni tahrirlash{% endblock %}

{% block admin_body %}
<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="{{ path('admin_vendor_show', {id: vendor.id}) }}" class="text-gray-400 hover:text-gray-600">← Orqaga</a>
        <h1 class="text-2xl font-bold text-gray-800">Tahrirlash: {{ vendor.name }}</h1>
    </div>

    <div class="bg-white rounded-2xl border shadow-sm p-6">
        <form action="{{ path('admin_vendor_edit', {id: vendor.id}) }}" method="POST" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('vendor_edit_' ~ vendor.id) }}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Do'kon nomi *</label>
                <input type="text" name="name" required value="{{ vendor.name }}"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Telefon</label>
                <input type="text" name="phone" value="{{ vendor.phone }}"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Manzil</label>
                <textarea name="address" rows="2"
                          class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none resize-none">{{ vendor.address }}</textarea>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Komissiya (%)</label>
                <input type="number" name="commission_rate" min="0" max="50" step="0.5"
                       value="{{ vendor.commissionRate }}"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>
            <div>
                <label class="flex items-center gap-2 cursor-pointer select-none">
                    <input type="checkbox" name="is_active" value="1" {{ vendor.isActive ? 'checked' : '' }}
                           class="rounded">
                    <span class="text-sm font-medium text-gray-700">Do'kon faol</span>
                </label>
            </div>
            <div class="border-t pt-5">
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Do'konchi telefoni (o'zgartirish uchun)</label>
                <input type="text" name="owner_phone" value="{{ vendor.owner ? vendor.owner.phone : '' }}"
                       placeholder="{{ vendor.owner ? vendor.owner.phone : 'Yangi eganing telefoni' }}"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold text-sm transition-colors">
                    Saqlash
                </button>
                <a href="{{ path('admin_vendor_show', {id: vendor.id}) }}"
                   class="px-5 py-3 border rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    Bekor qilish
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
