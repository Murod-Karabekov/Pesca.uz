{% extends 'admin/base.html.twig' %}

{% block title %}Do'konlar{% endblock %}

{% block admin_body %}
<div>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-5">
        <h1 class="text-xl sm:text-2xl font-display font-semibold text-app-ink">Do'konlar</h1>
        <a href="{{ path('admin_vendor_new') }}"
           class="btn-primary shrink-0 justify-center min-h-[48px] px-5 text-sm">
            + Yangi do'kon
        </a>
    </div>

    {# Pending mahsulotlar bor do'konlar uchun ogohlantirish #}
    {% set pendingTotal = 0 %}
    {% for v in vendors %}
        {# Bu yerda pending_count qo'shimcha query kerak — kelajakda optimallashtirish mumkin #}
    {% endfor %}

    {% if vendors is empty %}
        <div class="card p-10 sm:p-12 text-center text-app-inkMuted">
            <p class="text-4xl mb-3">🏪</p>
            <p class="font-medium mb-4 text-app-ink">Hali do'kon yo'q</p>
            <a href="{{ path('admin_vendor_new') }}" class="btn-primary inline-flex justify-center min-h-[48px] px-6 text-sm">
                Birinchi do'konni yaratish
            </a>
        </div>
    {% else %}
        <div class="card overflow-hidden">
            <table class="w-full text-sm">
                <thead>
                <tr class="bg-app-canvas text-app-inkMuted text-xs uppercase border-b">
                    <th class="text-left px-6 py-3">Do'kon</th>
                    <th class="text-left px-4 py-3">Egasi</th>
                    <th class="text-right px-4 py-3">Komissiya</th>
                    <th class="text-right px-4 py-3">Jami savdo</th>
                    <th class="text-center px-4 py-3">Holati</th>
                    <th class="text-center px-6 py-3">Amal</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-app-hairline">
                {% for vendor in vendors %}
                <tr class="hover:bg-app-canvas">
                    <td class="px-6 py-3">
                        <p class="font-semibold text-app-ink">{{ vendor.name }}</p>
                        {% if vendor.phone %}
                            <p class="text-xs text-app-inkMuted">{{ vendor.phone }}</p>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3">
                        {% if vendor.owner %}
                            <p class="text-app-ink">{{ vendor.owner.fullName }}</p>
                            <p class="text-xs text-app-inkMuted">{{ vendor.owner.phone }}</p>
                        {% else %}
                            <span class="text-xs text-app-inkMuted">— biriktirilmagan</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3 text-right font-medium text-orange-600">{{ vendor.commissionRate }}%</td>
                    <td class="px-4 py-3 text-right font-semibold text-app-ink">
                        {{ vendor.totalEarnings|number_format(0, '.', ' ') }} so'm
                    </td>
                    <td class="px-4 py-3 text-center">
                        {% if vendor.isActive %}
                            <span class="inline-flex px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">Faol</span>
                        {% else %}
                            <span class="inline-flex px-2 py-1 rounded-full text-xs bg-red-100 text-red-700">To'xtatilgan</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-3 text-center">
                        <a href="{{ path('admin_vendor_show', {id: vendor.id}) }}"
                           class="text-app-accent hover:text-app-ink underline-offset-2 hover:underline text-xs font-semibold min-h-[44px] inline-flex items-center justify-center">Ko'rish →</a>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
