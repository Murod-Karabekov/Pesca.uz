{% extends 'admin/base.html.twig' %}

{% block title %}Yangi do'kon{% endblock %}

{% block admin_body %}
<div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="{{ path('admin_vendor_index') }}" class="text-app-inkMuted hover:text-app-inkMuted">← Orqaga</a>
        <h1 class="text-2xl font-bold text-app-ink">Yangi do'kon yaratish</h1>
    </div>

    <div class="bg-white rounded-2xl border shadow-sm p-6">
        <form action="{{ path('admin_vendor_new') }}" method="POST" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('vendor_new') }}">

            <div>
                <label class="block text-sm font-medium text-app-ink mb-1.5">Do'kon nomi *</label>
                <input type="text" name="name" required maxlength="255"
                       placeholder="Masalan: StyleCity Jizzax"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>

            <div>
                <label class="block text-sm font-medium text-app-ink mb-1.5">Do'kon telefoni</label>
                <input type="text" name="phone" maxlength="20"
                       placeholder="+998901234567"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
            </div>

            <div>
                <label class="block text-sm font-medium text-app-ink mb-1.5">Manzil</label>
                <textarea name="address" rows="2" maxlength="500"
                          placeholder="Do'kon manzili..."
                          class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none resize-none"></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-app-ink mb-1.5">Komissiya foizi (%)</label>
                <input type="number" name="commission_rate" min="0" max="50" step="0.5" value="10"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                <p class="text-xs text-app-inkMuted mt-1">Har bir tasdiqlangan zakazdan platforma oladigan foiz</p>
            </div>

            <div class="border-t pt-5">
                <label class="block text-sm font-medium text-app-ink mb-1.5">Do'konchi (foydalanuvchi telefoni)</label>
                <input type="text" name="owner_phone" maxlength="20"
                       placeholder="+998901234567 — ro'yxatdan o'tgan foydalanuvchi"
                       class="w-full border rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                <p class="text-xs text-app-inkMuted mt-1">
                    Bu foydalanuvchiga avtomatik <strong>ROLE_VENDOR</strong> beriladi va do'konga biriktiriladi.
                </p>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold text-sm transition-colors">
                    Do'kon yaratish
                </button>
                <a href="{{ path('admin_vendor_index') }}"
                   class="px-5 py-3 border rounded-xl text-sm font-medium text-app-inkMuted hover:bg-app-canvas transition-colors">
                    Bekor qilish
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
