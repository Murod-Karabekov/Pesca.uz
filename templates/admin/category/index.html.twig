{% extends 'admin/base.html.twig' %}

{% block title %}Kategoriyalar{% endblock %}

{% block admin_body %}
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">Kategoriyalar</h1>
        <p class="text-brand-medium mt-1">Mahsulot kategoriyalarini boshqaring</p>
    </div>
    <a href="{{ path('admin_category_new') }}" class="btn-primary text-sm">
        + Kategoriya qo'shish
    </a>
</div>

{% if categories|length > 0 %}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {% for category in categories %}
    <div class="card p-6">
        <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">{{ category.icon ?? '📁' }}</span>
            <div>
                <h3 class="font-semibold text-brand-dark text-lg">{{ category.name }}</h3>
                <p class="text-xs text-brand-medium">/{{ category.slug }}</p>
            </div>
        </div>
        <p class="text-sm text-brand-medium mb-4">{{ category.products|length }} ta mahsulot</p>
        <div class="flex items-center gap-2 pt-4 border-t border-beige-100">
            <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn-secondary text-xs !py-2 !px-3">Tahrirlash</a>
            <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="inline" onsubmit="return confirm('Bu kategoriyani o\'chirasizmi?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                <button type="submit" class="btn-danger text-xs !py-2 !px-3">O'chirish</button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="card p-12 text-center">
    <svg class="w-16 h-16 mx-auto text-beige-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
    </svg>
    <p class="text-brand-medium mb-4">Hali kategoriya qo'shilmagan</p>
    <a href="{{ path('admin_category_new') }}" class="btn-primary text-sm">Birinchi kategoriya qo'shish</a>
</div>
{% endif %}
{% endblock %}
