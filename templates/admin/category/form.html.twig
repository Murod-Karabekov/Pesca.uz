{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block admin_body %}
<div class="mb-8">
    <a href="{{ path('admin_category_index') }}" class="inline-flex items-center gap-2 text-sm text-app-inkMuted hover:text-app-ink transition-colors mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Kategoriyalarga qaytish
    </a>
    <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">{{ title }}</h1>
</div>

<div class="card p-6 md:p-8 max-w-2xl">
    {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

    <div>
        {{ form_label(form.name, null, {'label_attr': {'class': 'block text-sm font-medium text-app-ink mb-2'}}) }}
        {{ form_widget(form.name) }}
        {{ form_errors(form.name) }}
    </div>

    <div>
        {{ form_label(form.slug, null, {'label_attr': {'class': 'block text-sm font-medium text-app-ink mb-2'}}) }}
        {{ form_widget(form.slug) }}
        {{ form_errors(form.slug) }}
        <p class="text-xs text-app-inkMuted mt-1">Bo'sh qoldirsangiz, nomdan avtomatik yaratiladi.</p>
    </div>

    <div>
        {{ form_label(form.icon, null, {'label_attr': {'class': 'block text-sm font-medium text-app-ink mb-2'}}) }}
        {{ form_widget(form.icon) }}
        {{ form_errors(form.icon) }}
        <p class="text-xs text-app-inkMuted mt-1">Emoji kiriting: 🥼 👕 👗 🧥 🩺 🎽</p>
    </div>

    <div class="flex gap-3 pt-4">
        <button type="submit" class="btn-primary">Kategoriyani saqlash</button>
        <a href="{{ path('admin_category_index') }}" class="btn-secondary">Bekor qilish</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
