{% extends 'admin/base.html.twig' %}

{% block title %}E'lonlar{% endblock %}

{% block admin_body %}
<div class="mb-6 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">E'lonlar</h1>
        <p class="text-app-inkMuted mt-1">Tez boshqaruv: holat, tartib va tahrirlash hammasi bir ekranda.</p>
    </div>
    <a href="{{ path('admin_announcement_new') }}" class="btn-primary min-h-[48px] justify-center text-sm shrink-0">Yangi e'lon</a>
</div>

{% if announcements|length > 0 %}
    <div class="space-y-3">
        {% for announcement in announcements %}
            <div class="card p-4">
                <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-4 items-start">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {{ announcement.isActive ? 'bg-green-100 text-green-800' : 'bg-app-canvas text-app-inkMuted border border-app-hairline' }}">
                                {{ announcement.isActive ? 'Faol' : 'Nofaol' }}
                            </span>
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-app-canvas text-app-ink">
                                {{ announcement.mediaTypeLabel }}
                            </span>
                            <span class="text-xs text-app-inkMuted">Tartib: {{ announcement.sortOrder }}</span>
                        </div>

                        <h2 class="text-base md:text-lg font-display font-bold text-app-ink break-words">{{ announcement.title }}</h2>
                        <p class="text-sm text-app-inkMuted mt-1">{{ announcement.body|slice(0, 110) }}{% if announcement.body|length > 110 %}...{% endif %}</p>

                        <details class="mt-3">
                            <summary class="cursor-pointer list-none text-xs font-semibold text-app-accent hover:text-app-ink inline-flex items-center gap-1">
                                To'liq ko'rish
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div class="mt-2 rounded-xl border border-app-hairline bg-app-canvas p-3">
                                <p class="text-sm text-app-inkMuted whitespace-pre-line leading-relaxed">{{ announcement.body }}</p>
                                {% if announcement.mediaUrl %}
                                    <p class="text-xs text-app-inkMuted mt-2 break-all">Media: {{ announcement.mediaUrl }}</p>
                                {% endif %}
                            </div>
                        </details>

                        {% if announcement.ctaLabel and announcement.ctaUrl %}
                            <p class="text-xs text-app-inkMuted mt-2">CTA: {{ announcement.ctaLabel }} ({{ announcement.ctaUrl }})</p>
                        {% endif %}
                    </div>

                    <div class="flex items-center lg:items-stretch gap-2 lg:flex-col lg:min-w-36">
                        <a href="{{ path('admin_announcement_edit', {id: announcement.id}) }}" class="btn-secondary text-center">Tahrirlash</a>
                        <form method="post" action="{{ path('admin_announcement_delete', {id: announcement.id}) }}" data-confirm="E'lonni o'chirasizmi?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_announcement_' ~ announcement.id) }}">
                            <button type="submit" class="w-full rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-100 transition-colors">O'chirish</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="card p-12 text-center">
        <p class="text-app-inkMuted">Hali e'lonlar yo'q.</p>
    </div>
{% endif %}
{% endblock %}
