{% extends 'admin/base.html.twig' %}

{% block title %}Buyurtmalar tarixi{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Buyurtmalar tarixi</h1>
        <p class="text-app-inkMuted mt-1">Tasdiqlangan yoki rad etilgan buyurtmalar arxivi</p>
    </div>
    <a
        href="{{ path('admin_order_index') }}"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-app-hairline text-app-inkMuted hover:text-app-ink hover:border-app-accent hover:bg-app-canvas transition-colors"
        title="Yangi buyurtmalar"
        aria-label="Yangi buyurtmalar"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
    </a>
</div>

<div class="card p-5 mb-6">
    <form method="get" action="{{ path('admin_order_history') }}" class="flex flex-col md:flex-row gap-3">
        <div class="flex-1 relative">
            <input
                type="text"
                name="q"
                value="{{ query }}"
                placeholder="Telefon yoki ism bo'yicha qidiring"
                class="input-field w-full pl-10"
            >
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-app-inkMuted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
        <button type="submit" class="btn-primary">Qidirish</button>
        {% if query %}
            <a href="/admin/orders/history" class="btn-secondary text-center">Tozalash</a>
        {% endif %}
    </form>
</div>

{% if orders|length > 0 %}
<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-app-canvas border-b border-app-hairline">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Order</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Mijoz</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Lokatsiya</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Jami</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">To'lov</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Qaror vaqti</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for order in orders %}
                                        <textarea id="copy-text-history-{{ order.id }}" class="hidden">🧵 PESCA BUYURTMA (ARXIV)
━━━━━━━━━━━━━━━━━━━━
Buyurtma: #{{ order.id }}
Sana: {{ order.createdAt|date('d.m.Y H:i') }}
Qaror vaqti: {{ order.approvedAt ? order.approvedAt|date('d.m.Y H:i') : '-' }}
Mijoz: {{ order.customerFullName }}
Telefon: {{ order.customerPhone }}
Lokatsiya: {{ order.locationLabel }}
To'lov holati: {{ order.paymentStatusLabel }}

📦 MAHSULOTLAR:
{% for item in order.items %}{{ loop.index }}. {{ item.productNameSnapshot }}
     Soni: {{ item.quantity }} dona
     Rasm: {% if item.productImageSnapshot %}{{ item.productImageSnapshot starts with 'http' ? item.productImageSnapshot : absolute_url(item.productImageSnapshot) }}{% else %}Rasm yo'q{% endif %}
{% endfor %}
{% if order.notes %}
📝 Izoh: {{ order.notes }}
{% endif %}
━━━━━━━━━━━━━━━━━━━━
Tikish uchun aniq buyurtma: #{{ order.id }}</textarea>

                    <tr class="hover:bg-app-canvas/50 transition-colors">
                        <td class="px-6 py-4 text-sm font-semibold text-app-ink">#{{ order.id }}</td>
                        <td class="px-6 py-4 text-sm text-app-inkMuted">
                            <div class="font-medium text-app-ink">{{ order.customerFullName }}</div>
                            <div class="text-xs text-app-inkMuted">{{ order.customerPhone }}</div>
                        </td>
                        <td class="px-6 py-4 text-sm text-app-inkMuted">{{ order.locationLabel }}</td>
                        <td class="px-6 py-4 text-sm font-semibold text-app-ink">{{ order.subtotalAmount|number_format(0, '.', ' ') }} so'm</td>
                        <td class="px-6 py-4">
                            {% set paymentColor = order.paymentStatus == 'approved' ? 'green' : 'red' %}
                            {% set firstItem = order.items|first %}
                            {% set shopName = firstItem and firstItem.vendor ? firstItem.vendor.name : null %}
                            <div class="flex flex-wrap items-center gap-2">
                                {% if order.approvedByAdmin is null and shopName %}
                                    <span class="badge bg-blue-100 text-blue-700">
                                        {{ shopName }} {{ order.paymentStatus == 'approved' ? 'tasdiqladi' : 'rad etdi' }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-{{ paymentColor }}-100 text-{{ paymentColor }}-700">{{ order.paymentStatusLabel }}</span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-app-inkMuted">{{ order.approvedAt ? order.approvedAt|date('d.m.Y H:i') : '-' }}</td>
                        <td class="px-6 py-4">
                            <button
                                type="button"
                                class="copy-order-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-app-hairline text-app-inkMuted hover:text-app-ink hover:border-app-accent hover:bg-app-canvas transition-colors"
                                data-copy-target="copy-text-history-{{ order.id }}"
                                title="Nusxalash"
                                aria-label="Nusxalash"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card p-12 text-center">
    <p class="text-app-inkMuted">Tarixda buyurtmalar topilmadi.</p>
</div>
{% endif %}

<div id="copy-toast" class="hidden fixed top-4 right-4 z-50 px-4 py-2 rounded-xl bg-green-50 text-green-800 border border-green-200 text-sm font-medium shadow-lg">
    Nusxalandi
</div>

<script src="{{ asset('js/admin-order-history.js') }}"></script>
{% endblock %}
