{% extends 'admin/base.html.twig' %}

{% block title %}Buyurtmalar{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">Yangi buyurtmalar</h1>
        <p class="text-brand-medium mt-1">Faqat yangi buyurtmalar. Qatorni bossangiz tarkib ochiladi.</p>
    </div>
    <a
        href="/admin/orders/history"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-beige-300 text-brand-medium hover:text-peach-700 hover:border-peach-300 hover:bg-peach-50 transition-colors"
        title="Buyurtmalar tarixi"
        aria-label="Buyurtmalar tarixi"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-2.64-6.36M21 3v6h-6"/>
        </svg>
    </a>
</div>

<div class="card p-4 md:p-5 mb-6 flex items-center justify-between">
    <span class="text-sm text-brand-medium">Kutilayotgan buyurtmalar soni</span>
    <span class="text-xl font-display font-bold text-brand-dark">{{ orders|length }}</span>
</div>

<div id="copy-toast" class="hidden fixed top-4 right-4 z-50 px-4 py-2 rounded-xl bg-green-50 text-green-800 border border-green-200 text-sm font-medium shadow-lg">
    Nusxalandi
</div>

{% if orders|length > 0 %}
<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-beige-50 border-b border-beige-200">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">Order</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">Mijoz</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">Lokatsiya</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">Jami</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">To'lov</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider">Sana</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-brand-medium uppercase tracking-wider"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-beige-100">
                {% for order in orders %}
                <tr class="order-row hover:bg-beige-50/50 transition-colors cursor-pointer" data-order-id="{{ order.id }}">
                    <td class="px-6 py-4 text-sm font-semibold text-brand-dark">#{{ order.id }}</td>
                    <td class="px-6 py-4 text-sm text-brand-medium">
                        <div class="font-medium text-brand-dark">{{ order.customerFullName }}</div>
                        <div class="text-xs text-brand-light">{{ order.customerPhone }}</div>
                    </td>
                    <td class="px-6 py-4 text-sm text-brand-medium">{{ order.locationLabel }}</td>
                    <td class="px-6 py-4 text-sm font-semibold text-brand-dark">{{ order.subtotalAmount|number_format(0, '.', ' ') }} so'm</td>
                    <td class="px-6 py-4">
                        {% set paymentColor = order.paymentStatus == 'approved' ? 'green' : (order.paymentStatus == 'rejected' ? 'red' : 'yellow') %}
                        <span class="badge bg-{{ paymentColor }}-100 text-{{ paymentColor }}-700">{{ order.paymentStatusLabel }}</span>
                    </td>
                    <td class="px-6 py-4 text-sm text-brand-medium">{{ order.createdAt|date('d.m.Y H:i') }}</td>
                    <td class="px-6 py-4">
                                                <textarea id="copy-text-{{ order.id }}" class="hidden">🛒 PESCA BUYURTMA
━━━━━━━━━━━━━━━━━━━━
Buyurtma: #{{ order.id }}
Sana: {{ order.createdAt|date('d.m.Y H:i') }}
Mijoz: {{ order.customerFullName }}
Telefon: {{ order.customerPhone }}
Manzil: {{ order.locationLabel }}
To'lov holati: {{ order.paymentStatusLabel }}

📦 MAHSULOTLAR:
{% for item in order.items %}{{ loop.index }}. {{ item.productNameSnapshot }}
    Soni: {{ item.quantity }} dona{% if item.selectedSize %} | O'lcham: {{ item.selectedSize }}{% endif %}
{% endfor %}
{% if order.notes %}
📝 Izoh: {{ order.notes }}
{% endif %}
━━━━━━━━━━━━━━━━━━━━
Buyurtma raqami: #{{ order.id }}</textarea>

                        <div class="flex items-center gap-2 order-actions">
                            <a
                                href="{{ path('admin_order_show', {id: order.id}) }}"
                                class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-beige-300 text-brand-medium hover:text-peach-700 hover:border-peach-300 hover:bg-peach-50 transition-colors"
                                title="Buyurtma detal"
                                aria-label="Buyurtma detal"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15 12H9m12 0A9 9 0 113 12a9 9 0 0118 0z"/>
                                </svg>
                            </a>

                            <button
                                type="button"
                                class="copy-order-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-beige-300 text-brand-medium hover:text-peach-700 hover:border-peach-300 hover:bg-peach-50 transition-colors"
                                                                data-copy-target="copy-text-{{ order.id }}"
                                title="Buyurtmani nusxalash"
                                aria-label="Buyurtmani nusxalash"
                            >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </button>

                            {% if order.canApprovePayment %}
                                <form method="post" action="{{ path('admin_order_approve_payment', {id: order.id}) }}" class="inline-flex">
                                    <input type="hidden" name="_token" value="{{ csrf_token('approve_order_' ~ order.id) }}">
                                    <input type="hidden" name="note" value="To'lov tasdiqlandi (tezkor tasdiq)">
                                    <button
                                        type="submit"
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-green-300 text-green-700 hover:bg-green-50 transition-colors"
                                        title="To'lovni tasdiqlash"
                                        aria-label="To'lovni tasdiqlash"
                                    >
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    </button>
                                </form>

                                <form method="post" action="{{ path('admin_order_reject_payment', {id: order.id}) }}" class="inline-flex">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reject_order_' ~ order.id) }}">
                                    <input type="hidden" name="note" value="To'lov rad etildi (tezkor rad etish)">
                                    <button
                                        type="submit"
                                        class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-red-300 text-red-700 hover:bg-red-50 transition-colors"
                                        title="To'lovni rad etish"
                                        aria-label="To'lovni rad etish"
                                    >
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                    </button>
                                </form>
                            {% else %}
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-beige-300 text-brand-light" title="To'lov qarori qabul qilingan">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M5 13l4 4L19 7"/>
                                    </svg>
                                </span>
                            {% endif %}
                        </div>
                    </td>
                </tr>

                <tr class="order-details-row hidden bg-beige-50/40" data-order-details-id="{{ order.id }}">
                    <td colspan="7" class="px-6 py-5">
                        <div class="rounded-2xl border border-beige-200 bg-white p-4 md:p-5">
                            <div class="flex items-center justify-between gap-4 mb-4">
                                <h4 class="font-display font-semibold text-brand-dark">Buyurtma tarkibi</h4>
                                <span class="text-xs text-brand-light">#{{ order.id }}</span>
                            </div>

                            <div class="space-y-3">
                                {% for item in order.items %}
                                    <div class="border border-beige-200 rounded-xl p-3 flex flex-col md:flex-row md:items-center gap-3">
                                        <div class="w-16 h-16 rounded-lg overflow-hidden bg-beige-100 flex-shrink-0">
                                            {% if item.productImageSnapshot %}
                                                <img src="{{ item.productImageSnapshot }}" alt="{{ item.productNameSnapshot }}" class="w-full h-full object-cover">
                                            {% else %}
                                                <div class="w-full h-full flex items-center justify-center text-[10px] text-beige-400">Rasm yo'q</div>
                                            {% endif %}
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-semibold text-brand-dark">{{ item.productNameSnapshot }}</p>
                                            <p class="text-xs text-brand-medium">{{ item.unitPrice|number_format(0, '.', ' ') }} so'm x {{ item.quantity }} dona{% if item.selectedSize %} | O'lcham: {{ item.selectedSize }}{% endif %}</p>
                                            <p class="text-xs text-brand-light break-all">
                                                Rasm link: {% if item.productImageSnapshot %}{{ item.productImageSnapshot starts with 'http' ? item.productImageSnapshot : absolute_url(item.productImageSnapshot) }}{% else %}Rasm yo'q{% endif %}
                                            </p>
                                        </div>
                                        <div class="text-sm font-semibold text-brand-dark">{{ item.lineTotal|number_format(0, '.', ' ') }} so'm</div>
                                    </div>
                                {% endfor %}
                            </div>

                            {% if order.notes %}
                                <div class="mt-4 p-3 rounded-xl bg-beige-50 border border-beige-200">
                                    <p class="text-xs uppercase tracking-wider text-brand-light mb-1">Mijoz izohi</p>
                                    <p class="text-sm text-brand-dark">{{ order.notes }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card p-12 text-center">
    <p class="text-brand-medium">Buyurtmalar topilmadi.</p>
</div>
{% endif %}

<script src="{{ asset('js/admin-order-index.js') }}"></script>
{% endblock %}
