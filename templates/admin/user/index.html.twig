{% extends 'admin/base.html.twig' %}

{% block title %}Foydalanuvchilar{% endblock %}

{% block admin_body %}
<div class="mb-8">
    <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Foydalanuvchilar</h1>
    <p class="text-app-inkMuted mt-1">Ro'yxatdan o'tgan foydalanuvchilarni boshqaring va rollarni belgilang</p>
</div>

{# ─── Search ─── #}
<div class="card p-6 mb-8">
    <form method="get" action="{{ path('admin_user_index') }}" class="flex flex-col sm:flex-row gap-3">
        <div class="flex-1 relative">
            <input type="tel" name="q" value="{{ search }}" placeholder="Telefon raqami bo'yicha qidirish..."
                   class="input-field w-full pl-10" autofocus>
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-app-inkMuted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
        <button type="submit" class="btn-primary whitespace-nowrap">Qidirish</button>
        {% if search %}
            <a href="{{ path('admin_user_index') }}" class="px-4 py-2.5 bg-app-hairline text-app-inkMuted rounded-xl text-sm font-medium hover:bg-app-canvas transition-colors text-center">Tozalash</a>
        {% endif %}
    </form>
</div>

{# ─── Assign Role Card ─── #}
<div class="card p-6 mb-8 max-w-lg">
    <h3 class="font-display font-semibold text-lg text-app-ink mb-4">Telefon orqali rol belgilash</h3>
    <form method="post" action="{{ path('admin_user_assign_role') }}" class="flex flex-col sm:flex-row gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('assign_role') }}">
        <input type="text" name="phone" placeholder="+998901234567" class="input-field flex-1" required
               autocomplete="off">
        <select name="role" class="input-field sm:w-40">
            <option value="ROLE_USER">Foydalanuvchi</option>
            <option value="ROLE_VENDOR">Do'konchi</option>
            <option value="ROLE_ADMIN">Admin</option>
        </select>
        <button type="submit" class="btn-primary whitespace-nowrap">Belgilash</button>
    </form>
</div>

{# ─── Users Table ─── #}
{% if users|length > 0 %}
<div class="card overflow-hidden">
    <div class="overflow-x-auto max-h-[32rem] overflow-y-auto">
        <table class="w-full">
            <thead class="bg-app-canvas border-b border-app-hairline">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Ism</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Telefon</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Tarif</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Umumiy balans</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Bonus balans</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Rollar</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider">Sana</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-app-inkMuted uppercase tracking-wider"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for user in users %}
                <tr class="hover:bg-app-canvas/50 transition-colors">
                    <td class="px-6 py-4">
                        <span class="font-medium text-app-ink text-sm">{{ user.fullName }}</span>
                    </td>
                    <td class="px-6 py-4 text-sm text-app-inkMuted">{{ user.phone }}</td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2 py-0.5 bg-{{ user.currentPlanColor }}-100 text-{{ user.currentPlanColor }}-700 rounded-full text-xs font-semibold">
                            {{ user.currentPlanLabel }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-sm font-medium text-emerald-600">{{ user.generalBalance|number_format(0, '.', ' ') }}</td>
                    <td class="px-6 py-4 text-sm font-medium text-app-ink">{{ user.bonusWallet ? user.bonusWallet.balance|number_format(0, '.', ' ') : '0' }}</td>
                    <td class="px-6 py-4">
                        {% for role in user.roles %}
                            {% if role == 'ROLE_ADMIN' %}
                                <span class="badge bg-app-ink text-app-canvas">Admin</span>
                            {% elseif role == 'ROLE_VENDOR' %}
                                <span class="badge bg-blue-100 text-blue-700">Do'konchi</span>
                            {% elseif role == 'ROLE_USER' %}
                                <span class="badge bg-app-hairline text-app-inkMuted">Foydalanuvchi</span>
                            {% endif %}
                        {% endfor %}
                    </td>
                    <td class="px-6 py-4 text-sm text-app-inkMuted">{{ user.createdAt|date('d.m.Y') }}</td>
                    <td class="px-6 py-4">
                        <a href="{{ path('admin_user_show', {id: user.id}) }}" class="text-neutral-600 hover:text-app-ink text-sm font-medium">Batafsil →</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% else %}
<div class="card p-12 text-center">
    <p class="text-app-inkMuted">Hali ro'yxatdan o'tgan foydalanuvchilar yo'q.</p>
</div>
{% endif %}
{% endblock %}
