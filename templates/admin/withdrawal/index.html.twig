{% extends 'admin/base.html.twig' %}

{% block title %}Yechish so'rovlari{% endblock %}

{% block admin_body %}
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-2xl font-display font-bold text-brand-dark">💸 Yechish so'rovlari</h1>
        {% if pendingCount > 0 %}
            <p class="text-sm text-red-600 mt-1">{{ pendingCount }} ta kutilayotgan so'rov bor</p>
        {% endif %}
    </div>
</div>

{% if withdrawals|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-beige-200 overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-beige-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Foydalanuvchi</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Summa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Karta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Holat</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Sana</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Harakatlar</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-beige-100">
                {% for w in withdrawals %}
                    <tr class="{% if w.isPending %}bg-yellow-50{% endif %}">
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-brand-dark">{{ w.user.fullName }}</div>
                            <div class="text-xs text-brand-light">{{ w.user.phone }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-sm font-bold text-brand-dark">{{ w.amount|number_format(0, '.', ' ') }} so'm</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="text-sm text-brand-dark">{{ w.cardNumber }}</div>
                            <div class="text-xs text-brand-light">{{ w.cardHolderName }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                {% if w.status == 'pending' %} bg-yellow-100 text-yellow-800
                                {% elseif w.status == 'completed' %} bg-green-100 text-green-800
                                {% elseif w.status == 'rejected' %} bg-red-100 text-red-800
                                {% else %} bg-blue-100 text-blue-800 {% endif %}">
                                {{ w.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-brand-light">
                            {{ w.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="px-4 py-3">
                            {% if w.isPending %}
                                <div class="flex items-center gap-2">
                                    <form method="post" action="{{ path('admin_withdrawal_approve', {id: w.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ w.id) }}">
                                        <input type="hidden" name="note" value="Admin tasdiqladi">
                                        <button type="submit" class="px-3 py-1 bg-green-500 text-white text-xs rounded-lg hover:bg-green-600">
                                            ✅ Tasdiqlash
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_withdrawal_reject', {id: w.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_' ~ w.id) }}">
                                        <input type="hidden" name="note" value="Admin rad etdi">
                                        <button type="submit" class="px-3 py-1 bg-red-500 text-white text-xs rounded-lg hover:bg-red-600"
                                                onclick="return confirm('Rad etishni tasdiqlaysizmi? Mablag\' qaytariladi.')">
                                            ❌ Rad etish
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <span class="text-xs text-brand-light">
                                    {% if w.processedAt %}{{ w.processedAt|date('d.m.Y H:i') }}{% endif %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="bg-white rounded-xl shadow-sm border border-beige-200 p-12 text-center">
        <p class="text-brand-light">Hali yechish so'rovlari yo'q</p>
    </div>
{% endif %}
{% endblock %}
