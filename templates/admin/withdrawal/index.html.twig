{% extends 'admin/base.html.twig' %}

{% block title %}Yechish so'rovlari{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Yangi yechish so'rovlari</h1>
        <p class="text-app-inkMuted mt-1">Faqat yangi yechish so'rovlari. Tasdiqlangan/rad etilganlar tarixda.</p>
    </div>
    <a
        href="{{ path('admin_withdrawal_history') }}"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-app-hairline text-app-inkMuted hover:text-app-ink hover:border-app-accent hover:bg-app-canvas transition-colors"
        title="Yechish tarixi"
        aria-label="Yechish tarixi"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-2.64-6.36M21 3v6h-6"/>
        </svg>
    </a>
</div>

<div class="card p-4 md:p-5 mb-6 flex items-center justify-between">
    <span class="text-sm text-app-inkMuted">Kutilayotgan yechish so'rovlar soni</span>
    <span class="text-xl font-display font-bold text-app-ink">{{ withdrawals|length }}</span>
</div>

{% if withdrawals|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-app-canvas">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Foydalanuvchi</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Summa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Karta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Holat</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Sana</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Harakatlar</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for w in withdrawals %}
                    <tr class="{% if w.isPending %}bg-yellow-50{% endif %}">
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-app-ink">{{ w.user.fullName }}</div>
                            <div class="text-xs text-app-inkMuted">{{ w.user.phone }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-sm font-bold text-app-ink">{{ w.amount|number_format(0, '.', ' ') }} so'm</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="text-sm text-app-ink">{{ w.cardNumber }}</div>
                            <div class="text-xs text-app-inkMuted">{{ w.cardHolderName }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                {% if w.status == 'pending' %} bg-yellow-100 text-yellow-800
                                {% elseif w.status == 'completed' %} bg-green-100 text-green-800
                                {% elseif w.status == 'rejected' %} bg-red-100 text-red-800
                                {% else %} bg-blue-100 text-blue-800 {% endif %}">
                                {{ w.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-app-inkMuted">
                            {{ w.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="px-4 py-3">
                            {% if w.isPending %}
                                <div class="flex items-center gap-2">
                                    <form method="post" action="{{ path('admin_withdrawal_approve', {id: w.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ w.id) }}">
                                        <input type="hidden" name="note" value="Admin tasdiqladi">
                                        <button type="submit" class="px-3 py-1 bg-green-500 text-white text-xs rounded-lg hover:bg-green-600">
                                            ✅ Tasdiqlash
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_withdrawal_reject', {id: w.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_' ~ w.id) }}">
                                        <input type="hidden" name="note" value="Admin rad etdi">
                                        <button type="submit" class="px-3 py-1 bg-red-500 text-white text-xs rounded-lg hover:bg-red-600"
                                                data-confirm="Rad etishni tasdiqlaysizmi? Mablag' qaytariladi.">
                                            ❌ Rad etish
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <span class="text-xs text-app-inkMuted">
                                    {% if w.processedAt %}{{ w.processedAt|date('d.m.Y H:i') }}{% endif %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline p-12 text-center">
        <p class="text-app-inkMuted">Yangi yechish so'rovlari yo'q.</p>
    </div>
{% endif %}
{% endblock %}
