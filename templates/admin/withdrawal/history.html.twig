{% extends 'admin/base.html.twig' %}

{% block title %}Yechish tarixi{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Yechish tarixi</h1>
        <p class="text-app-inkMuted mt-1">Tasdiqlangan yoki rad etilgan yechish so'rovlari arxivi</p>
    </div>
    <a
        href="{{ path('admin_withdrawal_index') }}"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-app-hairline text-app-inkMuted hover:text-app-ink hover:border-app-accent hover:bg-app-canvas transition-colors"
        title="Yangi yechish so'rovlari"
        aria-label="Yangi yechish so'rovlari"
    >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
    </a>
</div>

<div class="card p-5 mb-6">
    <form method="get" action="{{ path('admin_withdrawal_history') }}" class="flex flex-col md:flex-row gap-3">
        <div class="flex-1 relative">
            <input
                type="text"
                name="q"
                value="{{ query }}"
                placeholder="Telefon yoki ism bo'yicha qidiring"
                class="input-field w-full pl-10"
            >
            <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-app-inkMuted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </div>
        <button type="submit" class="btn-primary">Qidirish</button>
        {% if query %}
            <a href="/admin/withdrawals/history" class="btn-secondary text-center">Tozalash</a>
        {% endif %}
    </form>
</div>

{% if withdrawals|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-app-canvas">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Foydalanuvchi</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Summa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Karta</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Holat</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Qaror vaqti</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for w in withdrawals %}
                    <tr class="hover:bg-app-canvas/50 transition-colors">
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-app-ink">{{ w.user.fullName }}</div>
                            <div class="text-xs text-app-inkMuted">{{ w.user.phone }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-sm font-bold text-app-ink">{{ w.amount|number_format(0, '.', ' ') }} so'm</span>
                        </td>
                        <td class="px-4 py-3 text-sm text-app-ink">
                            <div>{{ w.cardNumber }}</div>
                            <div class="text-xs text-app-inkMuted">{{ w.cardHolderName }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                {% if w.status == 'completed' %} bg-green-100 text-green-800
                                {% else %} bg-red-100 text-red-800 {% endif %}">
                                {{ w.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-app-inkMuted">
                            {{ w.processedAt ? w.processedAt|date('d.m.Y H:i') : '-' }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="card p-12 text-center">
        <p class="text-app-inkMuted">Tarixda yechish so'rovlari topilmadi.</p>
    </div>
{% endif %}
{% endblock %}
