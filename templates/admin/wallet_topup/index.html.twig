{% extends 'admin/base.html.twig' %}

{% block title %}Hamyon to'ldirish so'rovlari{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-brand-dark">Yangi top-up so'rovlari</h1>
        <p class="text-brand-medium mt-1">Faqat yangi so'rovlar. Tasdiqlangan/rad etilganlar tarixda.</p>
    </div>
    <div class="flex items-center gap-2">
        <a
            href="{{ path('admin_wallet_topup_history') }}"
            class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-beige-300 text-brand-medium hover:text-peach-700 hover:border-peach-300 hover:bg-peach-50 transition-colors"
            title="Top-up tarixi"
            aria-label="Top-up tarixi"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-2.64-6.36M21 3v6h-6"/>
            </svg>
        </a>
    </div>
</div>

<div class="card p-4 md:p-5 mb-6 flex items-center justify-between">
    <span class="text-sm text-brand-medium">Kutilayotgan top-up so'rovlar soni</span>
    <span class="text-xl font-display font-bold text-brand-dark">{{ requests|length }}</span>
</div>

{% if requests|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-beige-200 overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-beige-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Foydalanuvchi</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Summa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">To'lov</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Holat</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Sana</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-brand-medium uppercase">Harakatlar</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-beige-100">
                {% for item in requests %}
                    <tr class="{% if item.isPending %}bg-yellow-50{% endif %}">
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-brand-dark">{{ item.user.fullName }}</div>
                            <div class="text-xs text-brand-light">{{ item.user.phone }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-sm font-bold text-brand-dark">{{ item.amount|number_format(0, '.', ' ') }} so'm</span>
                        </td>
                        <td class="px-4 py-3 text-xs text-brand-dark">
                            <div>{{ item.methodLabel }}</div>
                            <div class="text-brand-light">User: {{ item.user.fullName }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                {% if item.status == 'pending' %} bg-yellow-100 text-yellow-800
                                {% elseif item.status == 'approved' %} bg-green-100 text-green-800
                                {% else %} bg-red-100 text-red-800 {% endif %}">
                                {{ item.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-brand-light">
                            {{ item.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="px-4 py-3">
                            {% if item.isPending %}
                                <div class="flex items-center gap-2">
                                    <form method="post" action="{{ path('admin_wallet_topup_approve', {id: item.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ item.id) }}">
                                        <input type="hidden" name="note" value="To'lov tasdiqlandi">
                                        <button type="submit" class="px-3 py-1 bg-green-500 text-white text-xs rounded-lg hover:bg-green-600">
                                            ✅ Tasdiqlash
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_wallet_topup_reject', {id: item.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_' ~ item.id) }}">
                                        <input type="hidden" name="note" value="To'lov topilmadi yoki noto'g'ri">
                                        <button type="submit" class="px-3 py-1 bg-red-500 text-white text-xs rounded-lg hover:bg-red-600"
                                                data-confirm="So'rovni rad etishni tasdiqlaysizmi?">
                                            ❌ Rad etish
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <span class="text-xs text-brand-light">
                                    {% if item.processedAt %}{{ item.processedAt|date('d.m.Y H:i') }}{% endif %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="bg-white rounded-xl shadow-sm border border-beige-200 p-12 text-center">
        <p class="text-brand-light">Yangi top-up so'rovlari yo'q.</p>
    </div>
{% endif %}
{% endblock %}
