{% extends 'admin/base.html.twig' %}

{% block title %}Hamyon to'ldirish so'rovlari{% endblock %}

{% block admin_body %}
<div class="mb-8 flex items-start justify-between gap-4">
    <div>
        <h1 class="text-2xl md:text-3xl font-display font-bold text-app-ink">Yangi top-up so'rovlari</h1>
        <p class="text-app-inkMuted mt-1">Faqat yangi so'rovlar. Tasdiqlangan/rad etilganlar tarixda.</p>
    </div>
    <div class="flex items-center gap-2">
        <a
            href="{{ path('admin_wallet_topup_history') }}"
            class="inline-flex items-center justify-center w-10 h-10 rounded-xl border border-app-hairline text-app-inkMuted hover:text-app-ink hover:border-app-accent hover:bg-app-canvas transition-colors"
            title="Top-up tarixi"
            aria-label="Top-up tarixi"
        >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-2.64-6.36M21 3v6h-6"/>
            </svg>
        </a>
    </div>
</div>

<div class="card p-4 md:p-5 mb-6 flex items-center justify-between">
    <span class="text-sm text-app-inkMuted">Kutilayotgan top-up so'rovlar soni</span>
    <span class="text-xl font-display font-bold text-app-ink">{{ requests|length }}</span>
</div>

{% if requests|length > 0 %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline overflow-hidden">
        <table class="min-w-full">
            <thead class="bg-app-canvas">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Foydalanuvchi</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Summa</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">To'lov</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Holat</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Sana</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-app-inkMuted uppercase">Harakatlar</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-app-hairline">
                {% for item in requests %}
                    <tr class="{% if item.isPending %}bg-yellow-50{% endif %}">
                        <td class="px-4 py-3">
                            <div class="text-sm font-medium text-app-ink">{{ item.user.fullName }}</div>
                            <div class="text-xs text-app-inkMuted">{{ item.user.phone }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-sm font-bold text-app-ink">{{ item.amount|number_format(0, '.', ' ') }} so'm</span>
                        </td>
                        <td class="px-4 py-3 text-xs text-app-ink">
                            <div>{{ item.methodLabel }}</div>
                            <div class="text-app-inkMuted">User: {{ item.user.fullName }}</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium
                                {% if item.status == 'pending' %} bg-yellow-100 text-yellow-800
                                {% elseif item.status == 'approved' %} bg-green-100 text-green-800
                                {% else %} bg-red-100 text-red-800 {% endif %}">
                                {{ item.statusLabel }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-app-inkMuted">
                            {{ item.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="px-4 py-3">
                            {% if item.isPending %}
                                <div class="flex items-center gap-2">
                                    <form method="post" action="{{ path('admin_wallet_topup_approve', {id: item.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_' ~ item.id) }}">
                                        <input type="hidden" name="note" value="To'lov tasdiqlandi">
                                        <button type="submit" class="px-3 py-1 bg-green-500 text-white text-xs rounded-lg hover:bg-green-600">
                                            ✅ Tasdiqlash
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_wallet_topup_reject', {id: item.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_' ~ item.id) }}">
                                        <input type="hidden" name="note" value="To'lov topilmadi yoki noto'g'ri">
                                        <button type="submit" class="px-3 py-1 bg-red-500 text-white text-xs rounded-lg hover:bg-red-600"
                                                data-confirm="So'rovni rad etishni tasdiqlaysizmi?">
                                            ❌ Rad etish
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <span class="text-xs text-app-inkMuted">
                                    {% if item.processedAt %}{{ item.processedAt|date('d.m.Y H:i') }}{% endif %}
                                </span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="bg-white rounded-xl shadow-sm border border-app-hairline p-12 text-center">
        <p class="text-app-inkMuted">Yangi top-up so'rovlari yo'q.</p>
    </div>
{% endif %}
{% endblock %}
