{% extends 'base.html.twig' %}

{% block title %}Pesca — Online kiyim do'koni{% endblock %}

{% block body %}
{% set apkDownloadUrl = asset('downloads/smartstyle-latest.apk') %}
{# ─── Mobile/Tablet SmartStyle App Home ─── #}
<section class="lg:hidden relative min-h-[100svh] overflow-hidden bg-[#0b1020] text-white">
    <div class="absolute inset-0 pointer-events-none">
        <div class="ss-orb ss-orb-1"></div>
        <div class="ss-orb ss-orb-2"></div>
        <div class="ss-orb ss-orb-3"></div>
        <div class="ss-rain" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,rgba(255,255,255,0.2),transparent_35%),radial-gradient(circle_at_80%_20%,rgba(114,140,255,0.28),transparent_32%),radial-gradient(circle_at_50%_90%,rgba(46,200,255,0.22),transparent_34%)]"></div>
    </div>

    <div class="relative z-10 max-w-md mx-auto px-4 pt-8 pb-10">
        <div class="ss-glass rounded-[26px] p-4 border border-white/25 shadow-2xl">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-[11px] uppercase tracking-[0.22em] text-cyan-100/80">SmartStyle.ai</p>
                    <h1 class="mt-2 text-2xl font-display font-semibold tracking-tight">AI Fashion Assistant</h1>
                </div>
                <span class="inline-flex items-center justify-center rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-semibold text-cyan-100">
                    beta
                </span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-slate-100/90">
                Sun'iy intellekt sizning uslubingiz, tana proporsiyangiz va kiyim didingizga mos tavsiyalar beradi.
            </p>
        </div>

        <div class="mt-4 ss-glass rounded-2xl border border-white/20 p-2">
            <img
                src="{{ asset('images/home/mobile.png') }}"
                alt="SmartStyle AI fashion"
                class="w-full h-[240px] object-cover object-[center_28%] rounded-[14px]"
                loading="lazy"
            >
        </div>

        <div class="mt-6 grid grid-cols-1 gap-3">
            <a href="{{ path('app_smart_style_index') }}"
               class="inline-flex min-h-[50px] items-center justify-center rounded-2xl bg-white text-[#0e1326] font-semibold text-sm shadow-xl shadow-cyan-200/20 transition-transform duration-200 active:scale-[0.98]">
                SmartStylega o'tish
            </a>
            <a href="{{ path('app_product_index') }}"
               class="inline-flex min-h-[48px] items-center justify-center rounded-2xl border border-white/35 bg-white/10 text-white font-medium text-sm backdrop-blur transition-colors hover:bg-white/15">
                Marketplace kolleksiyasi
            </a>
        </div>

        <div class="mt-4 ss-glass rounded-2xl border border-white/25 p-3">
            <p class="text-[11px] uppercase tracking-[0.2em] text-cyan-100/80">Android ilova</p>
            <a href="{{ apkDownloadUrl }}" download rel="noopener noreferrer"
               class="mt-2 inline-flex w-full items-center justify-between rounded-xl bg-white px-3 py-2.5 text-[#0e1326] shadow-lg shadow-cyan-200/25">
                <span class="flex items-center gap-2">
                    <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-[#111827]">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 2l10.5 10L3 22z" fill="#34A853"/>
                            <path d="M13.5 12L18 7.7 6.7 1.8A2 2 0 005.4 1.5z" fill="#4285F4"/>
                            <path d="M13.5 12L18 16.3 6.7 22.2A2 2 0 015.4 22.5z" fill="#FBBC04"/>
                            <path d="M18 7.7l2.9 1.7a2 2 0 010 3.2L18 16.3 13.5 12z" fill="#EA4335"/>
                        </svg>
                    </span>
                    <span class="text-left">
                        <span class="block text-[10px] uppercase tracking-[0.15em] text-slate-500">Android</span>
                        <span class="block text-sm font-semibold">SmartStyle.ai</span>
                    </span>
                </span>
                <span class="text-xs font-semibold text-slate-500">Yuklab olish</span>
            </a>
        </div>
    </div>

    <style>
        .ss-glass {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.07));
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .ss-orb {
            position: absolute;
            border-radius: 9999px;
            filter: blur(18px);
            opacity: 0.65;
            animation: ss-float 8s ease-in-out infinite;
        }

        .ss-orb-1 {
            width: 180px;
            height: 180px;
            left: -40px;
            top: 30px;
            background: rgba(71, 199, 255, 0.45);
        }

        .ss-orb-2 {
            width: 210px;
            height: 210px;
            right: -70px;
            top: 120px;
            background: rgba(132, 123, 255, 0.45);
            animation-delay: 1.8s;
        }

        .ss-orb-3 {
            width: 190px;
            height: 190px;
            left: 35%;
            bottom: -60px;
            background: rgba(52, 233, 188, 0.35);
            animation-delay: 3s;
        }

        .ss-rain {
            position: absolute;
            inset: 0;
            overflow: hidden;
            opacity: 0.42;
        }

        .ss-rain span {
            position: absolute;
            top: -20%;
            width: 1px;
            height: 18px;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.8));
            border-radius: 999px;
            animation: ss-rain-fall linear infinite;
        }

        .ss-rain span:nth-child(1) { left: 7%; animation-duration: 3.8s; animation-delay: 0.1s; }
        .ss-rain span:nth-child(2) { left: 14%; animation-duration: 4.2s; animation-delay: 1.2s; }
        .ss-rain span:nth-child(3) { left: 22%; animation-duration: 3.4s; animation-delay: 0.8s; }
        .ss-rain span:nth-child(4) { left: 29%; animation-duration: 4.6s; animation-delay: 2.3s; }
        .ss-rain span:nth-child(5) { left: 36%; animation-duration: 3.1s; animation-delay: 1.6s; }
        .ss-rain span:nth-child(6) { left: 43%; animation-duration: 4.1s; animation-delay: 0.4s; }
        .ss-rain span:nth-child(7) { left: 50%; animation-duration: 3.7s; animation-delay: 2.1s; }
        .ss-rain span:nth-child(8) { left: 58%; animation-duration: 4.4s; animation-delay: 0.9s; }
        .ss-rain span:nth-child(9) { left: 66%; animation-duration: 3.6s; animation-delay: 1.5s; }
        .ss-rain span:nth-child(10) { left: 73%; animation-duration: 4.0s; animation-delay: 2.8s; }
        .ss-rain span:nth-child(11) { left: 79%; animation-duration: 3.2s; animation-delay: 1.1s; }
        .ss-rain span:nth-child(12) { left: 85%; animation-duration: 4.8s; animation-delay: 0.3s; }
        .ss-rain span:nth-child(13) { left: 90%; animation-duration: 3.9s; animation-delay: 2.4s; }
        .ss-rain span:nth-child(14) { left: 95%; animation-duration: 4.3s; animation-delay: 1.9s; }
        .ss-rain span:nth-child(15) { left: 98%; animation-duration: 3.5s; animation-delay: 0.6s; }

        @keyframes ss-float {
            0%, 100% {
                transform: translateY(0) translateX(0) scale(1);
            }
            50% {
                transform: translateY(-14px) translateX(8px) scale(1.06);
            }
        }

        @keyframes ss-rain-fall {
            0% {
                transform: translateY(-20%) translateX(0);
                opacity: 0;
            }
            12% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(130vh) translateX(-12px);
                opacity: 0;
            }
        }
    </style>
</section>

<div class="hidden lg:block">
{# ─── Hero (mobil ilova uslubi) ─── #}
<section class="relative bg-app-canvas overflow-hidden border-b border-app-hairline">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
            <div class="space-y-7">
                <p class="text-xs font-semibold tracking-[0.2em] uppercase text-app-accent">Pesca</p>
                <h1 class="text-4xl md:text-[2.75rem] md:leading-[1.1] font-display font-medium text-app-ink tracking-tight">
                    Sifatli kiyim,
                    <span class="text-app-accent">qulay</span>
                    narxda
                </h1>
                <p class="text-base md:text-lg text-app-inkMuted leading-relaxed max-w-lg">
                    Erkak, ayol va bolalar uchun hamma turdagi kiyimlar. Zakaz qiling — uyingizga yetkazib beramiz.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a href="{{ path('app_product_index') }}" class="btn-primary text-base">
                        Kolleksiyani ko'rish
                    </a>
                    <a href="{{ path('app_hamkorlik_index') }}" class="btn-secondary text-base">
                        Hamkorlik
                    </a>
                </div>

                <a href="{{ apkDownloadUrl }}" download rel="noopener noreferrer"
                   class="inline-flex items-center gap-3 rounded-2xl border border-app-hairline bg-white px-4 py-3 text-app-ink shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-[#111827]">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M3 2l10.5 10L3 22z" fill="#34A853"/>
                            <path d="M13.5 12L18 7.7 6.7 1.8A2 2 0 005.4 1.5z" fill="#4285F4"/>
                            <path d="M13.5 12L18 16.3 6.7 22.2A2 2 0 015.4 22.5z" fill="#FBBC04"/>
                            <path d="M18 7.7l2.9 1.7a2 2 0 010 3.2L18 16.3 13.5 12z" fill="#EA4335"/>
                        </svg>
                    </span>
                    <span>
                        <span class="block text-[11px] uppercase tracking-[0.18em] text-app-inkMuted">Android</span>
                        <span class="block text-lg font-display font-semibold">SmartStyle.ai</span>
                    </span>
                </a>
            </div>
            <div class="relative hidden md:block">
                <div class="relative rounded-[20px] border border-app-hairline bg-white p-2 shadow-none">
                    <img
                        src="{{ asset('images/home/desktop.png') }}"
                        alt="Pesca kiyim kolleksiyasi"
                        class="w-full h-[26rem] object-cover rounded-[14px]"
                    >
                </div>
            </div>
        </div>
    </div>
</section>

{# ─── Features Section ─── #}
{% if announcements|length > 0 %}
<section class="py-10 md:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {% for announcement in announcements %}
                {% set previewLength = 140 %}
                {% set fullBody = announcement.body %}
                {% set hasMore = fullBody|length > previewLength %}
                {% set previewBody = hasMore ? fullBody|slice(0, previewLength) ~ '...' : fullBody %}
                {% set modalId = 'announcement_modal_' ~ announcement.id %}

                <article
                    class="group relative rounded-3xl border-2 border-beige-300 bg-gradient-to-br from-white via-beige-50 to-peach-50 shadow-md shadow-peach-100/30 overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-peach-300"
                    role="button"
                    tabindex="0"
                    data-dialog-open="{{ modalId }}"
                    aria-label="{{ announcement.title }} e'lonini ochish"
                >
                    <div class="absolute right-3 top-3 z-20 inline-flex items-center gap-1 rounded-full border border-peach-200 bg-white/95 px-2 py-1 text-[11px] font-semibold text-peach-700 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-peach-500"></span>
                        Ochish
                    </div>

                    {% if announcement.hasMedia %}
                        <div class="h-44 bg-white border-b border-beige-200 overflow-hidden">
                            {% if announcement.mediaType == 'image' %}
                                <div class="relative h-full w-full p-2">
                                    <img
                                        src="{{ announcement.embedUrl }}"
                                        alt="{{ announcement.title }}"
                                        class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl opacity-55"
                                    >
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-white/15"></div>
                                    <img
                                        src="{{ announcement.embedUrl }}"
                                        alt="{{ announcement.title }}"
                                        class="relative z-10 h-full w-full object-contain rounded-xl"
                                    >
                                </div>
                            {% else %}
                                <iframe
                                    src="{{ announcement.embedUrl }}"
                                    title="{{ announcement.title }}"
                                    class="h-full w-full p-2 rounded-xl bg-black"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    allowfullscreen
                                ></iframe>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="p-5">
                        <h3 class="text-lg font-display font-bold text-brand-dark leading-snug break-words">{{ announcement.title }}</h3>
                        <p class="mt-2 text-sm text-brand-medium leading-relaxed whitespace-pre-line">{{ previewBody }}</p>
                    </div>
                </article>

                <dialog id="{{ modalId }}" class="announcement-modal w-[92vw] max-w-2xl rounded-3xl border border-beige-200 p-0 shadow-2xl" data-dialog-backdrop-close>
                        <div class="bg-white">
                            <div class="flex items-start justify-between gap-3 border-b border-beige-200 px-5 py-4">
                                <h4 class="text-lg font-display font-bold text-brand-dark leading-snug break-words">{{ announcement.title }}</h4>
                                <button type="button" data-dialog-close="{{ modalId }}" class="shrink-0 rounded-full border border-beige-200 bg-white p-2 text-brand-medium hover:text-brand-dark hover:border-beige-300" aria-label="Yopish">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>

                            <div class="px-5 py-4 max-h-[70vh] overflow-y-auto">
                                {% if announcement.hasMedia %}
                                    <div class="mb-4 overflow-hidden rounded-2xl border border-beige-200 bg-white">
                                        {% if announcement.mediaType == 'image' %}
                                            <div class="relative h-64 w-full bg-beige-50 p-2">
                                                <img
                                                    src="{{ announcement.embedUrl }}"
                                                    alt="{{ announcement.title }}"
                                                    class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl opacity-50"
                                                >
                                                <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-white/20"></div>
                                                <img
                                                    src="{{ announcement.embedUrl }}"
                                                    alt="{{ announcement.title }}"
                                                    class="relative z-10 h-full w-full object-contain rounded-xl"
                                                >
                                            </div>
                                        {% else %}
                                            <iframe
                                                src="{{ announcement.embedUrl }}"
                                                title="{{ announcement.title }}"
                                                class="h-64 w-full bg-black"
                                                loading="lazy"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                referrerpolicy="strict-origin-when-cross-origin"
                                                allowfullscreen
                                            ></iframe>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="text-sm text-brand-medium leading-relaxed whitespace-pre-line">{{ fullBody }}</div>

                                {% if announcement.ctaLabel and announcement.ctaUrl %}
                                    <div class="mt-5">
                                        <a href="{{ announcement.ctaUrl }}" class="inline-flex items-center gap-2 rounded-full bg-brand-dark px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-peach-600">
                                            {{ announcement.ctaLabel }}
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                            </svg>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                </dialog>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<style>
    dialog.announcement-modal {
        opacity: 0;
        transform: translateY(14px) scale(0.97);
    }

    dialog.announcement-modal[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
        animation: announcement-modal-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    dialog.announcement-modal::backdrop {
        background: rgba(15, 12, 10, 0.62);
        backdrop-filter: blur(6px);
    }

    dialog.announcement-modal[open]::backdrop {
        animation: announcement-backdrop-in 200ms ease-out;
    }

    @keyframes announcement-modal-in {
        from {
            opacity: 0;
            transform: translateY(14px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes announcement-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>

{# ─── Featured Products ─── #}
{% if featured_products|length > 0 %}
<section class="py-12 md:py-24 bg-beige-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-7 md:mb-12">
            <h2 class="text-2xl md:text-4xl font-display font-bold text-brand-dark mb-2 md:mb-4">Tanlangan kolleksiya</h2>
            <p class="text-sm md:text-base text-brand-medium max-w-2xl mx-auto">Sifatli va uslubli kiyimlar to'g'ridan-to'g'ri uyingizga yetkaziladi.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-5">
            {% for product in featured_products %}
            <a href="{{ path('app_product_show', {id: product.id}) }}"
               class="group flex flex-col min-w-0 rounded-[18px] bg-white border border-app-hairline overflow-hidden shadow-sm active:scale-[0.98] transition-transform duration-150 hover:shadow-md hover:border-app-ink/15">
                <div class="aspect-[3/4] bg-app-canvas relative overflow-hidden">
                    {% if product.imageSrc %}
                        <img
                            src="{{ product.imageSrc }}"
                            alt="{{ product.name }}"
                            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-out"
                            loading="lazy"
                        >
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-12 h-12 sm:w-14 sm:h-14 text-beige-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                <div class="p-3 sm:p-4 flex flex-col flex-1 min-h-[5.5rem] sm:min-h-[6rem]">
                    <h3 class="text-[13px] sm:text-sm font-semibold text-app-ink leading-snug line-clamp-2 break-words group-hover:text-app-accent transition-colors flex-1">
                        {{ product.name }}
                    </h3>
                    <p class="text-sm sm:text-base font-display font-semibold text-app-ink tabular-nums mt-2 pt-1 border-t border-app-hairline">
                        {{ product.price|number_format(0, '.', ' ') }} <span class="text-[11px] font-sans font-medium text-app-inkMuted">so'm</span>
                    </p>
                    {% if product.size|length > 0 %}
                        <p class="text-[10px] sm:text-[11px] text-app-inkMuted mt-1.5 line-clamp-1 break-all">{{ product.size|join(', ') }}</p>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        <div class="text-center mt-7 md:mt-10">
            <a href="{{ path('app_product_index') }}" class="btn-secondary text-sm md:text-base">Barcha kolleksiyani ko'rish →</a>
        </div>
    </div>
</section>
{% endif %}

{# ─── Auto-Display Banners ─── #}
{% if banners|length > 0 %}
    <style>
        @keyframes countdown-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.1);
                opacity: 0.9;
            }
        }

        .banner-countdown {
            animation: countdown-pulse 0.6s ease-in-out;
        }

        .banner-ring {
            --progress: 0;
            background: conic-gradient(#f97316 calc(var(--progress) * 1%), #f3f4f6 0);
        }
    </style>

    {% for banner in banners %}
        {% set bannerId = 'banner_modal_' ~ banner.id %}
        {% set countdownId = 'banner_countdown_' ~ banner.id %}
        {% set ringId = 'banner_ring_' ~ banner.id %}

        <dialog id="{{ bannerId }}" class="announcement-modal w-[92vw] max-w-2xl rounded-3xl border border-beige-200 p-0 shadow-2xl" data-dialog-backdrop-close data-banner-modal data-display-seconds="{{ banner.delaySeconds|default(0) }}">
            <div class="relative bg-white rounded-3xl overflow-hidden">
                {% if banner.hasMedia and banner.mediaType == 'image' %}
                    <div class="bg-beige-100 overflow-hidden {% if banner.title or banner.body %}max-h-[52vh]{% endif %}">
                        <img
                            src="{{ banner.embedUrl }}"
                            alt="{{ banner.title ?: 'Banner' }}"
                            class="w-full h-full object-contain"
                        >
                    </div>
                {% elseif banner.hasMedia and banner.mediaType == 'video' %}
                    <iframe
                        src="{{ banner.embedUrl }}"
                        title="{{ banner.title ?: 'Banner' }}"
                        class="h-64 md:h-80 w-full bg-black"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    ></iframe>
                {% endif %}

                {% if banner.title or banner.body or (banner.ctaLabel and banner.ctaUrl) %}
                    <div class="p-5 md:p-6">
                        {% if banner.title %}
                            <h3 class="text-xl md:text-2xl font-display font-bold text-brand-dark mb-2">{{ banner.title }}</h3>
                        {% endif %}
                        {% if banner.body %}
                            <p class="text-sm md:text-base text-brand-medium whitespace-pre-line leading-relaxed">{{ banner.body }}</p>
                        {% endif %}
                        {% if banner.ctaLabel and banner.ctaUrl %}
                            <div class="mt-4">
                                <a href="{{ banner.ctaUrl }}" class="inline-flex items-center gap-2 rounded-full bg-brand-dark px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-peach-600">
                                    {{ banner.ctaLabel }}
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                    </svg>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="pointer-events-none absolute right-3 top-3 z-20 flex items-center gap-2 rounded-full bg-white/95 px-2 py-1 shadow-md border border-beige-200">
                    <div id="{{ ringId }}" class="banner-ring h-6 w-6 rounded-full p-[2px]">
                        <div class="h-full w-full rounded-full bg-white"></div>
                    </div>
                    <span class="text-xs font-semibold text-brand-dark"><span id="{{ countdownId }}">{{ banner.delaySeconds|default(0) }}</span>s</span>
                </div>

                <button type="button" data-dialog-close="{{ bannerId }}" class="absolute left-3 top-3 z-20 rounded-full border border-beige-200 bg-white/95 p-1.5 text-brand-medium hover:text-brand-dark hover:border-beige-300" aria-label="Yopish">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </dialog>
    {% endfor %}

    <script src="{{ asset('js/home-banners.js') }}"></script>
{% endif %}

</div>
{% endblock %}
