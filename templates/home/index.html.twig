{% extends 'base.html.twig' %}

{% block title %}Pesca — Online kiyim do'koni{% endblock %}

{% block body %}
{# ─── Hero Section ─── #}
<section class="relative bg-gradient-to-br from-peach-50 via-beige-50 to-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-8">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-peach-100 text-peach-700 rounded-full text-sm font-medium">
                    <span class="w-2 h-2 bg-peach-500 rounded-full animate-pulse"></span>
                    Zamonaviy kolleksiyalar
                </div>
                <h1 class="text-4xl md:text-6xl font-display font-bold text-brand-dark leading-tight">
                    Sifatli kiyim,
                    <span class="text-peach-500">qulay</span>
                    narxda
                </h1>
                <p class="text-lg text-brand-medium leading-relaxed max-w-lg">
                    Erkak, ayol va bolalar uchun hamma turdagi kiyimlar. Zakaz qiling — uyingizga yetkazib beramiz.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="{{ path('app_product_index') }}" class="btn-primary text-base px-8 py-4">
                        Kolleksiyani ko'rish
                    </a>
                    <a href="{{ path('app_hamkorlik_index') }}" class="btn-secondary text-base px-8 py-4">
                        Hamkorlik
                    </a>
                </div>
            </div>
            <div class="relative hidden md:block">
                {# Hero image with peach decorative frame #}
                <div class="relative">
                    <div class="absolute -inset-3 border-4 border-peach-300 rounded-3xl"></div>
                    <div class="absolute -inset-1 bg-gradient-to-tr from-peach-200/30 to-beige-200/30 rounded-2xl"></div>
                    <img
                        src="https://i.pinimg.com/736x/bb/6f/85/bb6f85562ea83531d0a0dcfec54c2c6c.jpg"
                        alt="Pesca kiyim kolleksiyasi"
                        class="relative w-full h-[28rem] object-cover rounded-2xl shadow-2xl"
                    >
                    {# Decorative corner accents #}
                    <div class="absolute -top-5 -right-5 w-10 h-10 border-t-4 border-r-4 border-peach-400 rounded-tr-xl"></div>
                    <div class="absolute -bottom-5 -left-5 w-10 h-10 border-b-4 border-l-4 border-peach-400 rounded-bl-xl"></div>
                </div>
                <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-peach-300 rounded-2xl opacity-60 -z-10"></div>
                <div class="absolute -top-6 -right-6 w-24 h-24 bg-beige-300 rounded-full opacity-40 -z-10"></div>
            </div>
        </div>
    </div>
</section>

{# ─── Features Section ─── #}
{% if announcements|length > 0 %}
<section class="py-10 md:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {% for announcement in announcements %}
                {% set previewLength = 140 %}
                {% set fullBody = announcement.body %}
                {% set hasMore = fullBody|length > previewLength %}
                {% set previewBody = hasMore ? fullBody|slice(0, previewLength) ~ '...' : fullBody %}
                {% set modalId = 'announcement_modal_' ~ announcement.id %}

                <article
                    class="group relative rounded-3xl border-2 border-beige-300 bg-gradient-to-br from-white via-beige-50 to-peach-50 shadow-md shadow-peach-100/30 overflow-hidden cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-peach-300"
                    role="button"
                    tabindex="0"
                    onclick="document.getElementById('{{ modalId }}').showModal()"
                    onkeydown="if(event.key==='Enter' || event.key===' '){event.preventDefault();document.getElementById('{{ modalId }}').showModal();}"
                    aria-label="{{ announcement.title }} e'lonini ochish"
                >
                    <div class="absolute right-3 top-3 z-20 inline-flex items-center gap-1 rounded-full border border-peach-200 bg-white/95 px-2 py-1 text-[11px] font-semibold text-peach-700 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-peach-500"></span>
                        Ochish
                    </div>

                    {% if announcement.hasMedia %}
                        <div class="h-44 bg-white border-b border-beige-200 overflow-hidden">
                            {% if announcement.mediaType == 'image' %}
                                <div class="relative h-full w-full p-2">
                                    <img
                                        src="{{ announcement.embedUrl }}"
                                        alt="{{ announcement.title }}"
                                        class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl opacity-55"
                                    >
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-white/15"></div>
                                    <img
                                        src="{{ announcement.embedUrl }}"
                                        alt="{{ announcement.title }}"
                                        class="relative z-10 h-full w-full object-contain rounded-xl"
                                    >
                                </div>
                            {% else %}
                                <iframe
                                    src="{{ announcement.embedUrl }}"
                                    title="{{ announcement.title }}"
                                    class="h-full w-full p-2 rounded-xl bg-black"
                                    loading="lazy"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    referrerpolicy="strict-origin-when-cross-origin"
                                    allowfullscreen
                                ></iframe>
                            {% endif %}
                        </div>
                    {% endif %}

                    <div class="p-5">
                        <h3 class="text-lg font-display font-bold text-brand-dark leading-snug break-words">{{ announcement.title }}</h3>
                        <p class="mt-2 text-sm text-brand-medium leading-relaxed whitespace-pre-line">{{ previewBody }}</p>
                    </div>
                </article>

                <dialog id="{{ modalId }}" class="announcement-modal w-[92vw] max-w-2xl rounded-3xl border border-beige-200 p-0 shadow-2xl" onclick="if (event.target === this) this.close();">
                        <div class="bg-white">
                            <div class="flex items-start justify-between gap-3 border-b border-beige-200 px-5 py-4">
                                <h4 class="text-lg font-display font-bold text-brand-dark leading-snug break-words">{{ announcement.title }}</h4>
                                <button type="button" onclick="document.getElementById('{{ modalId }}').close()" class="shrink-0 rounded-full border border-beige-200 bg-white p-2 text-brand-medium hover:text-brand-dark hover:border-beige-300" aria-label="Yopish">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                </button>
                            </div>

                            <div class="px-5 py-4 max-h-[70vh] overflow-y-auto">
                                {% if announcement.hasMedia %}
                                    <div class="mb-4 overflow-hidden rounded-2xl border border-beige-200 bg-white">
                                        {% if announcement.mediaType == 'image' %}
                                            <div class="relative h-64 w-full bg-beige-50 p-2">
                                                <img
                                                    src="{{ announcement.embedUrl }}"
                                                    alt="{{ announcement.title }}"
                                                    class="absolute inset-0 h-full w-full object-cover scale-110 blur-2xl opacity-50"
                                                >
                                                <div class="absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-white/20"></div>
                                                <img
                                                    src="{{ announcement.embedUrl }}"
                                                    alt="{{ announcement.title }}"
                                                    class="relative z-10 h-full w-full object-contain rounded-xl"
                                                >
                                            </div>
                                        {% else %}
                                            <iframe
                                                src="{{ announcement.embedUrl }}"
                                                title="{{ announcement.title }}"
                                                class="h-64 w-full bg-black"
                                                loading="lazy"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                referrerpolicy="strict-origin-when-cross-origin"
                                                allowfullscreen
                                            ></iframe>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="text-sm text-brand-medium leading-relaxed whitespace-pre-line">{{ fullBody }}</div>

                                {% if announcement.ctaLabel and announcement.ctaUrl %}
                                    <div class="mt-5">
                                        <a href="{{ announcement.ctaUrl }}" class="inline-flex items-center gap-2 rounded-full bg-brand-dark px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-peach-600">
                                            {{ announcement.ctaLabel }}
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                            </svg>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                </dialog>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<style>
    dialog.announcement-modal {
        opacity: 0;
        transform: translateY(14px) scale(0.97);
    }

    dialog.announcement-modal[open] {
        opacity: 1;
        transform: translateY(0) scale(1);
        animation: announcement-modal-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    dialog.announcement-modal::backdrop {
        background: rgba(15, 12, 10, 0.62);
        backdrop-filter: blur(6px);
    }

    dialog.announcement-modal[open]::backdrop {
        animation: announcement-backdrop-in 200ms ease-out;
    }

    @keyframes announcement-modal-in {
        from {
            opacity: 0;
            transform: translateY(14px) scale(0.97);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes announcement-backdrop-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>

{# ─── Featured Products ─── #}
{% if featured_products|length > 0 %}
<section class="py-16 md:py-24 bg-beige-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-brand-dark mb-4">Tanlangan kolleksiya</h2>
            <p class="text-brand-medium max-w-2xl mx-auto">Sifatli va uslubli kiyimlar to'g'ridan-to'g'ri uyingizga yetkaziladi.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {% for product in featured_products %}
            <a href="{{ path('app_product_show', {id: product.id}) }}" class="card group">
                <div class="aspect-[3/4] bg-beige-100 relative overflow-hidden">
                    {% if product.imageSrc %}
                        <img src="{{ product.imageSrc }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center">
                            <svg class="w-16 h-16 text-beige-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    {% endif %}
                </div>
                <div class="p-5">
                    <h3 class="font-semibold text-brand-dark mb-1 group-hover:text-peach-600 transition-colors">{{ product.name }}</h3>
                    <p class="text-peach-600 font-display font-bold text-lg">{{ product.price|number_format(0, '.', ' ') }} so'm</p>
                    {% if product.size|length > 0 %}
                        <p class="text-xs text-brand-muted mt-2">O'lchamlar: {{ product.size|join(', ') }}</p>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        <div class="text-center mt-10">
            <a href="{{ path('app_product_index') }}" class="btn-secondary">Barcha kolleksiyani ko'rish →</a>
        </div>
    </div>
</section>
{% endif %}

{# ─── Auto-Display Banners ─── #}
{% if banners|length > 0 %}
    <style>
        @keyframes countdown-pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.1);
                opacity: 0.9;
            }
        }

        .banner-countdown {
            animation: countdown-pulse 0.6s ease-in-out;
        }

        .banner-ring {
            --progress: 0;
            background: conic-gradient(#f97316 calc(var(--progress) * 1%), #f3f4f6 0);
        }
    </style>

    {% for banner in banners %}
        {% set bannerId = 'banner_modal_' ~ banner.id %}
        {% set countdownId = 'banner_countdown_' ~ banner.id %}
        {% set ringId = 'banner_ring_' ~ banner.id %}

        <dialog id="{{ bannerId }}" class="announcement-modal w-[92vw] max-w-2xl rounded-3xl border border-beige-200 p-0 shadow-2xl" onclick="if (event.target === this) this.close();">
            <div class="relative bg-white rounded-3xl overflow-hidden">
                {% if banner.hasMedia and banner.mediaType == 'image' %}
                    <div class="bg-beige-100 overflow-hidden {% if banner.title or banner.body %}max-h-[52vh]{% endif %}">
                        <img
                            src="{{ banner.embedUrl }}"
                            alt="{{ banner.title ?: 'Banner' }}"
                            class="w-full h-full object-contain"
                        >
                    </div>
                {% elseif banner.hasMedia and banner.mediaType == 'video' %}
                    <iframe
                        src="{{ banner.embedUrl }}"
                        title="{{ banner.title ?: 'Banner' }}"
                        class="h-64 md:h-80 w-full bg-black"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    ></iframe>
                {% endif %}

                {% if banner.title or banner.body or (banner.ctaLabel and banner.ctaUrl) %}
                    <div class="p-5 md:p-6">
                        {% if banner.title %}
                            <h3 class="text-xl md:text-2xl font-display font-bold text-brand-dark mb-2">{{ banner.title }}</h3>
                        {% endif %}
                        {% if banner.body %}
                            <p class="text-sm md:text-base text-brand-medium whitespace-pre-line leading-relaxed">{{ banner.body }}</p>
                        {% endif %}
                        {% if banner.ctaLabel and banner.ctaUrl %}
                            <div class="mt-4">
                                <a href="{{ banner.ctaUrl }}" class="inline-flex items-center gap-2 rounded-full bg-brand-dark px-4 py-2 text-xs font-semibold text-white transition-colors hover:bg-peach-600">
                                    {{ banner.ctaLabel }}
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                                    </svg>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                <div class="pointer-events-none absolute right-3 top-3 z-20 flex items-center gap-2 rounded-full bg-white/95 px-2 py-1 shadow-md border border-beige-200">
                    <div id="{{ ringId }}" class="banner-ring h-6 w-6 rounded-full p-[2px]">
                        <div class="h-full w-full rounded-full bg-white"></div>
                    </div>
                    <span class="text-xs font-semibold text-brand-dark"><span id="{{ countdownId }}">{{ banner.delaySeconds|default(0) }}</span>s</span>
                </div>

                <button onclick="document.getElementById('{{ bannerId }}').close();" class="absolute left-3 top-3 z-20 rounded-full border border-beige-200 bg-white/95 p-1.5 text-brand-medium hover:text-brand-dark hover:border-beige-300" aria-label="Yopish">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </dialog>
    {% endfor %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const banners = [
                {% for banner in banners %}
                {
                    dialogId: '{{ 'banner_modal_' ~ banner.id }}',
                    countdownId: '{{ 'banner_countdown_' ~ banner.id }}',
                    ringId: '{{ 'banner_ring_' ~ banner.id }}',
                    displaySeconds: {{ banner.delaySeconds|default(0) }}
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            ];

            const appearanceDelaySeconds = 3;

            banners.forEach(function(item) {
                const dialog = document.getElementById(item.dialogId);
                const countdownEl = document.getElementById(item.countdownId);
                const ringEl = document.getElementById(item.ringId);

                if (!dialog || !countdownEl || !ringEl) {
                    return;
                }

                const totalDuration = Math.max(1, Number(item.displaySeconds) || 3);
                let remaining = totalDuration;

                const update = function() {
                    countdownEl.textContent = String(remaining);
                    countdownEl.classList.remove('banner-countdown');
                    void countdownEl.offsetWidth;
                    countdownEl.classList.add('banner-countdown');

                    const progress = totalDuration > 0 ? ((totalDuration - remaining) / totalDuration) * 100 : 100;
                    ringEl.style.setProperty('--progress', String(Math.min(100, Math.max(0, progress))));
                };

                update();

                setTimeout(function() {
                    if (typeof dialog.showModal !== 'function') {
                        return;
                    }

                    dialog.showModal();
                    remaining = totalDuration;
                    update();

                    const interval = setInterval(function() {
                        remaining -= 1;
                        update();

                        if (remaining <= 0) {
                            clearInterval(interval);
                            dialog.close();
                        }
                    }, 1000);
                }, appearanceDelaySeconds * 1000);

                dialog.addEventListener('close', function() {
                    remaining = totalDuration;
                    update();
                });
            });
        });
    </script>
{% endif %}

{% endblock %}
