<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Pesca — Premium tibbiy kiyimlar{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🩺</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    {# ─── Flash Messages ─── #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div data-flash class="fixed top-4 right-4 z-50 max-w-sm px-6 py-4 rounded-xl shadow-lg text-sm font-medium
                {% if label == 'success' %} bg-green-50 text-green-800 border border-green-200
                {% elseif label == 'error' %} bg-red-50 text-red-800 border border-red-200
                {% elseif label == 'warning' %} bg-yellow-50 text-yellow-800 border border-yellow-200
                {% else %} bg-blue-50 text-blue-800 border border-blue-200 {% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# ─── Navigation ─── #}
    {% block navbar %}
    <nav class="bg-white/80 backdrop-blur-md border-b border-beige-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                {# Logo #}
                <a href="{{ path('app_home') }}" class="flex items-center gap-2">
                    <span class="text-2xl font-display font-bold text-brand-dark">Pesca</span>
                    <span class="text-xs text-brand-light tracking-widest uppercase">Medical</span>
                </a>

                {# Desktop Nav #}
                <div class="hidden md:flex items-center gap-8">
                    <a href="{{ path('app_home') }}" class="text-sm font-medium text-brand-medium hover:text-peach-600 transition-colors">Bosh sahifa</a>
                    <a href="{{ path('app_product_index') }}" class="text-sm font-medium text-brand-medium hover:text-peach-600 transition-colors">Kolleksiya</a>
                    <a href="{{ path('app_hamkorlik_index') }}" class="text-sm font-medium text-brand-medium hover:text-peach-600 transition-colors">Hamkorlik</a>
                    {% if app.user %}
                        <a href="{{ path('app_smart_style_index') }}" class="text-sm font-medium text-peach-600 hover:text-peach-700 transition-colors flex items-center gap-1">
                            <span>✨</span> SmartStyle
                        </a>
                        <a href="{{ path('app_cart_index') }}" class="text-sm font-medium text-brand-medium hover:text-peach-600 transition-colors relative">
                            Savatcha
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}" class="text-sm font-medium text-peach-600 hover:text-peach-700 transition-colors">Admin</a>
                        {% endif %}
                        <a href="{{ path('app_profile_index') }}" class="flex items-center gap-2 px-3 py-1.5 bg-beige-100 rounded-full hover:bg-beige-200 transition-colors">
                            <span class="w-7 h-7 bg-gradient-to-br from-peach-400 to-peach-600 rounded-full flex items-center justify-center text-xs font-bold text-white">{{ app.user.fullName|first|upper }}</span>
                            <span class="text-sm font-medium text-brand-dark">{{ app.user.fullName|split(' ')[0] }}</span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn-primary text-sm !py-2 !px-4">Kirish</a>
                    {% endif %}
                </div>

                {# Mobile Toggle #}
                <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-beige-100 transition-colors">
                    <svg class="w-6 h-6 text-brand-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        {# Mobile Menu #}
        <div id="mobile-menu" class="hidden md:hidden border-t border-beige-200 bg-white">
            <div class="px-4 py-4 space-y-3">
                <a href="{{ path('app_home') }}" class="block text-sm font-medium text-brand-medium hover:text-peach-600">Bosh sahifa</a>
                <a href="{{ path('app_product_index') }}" class="block text-sm font-medium text-brand-medium hover:text-peach-600">Kolleksiya</a>
                <a href="{{ path('app_hamkorlik_index') }}" class="block text-sm font-medium text-brand-medium hover:text-peach-600">Hamkorlik</a>
                {% if app.user %}
                    <a href="{{ path('app_smart_style_index') }}" class="block text-sm font-medium text-peach-600 hover:text-peach-700">✨ SmartStyle</a>
                    <a href="{{ path('app_cart_index') }}" class="block text-sm font-medium text-brand-medium hover:text-peach-600">Savatcha</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_dashboard') }}" class="block text-sm font-medium text-peach-600">Admin</a>
                    {% endif %}
                    <hr class="border-beige-200">
                    <a href="{{ path('app_profile_index') }}" class="block text-sm font-medium text-brand-dark hover:text-peach-600">👤 Shaxsiy kabinet</a>
                    <a href="{{ path('app_logout') }}" class="block text-sm font-medium text-red-500">Chiqish</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="block btn-primary text-sm text-center">Kirish</a>
                {% endif %}
            </div>
        </div>
    </nav>
    {% endblock %}

    {# ─── Main Content ─── #}
    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    {# ─── Footer ─── #}
    {% block footer %}
    <footer class="bg-brand-dark text-white mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-xl font-display font-bold mb-4">Pesca</h3>
                    <p class="text-brand-muted text-sm leading-relaxed">Qulaylik, uslub va sifatni qadrlaydigan mutaxassislar uchun mo'ljallangan premium tibbiy kiyimlar.</p>
                </div>
                <div>
                    <h4 class="font-semibold text-sm uppercase tracking-wider mb-4">Tezkor havolalar</h4>
                    <ul class="space-y-2 text-sm text-brand-muted">
                        <li><a href="{{ path('app_product_index') }}" class="hover:text-peach-400 transition-colors">Kolleksiya</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="font-semibold text-sm uppercase tracking-wider mb-4">Aloqa</h4>
                    <p class="text-sm text-brand-muted">Toshkent, O'zbekiston</p>
                </div>
            </div>
            <div class="border-t border-white/10 mt-10 pt-6 text-center text-xs text-brand-muted">
                &copy; {{ "now"|date("Y") }} Pesca Medical. Barcha huquqlar himoyalangan.
            </div>
        </div>
    </footer>
    {% endblock %}

    {# ─── Floating Telegram Button ─── #}
    <a href="https://t.me/pescauz" target="_blank" rel="noopener noreferrer"
       class="fixed bottom-6 right-6 z-40 group" title="Telegram kanal">
        <span class="absolute -inset-1 bg-[#27A7E7]/20 rounded-full animate-ping"></span>
        <span class="relative flex items-center justify-center w-14 h-14 bg-[#27A7E7] hover:bg-[#1e96d1] text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </span>
    </a>
</body>
</html>
